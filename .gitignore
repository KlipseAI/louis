node_modules/
dist/
# `packages/react/dist` 만 예외로 커밋한다.
#
# 제품은 이 패키지를 npm 레지스트리가 아니라
# `github:KlipseAI/louis#<sha>&path:/packages/react` 로 설치한다(DS-D-0036).
# git 설치는 `npm publish` 도 `prepare` 도 거치지 않으므로 **커밋되지 않은 파일은
# 소비자에게 존재하지 않는다** — 2026-09-01 실측: clean clone 에서 `npm pack` 하면
# README·THIRD-PARTY-NOTICES·package.json 3개만 담긴다.
# `packages/css/generated` 와 `packages/tokens/generated` 가 커밋되는 것과 같은 이유다.
# 최신인지는 `pnpm run check:react` 가 지킨다.
!/packages/react/dist/
# 그 게이트가 비교용으로 쓰는 재빌드 출력. 산출물이 아니다.
/packages/react/.dist-check/
coverage/
.turbo/
.DS_Store
.env
.env.*
!.env.example

# vitest browser mode가 테스트 실패 시 자동 저장하는 스크린샷.
# baseline이 아니라 실패 흔적이며, DS-D-0005는 "시각 회귀 baseline은 CI에서만 생성하고
# 로컬 커밋을 금지한다"고 규정한다.
__screenshots__/

# vitest 4가 실패 테스트의 스크린샷을 붙이는 곳. 위와 같은 이유로 커밋하지 않는다.
.vitest-attachments/

# 에이전트 오케스트레이션 런타임 상태. 저장소 산출물이 아니다.
.omc/

# verify-consumer.mjs가 저장소 안에 만드는 임시 소비자 작업 폴더.
# 밖에 두면 node_modules resolve가 되지 않아 소비자 관점이 재현되지 않는다.
.louis-consumer-*/

# Claude Code 로컬 설정 — 머신별 허용목록이라 공유하지 않는다
.claude/settings.local.json

# pnpm store
.pnpm-store/


# 작업용 임시 파일 — 저장소에 남길 것이 아니다
scratchpad/

# klipse-document 스킬이 만드는 문서(결과물). 키트가 아니라 git 이 추적하지 않는다.
/documents/
