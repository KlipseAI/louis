    "maturity": "experimental",
    "source": "packages/tokens/src/klipse.tokens.json",
    "sourceFormat": "DTCG 2025.10",
    "artifacts": [
      {
        "id": "css",
        "status": "done",
        "path": "packages/tokens/generated/tokens.css"
