{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://design.klipse.app/schema/manifest.schema.json",
  "title": "Klipse Design manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schemaVersion",
    "system",
    "vocabulary",
    "tokenPackage",
    "webPackages",
    "documents",
    "components",
    "patterns",
    "referenceSurfaces"
  ],
  "properties": {
    "$schema": {
      "type": "string",
      "const": "./manifest.schema.json"
    },
    "schemaVersion": {
      "type": "integer",
      "const": 1
    },
    "system": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "maturity",
        "maintainer",
        "sourcePolicy"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/kebabId"
        },
        "name": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "maturity": {
          "$ref": "#/$defs/maturity"
        },
        "maintainer": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "sourcePolicy": {
          "$ref": "#/$defs/nonEmptyString"
        }
      }
    },
    "vocabulary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "maturity",
        "authority",
        "implementationStatus"
      ],
      "properties": {
        "maturity": {
          "type": "array",
          "const": [
            "stable",
            "beta",
            "experimental",
            "legacy",
            "deprecated"
          ],
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/maturity"
          }
        },
        "authority": {
          "type": "array",
          "const": [
            "normative",
            "generated",
            "reference"
          ],
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/authority"
          }
        },
        "implementationStatus": {
          "type": "array",
          "const": [
            "done",
            "partial",
            "not-ready",
            "not-planned",
            "deprecated"
          ],
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/implementationStatus"
          }
        }
      }
    },
    "tokenPackage": {
      "$ref": "#/$defs/tokenPackage"
    },
    "webPackages": {
      "type": "array",
      "minItems": 2,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/webPackage"
      }
    },
    "documents": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/document"
      }
    },
    "components": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/catalogItem"
      }
    },
    "patterns": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/catalogItem"
      }
    },
    "referenceSurfaces": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/referenceSurface"
      }
    }
  },
  "$defs": {
    "nonEmptyString": {
      "type": "string",
      "minLength": 1
    },
    "kebabId": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "repoPath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
    },
    "maturity": {
      "type": "string",
      "enum": [
        "stable",
        "beta",
        "experimental",
        "legacy",
        "deprecated"
      ]
    },
    "authority": {
      "type": "string",
      "enum": [
        "normative",
        "generated",
        "reference"
      ]
    },
    "implementationStatus": {
      "type": "string",
      "enum": [
        "done",
        "partial",
        "not-ready",
        "not-planned",
        "deprecated"
      ]
    },
    "documentSection": {
      "type": "string",
      "enum": [
        "get-started",
        "foundations",
        "components",
        "patterns",
        "content",
        "develop",
        "governance",
        "updates",
        "generated",
        "reference"
      ]
    },
    "document": {
      "oneOf": [
        {
          "$ref": "#/$defs/sourceDocument"
        },
        {
          "$ref": "#/$defs/generatedDocument"
        }
      ]
    },
    "sourceDocument": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "path",
        "title",
        "section",
        "authority",
        "maturity",
        "generated"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/kebabId"
        },
        "path": {
          "$ref": "#/$defs/repoPath"
        },
        "title": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "section": {
          "$ref": "#/$defs/documentSection"
        },
        "authority": {
          "type": "string",
          "enum": [
            "normative",
            "reference"
          ]
        },
        "maturity": {
          "$ref": "#/$defs/maturity"
        },
        "generated": {
          "type": "boolean",
          "const": false
        }
      }
    },
    "generatedDocument": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "path",
        "title",
        "section",
        "authority",
        "maturity",
        "generated",
        "generator",
        "checker",
        "sourceCoverage",
        "sources"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/kebabId"
        },
        "path": {
          "$ref": "#/$defs/repoPath"
        },
        "title": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "section": {
          "type": "string",
          "const": "generated"
        },
        "authority": {
          "type": "string",
          "const": "generated"
        },
        "maturity": {
          "$ref": "#/$defs/maturity"
        },
        "generated": {
          "type": "boolean",
          "const": true
        },
        "generator": {
          "$ref": "#/$defs/kebabId"
        },
        "checker": {
          "$ref": "#/$defs/kebabId"
        },
        "sourceCoverage": {
          "type": "string",
          "const": "exhaustive"
        },
        "sources": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/repoPath"
          }
        }
      }
    },
    "tokenPackage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "maturity",
        "source",
        "sourceFormat",
        "artifacts",
        "figmaLibrary",
        "packageRelease",
        "docs",
        "note"
      ],
      "properties": {
        "name": {
          "type": "string",
          "const": "@klipse-design/tokens"
        },
        "maturity": {
          "type": "string",
          "const": "experimental"
        },
        "source": {
          "type": "string",
          "const": "packages/tokens/src/klipse.tokens.json"
        },
        "sourceFormat": {
          "type": "string",
          "const": "DTCG 2025.10"
        },
        "artifacts": {
          "type": "array",
          "minItems": 6,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/tokenArtifact"
          }
        },
        "figmaLibrary": {
          "$ref": "#/$defs/implementationStatus"
        },
        "figmaLibraryEvidence": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "packageRelease": {
          "$ref": "#/$defs/implementationStatus"
        },
        "packageReleaseEvidence": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "docs": {
          "type": "string",
          "const": "done"
        },
        "note": {
          "$ref": "#/$defs/nonEmptyString"
        }
      }
    },
    "tokenArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "status",
        "path"
      ],
      "properties": {
        "id": {
          "type": "string",
          "enum": [
            "css",
            "javascript",
            "types",
            "json",
            "figma-proposal",
            "manifest"
          ]
        },
        "status": {
          "type": "string",
          "const": "done"
        },
        "path": {
          "$ref": "#/$defs/repoPath"
        }
      }
    },
    "catalogItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "maturity",
        "figma",
        "web",
        "docs"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/kebabId"
        },
        "name": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "maturity": {
          "$ref": "#/$defs/maturity"
        },
        "figma": {
          "$ref": "#/$defs/implementationStatus"
        },
        "web": {
          "$ref": "#/$defs/implementationStatus"
        },
        "docs": {
          "$ref": "#/$defs/implementationStatus"
        },
        "doc": {
          "$ref": "#/$defs/repoPath"
        },
        "note": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "figmaName": {
          "description": "Figma component set 이름. name은 사람이 읽는 표시 이름이라 슬래시를 포함할 수 있는데(\"Dialog / Confirm Modal\") Figma에서 슬래시는 폴더 구분자라 이름이 쪼개진다. 그래서 별도 필드로 두고 슬래시와 공백을 금지한다.",
          "type": "string",
          "pattern": "^[A-Z][A-Za-z0-9]*$"
        },
        "figmaNames": {
          "description": "한 컴포넌트가 Figma에서 여러 component로 나뉘는 경우의 이름 목록. Menu는 항목과 패널이 별개 component다 — 항목은 조립 단위이고 패널은 그것을 담는 그릇이다. 지정하면 figmaName 대신 이 목록이 쓰인다.",
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^[A-Z][A-Za-z0-9]*$"
          }
        }
      },
      "anyOf": [
        {
          "properties": {
            "docs": {
              "type": "string",
              "enum": [
                "partial",
                "not-ready",
                "not-planned",
                "deprecated"
              ]
            }
          }
        },
        {
          "required": [
            "doc"
          ],
          "properties": {
            "docs": {
              "type": "string",
              "const": "done"
            }
          }
        }
      ]
    },
    "referenceSurface": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "purpose",
        "authority"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/repoPath"
        },
        "purpose": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "authority": {
          "type": "string",
          "const": "reference"
        }
      }
    },
    "webPackage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "maturity",
        "packageRelease",
        "docs",
        "note"
      ],
      "properties": {
        "id": {
          "type": "string",
          "enum": [
            "css",
            "react"
          ]
        },
        "name": {
          "type": "string",
          "enum": [
            "@klipse-design/css",
            "@klipse-design/react"
          ]
        },
        "maturity": {
          "$ref": "#/$defs/maturity"
        },
        "packageRelease": {
          "$ref": "#/$defs/implementationStatus"
        },
        "packageReleaseEvidence": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "web": {
          "$ref": "#/$defs/implementationStatus"
        },
        "webEvidence": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "docs": {
          "$ref": "#/$defs/implementationStatus"
        },
        "note": {
          "$ref": "#/$defs/nonEmptyString"
        }
      }
    }
  }
}
