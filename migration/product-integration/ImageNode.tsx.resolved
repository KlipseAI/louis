  "[[data-node-canvas-marketing]_[data-marketing-model-picker]_&]:left-0!",
  "[[data-node-canvas-marketing]_[data-marketing-model-picker]_&]:[transform:translateX(0)_scale(calc(1_/_var(--node-canvas-zoom,1)))]!",
  "[[data-node-canvas-marketing]_[data-marketing-model-picker]_&]:[transform-origin:top_left]!",
  DROPDOWN_ANCHOR_MARKETING_STATIC,
].join(" ");

/* 표면(면·라운드·그림자·패딩·항목 간격)은 LOUIS 정본 `.louis-popover`가 소유한다.
   MetaDropdownPanel이 위치·모션을 잡는 Provider 밖 bare surface라, .louis-popover 의
   min-inline-size 폴백이 풀리도록 collision-padding shim을 얹는다. 스크롤·터치는 유지. */
const DROPDOWN_SURFACE = [
  "louis-popover [--louis-overlay-collision-padding:8px]",
  "overscroll-contain touch-pan-y",
].join(" ");

/* 드롭다운 상단 아이브로우(예: 품질) — inspectorTopbarEyebrow 톤. 옵션과 좌우 정렬.
   `<div>` 라 랜딩 `[data-page-root] :where(…)` 대상이 아니므로 white-space 에 `!` 가 필요 없다. */
const DROPDOWN_EYEBROW = [
  "pt-2 px-6 pb-1",
  "text-[rgb(var(--gray-500-rgb)/88%)]",
  "whitespace-nowrap select-none",
].join(" ");

/* 항목은 LOUIS 정본 `.louis-menu__item`이 소유(패딩·라운드·색·hover·focus·disabled).
   긴 옵션 라벨이 줄바꿈되지 않고 서피스를 넓히도록 whitespace-nowrap·min-w-max만 얹어
   LOUIS의 keep-all 줄바꿈을 덮는다. */
const DROPDOWN_OPTION = "louis-menu__item whitespace-nowrap! min-w-max";

/* 미선택 배경은 LOUIS 항목 기본값(투명)이 소유한다. 유틸리티 `bg-transparent`를 얹으면
   utilities 레이어가 `.louis-menu__item:hover`(louis.component 레이어)를 이겨 호버 면이 죽으므로
   비운다(호출부 shape 유지). */
const DROPDOWN_OPTION_IDLE = "";

/* 선택된 옵션 표시 — 솔리드 배경으로 hover보다 강하게(선택=현재값). 색은 LOUIS 항목값을 상속. */
const DROPDOWN_OPTION_ACTIVE = [
  "bg-[var(--palette-gray-700)]",
  "light:bg-[var(--palette-gray-025)]",
].join(" ");

const META_MODEL = [
  "inline-flex items-center justify-start gap-2",
  "h-[var(--node-chrome-btn-h)] py-0 px-[var(--node-chrome-btn-padding-x)]",
  "[box-shadow:var(--louis-hairline-inset)]",
  "[background:var(--node-chrome-btn-bg)]",
  "text-[rgb(var(--palette-gray-000-rgb)/100%)]",
  "[font-family:inherit]! cursor-pointer",
  "rounded-[var(--node-chrome-btn-radius)] select-none w-auto box-border",
  "[transition:background_0.12s_ease,color_0.12s_ease]",
  "[&:hover]:[background:var(--node-chrome-btn-bg-hover)]",
  "[&:hover]:text-[rgb(var(--palette-gray-000-rgb)/100%)]",
  "light:text-[rgb(var(--palette-gray-700-rgb)/100%)]",
  /* 면·호버 필은 `--node-chrome-btn-*` 가 테마별로 이미 다른 값을 주므로 색만 조정. */
  "light:[&:hover]:text-[rgb(var(--palette-gray-800-rgb)/100%)]",
].join(" ");

const META_MODEL_LABEL = "whitespace-nowrap! flex-[0_0_auto] text-left";

const META_CHEVRON = "hidden";
const META_CHEVRON_OPEN = "[transform:rotate(180deg)]";

/* 메타 알약은 LOUIS 정본 `.louis-node-chip` 이 소유한다(높이·패딩·반경·면·헤어라인·호버·
   비활성·타이포). 비활성은 클래스가 아니라 `aria-disabled` 로 표현한다 — LOUIS 가 그 상태를
   그리고, 값만 보여주는 정적 알약과 눌러서 여는 트리거는 요소 종류로 구분된다. */
const META_ITEM = "louis-node-chip";

/* ChromeTooltip 호스트 — 원본 `.tooltipHostContents { display: contents }`.
   호스트 기본 클래스(`inline-flex`)가 이제 같은 유틸리티 레이어라 `!` 로 승자를 고정한다. */
const TOOLTIP_HOST_CONTENTS = "contents!";

function ImagePlaceholder({ emptyLabel }: { emptyLabel: string }) {
  return (
    <div className={IMAGE_PLACEHOLDER}>
      {/* public/icons/Image.svg 와 동일 실루엣 — ImageIcon(currentColor) */}
      <span className={IMAGE_PLACEHOLDER_ICON}>
        <ImageIcon size={64} strokeScreenPx={2} />
      </span>
      <span
        className={`type-body-14-regular ${IMAGE_PLACEHOLDER_LABEL}`}
      >
        {emptyLabel}
      </span>
    </div>
  );
}

/**
 * 단계 간 경과 시간 — 외부 API가 진행률을 주지 않아 시간 기반으로만 전환(마지막 단계는 유지).
 * 대부분의 이미지 생성은 이보다 먼저 끝나므로 완료 시 `IMAGE_GENERATING_TAIL_MS` 만큼
 * 마지막 단계를 잠깐 보여주고 결과로 전환한다(`useGeneratingWithTail`).
 */
const IMAGE_GENERATING_STEP_MS = [3000, 6000, 12000, 24000] as const;
const IMAGE_GENERATING_TAIL_MS = 900;

function GeneratingState({
  stages,
  startedAt,
  forceLastStage,
}: {
  stages: readonly string[];
  startedAt?: number;
  forceLastStage?: boolean;
}) {
  const computedLabel = useGeneratingStageLabel(
    stages,
    IMAGE_GENERATING_STEP_MS,
    startedAt,
  );
  const label = forceLastStage
    ? (stages[stages.length - 1] ?? computedLabel)
    : computedLabel;
  return (
    <div
      className={MEDIA_ROOT}
      role="status"
      aria-live="polite"
    >
      <span
        aria-hidden
        className={MEDIA_ICON_IMAGE}
      >
        <ImageIcon size={64} strokeScreenPx={2} />
        <NodeGeneratingIconSheen key={label}>
          <ImageIcon size={64} strokeScreenPx={2} />
        </NodeGeneratingIconSheen>
      </span>
      <span
        key={label}
        data-label={label}
        className={`type-body-14-medium ${MEDIA_CAPTION_IMAGE}`}
      >
        {label}
      </span>
    </div>
  );
}

const DEFAULT_MODEL = getDefaultClientImageModel();
const IMAGE_MODEL_OPTIONS = getClientVisibleImageModels();

const ASPECT_RATIOS = [
  "1:1",
  "2:3",
  "3:2",
  "3:4",
  "4:3",
  "4:5",
  "5:4",
  "9:16",
  "16:9",
  "21:9",
] as const;
type AspectRatio = (typeof ASPECT_RATIOS)[number];

/** GPT Image 1.5는 1024x1024, 1536x1024, 1024x1536만 지원 */
const GPT_IMAGE_ASPECT_RATIOS: readonly AspectRatio[] = ["1:1", "2:3", "3:2"];

function getAspectRatiosForModel(modelId: string): readonly AspectRatio[] {
  if (modelId === "gpt-image-1.5") return GPT_IMAGE_ASPECT_RATIOS;
  // gpt-image-2·2.5는 자유 해상도(16의 배수, 1:3~3:1) — 전체 비율 지원.
  // 2026-09-16 실측에서 2.5 가 매핑된 해상도를 전 항목 그대로 반환하는 것을 확인했다.
  return ASPECT_RATIOS;
}

/** 현재 비율이 목록에 없을 때 숫자로 가장 가까운 지원 비율 선택(무조건 1:1로 떨어지는 현상 완화) */
function pickNearestSupportedAspect(
  currentLabel: AspectRatio,
  supported: readonly AspectRatio[],
): AspectRatio {
  if (supported.length === 0) return "1:1";
  if (supported.includes(currentLabel)) return currentLabel;
  const cur = aspectRatioStringToNumber(currentLabel);
  let best = supported[0]!;
  let bestDiff = Number.POSITIVE_INFINITY;
  for (const r of supported) {
    const d = Math.abs(aspectRatioStringToNumber(r) - cur);
    if (d < bestDiff) {
      bestDiff = d;
      best = r;
    }
  }
  return best;
}

function nearestAspectRatioLabel(n: number): AspectRatio {
  let best: AspectRatio = "1:1";
  let bestDiff = Number.POSITIVE_INFINITY;
  for (const r of ASPECT_RATIOS) {
    const v = aspectRatioStringToNumber(r);
    const d = Math.abs(v - n);
    if (d < bestDiff) {
      bestDiff = d;
      best = r;
    }
  }
  return best;
}

export function ImageNode({
  data,
  selected = false,
}: NodeProps<RFNode<ImageNodeData, "image">>) {
  const { messages, locale } = useI18n();
  const tCreate = messages.create;
  const tNC = messages.create.nodeCanvas;
  /**
   * 프로바이더 오류를 사용자 문구로 옮길 때 쓰는 문구 묶음 — 영상 경로와 같은 판정을 쓴다. 일반 실패만 이미지 문구로
   * 바꾼다. 영상 묶음의 일반 실패는 「영상 생성에 실패했습니다」라, 알아보지 못한 이미지 실패에 그대로 뜨면 틀린 말이다.
   */
  const videoGenErr = useMemo(
    () => ({
      ...buildVideoGenerationErrorCopy(tCreate),
      generationFailed: tNC.imageGenerationFailed,
    }),
    [tCreate, tNC.imageGenerationFailed],
  );
  const tV2 = tNC.toolbarV2;
  const nodeId = useNodeId();
  const prompt = data.prompt ?? "";
  const isGenerating = Boolean(data.isGenerating);
  const hasImage =
    typeof data.imageUrl === "string"
      ? Boolean(data.imageUrl.trim())
      : Boolean(data.imageUrl);
  const isLocked = Boolean(data.isLocked);
  const [isSpawned, setIsSpawned] = useState(false);
  useEffect(() => {
    const raf = requestAnimationFrame(() => {
      setIsSpawned(true);
    });
    return () => cancelAnimationFrame(raf);
  }, []);

  const [error, setError] = useState<string | null>((data.lastGenerationError as string) ?? null);
  const [aspectRatio, setAspectRatio] = useState<AspectRatio>(() =>
    nearestAspectRatioLabel(
      typeof data.mediaAspect === "number" && data.mediaAspect > 0
        ? data.mediaAspect
        : 1,
    ),
  );
  /** 모델을 바꿔도 이전에 해당 모델에서 고른 비율 복원 (GPT 1.5 ↔ 다른 모델 왕복 시 1:1 고정 완화) */
  const preferredAspectByModelRef = useRef<Partial<Record<string, AspectRatio>>>(
    {},
  );
  const [ratioOpen, setRatioOpen] = useState(false);
  const ratioRef = useRef<HTMLDivElement>(null);
  const marketingModelMenuOpen = Boolean(data.embedMarketingModelMenuOpen);
  const [modelOpen, setModelOpen] = useState(marketingModelMenuOpen);
  /** 마케팅 쇼케이스: 첫 상호작용 전에는 정적(즉시 열림), 누른 뒤엔 열기/닫기 애니메이션 사용 */
  const [marketingMenuInteracted, setMarketingMenuInteracted] = useState(false);
  const modelRef = useRef<HTMLDivElement>(null);
  /**
   * 각도 변환 노드는 카탈로그(`IMAGE_MODEL_OPTIONS`) 밖 모델을 쓴다.
   *
   * 카탈로그에 없는 모델을 기본값으로 떨구는 폴백은 원래 "삭제된 모델을 가리키는 옛 노드가
   * 깨지지 않게" 하려는 것인데, 각도 노드는 의도적으로 카탈로그에 없으므로 그대로 걸린다.
   * 그러면 `qwen-angle` 이 GPT 로 바뀌어 프롬프트 없이 OpenAI 를 부르고 실패한다.
   * `camera` 가 있으면 각도 노드이므로 폴백을 적용하지 않는다.
   */
  const isAngleNode = Boolean(data.camera);
  const model = isAngleNode
    ? (data.model as string)
    : IMAGE_MODEL_OPTIONS.some((option) => option.id === data.model)
      ? (data.model as string)
      : DEFAULT_MODEL;
  /**
   * 선택지는 `qualitiesForModel` 하나에서만 온다 — 서버 검증도 같은 함수를 본다.
   * 종전에는 여기 `credits` 필드(5/10/30)가 같이 있었는데 **어디서도 읽지 않는 죽은 값**인
   * 데다 실제 크레딧의 1/10 이었다. KLI-227 의 ×10 재액면 때 따라오지 않은 잔재라 지웠다.
   * 실제 견적은 아래 `estimatedCreditCost` 가 요금표에서 계산한다.
   */
  const QUALITY_OPTIONS: Array<{ id: ImageQuality; label: string }> = useMemo(
    () =>
      qualitiesForModel(model).map((id) => ({
        id,
        label: tNC.imageQualityOptions[id],
      })),
    [model, tNC],
  );
  /**
   * 화질은 **노드에 저장한다** — 모델·비율과 같은 자리다.
   *
   * 로컬 상태였던 동안에는 노드가 리마운트될 때마다(새로고침 포함) 조용히 `medium` 으로
   * 돌아갔다. 화질은 크레딧 단가에 그대로 들어간다 — gpt-image-2 기준 low 50 / medium 100.
   * 그래서 low 를 골라 뒀다고 믿는 사용자가 되돌아간 줄도 모르고 두 배를 내게 된다.
   * 2026-09-11 로컬 테스트에서 실제로 그렇게 청구됐다.
   */
  const quality: ImageQuality = isQualitySupported(model, data.quality)
    ? data.quality
    : defaultQualityForModel(model);
  const [qualityOpen, setQualityOpen] = useState(false);
  const qualityRef = useRef<HTMLDivElement>(null);
  /**
   * 고른 화질을 지원하지 않는 모델로 바꾸면 그 모델의 기본 화질로 되돌린다.
   * 종전에는 gpt-image-1.5 의 low 한 가지만 막았는데, 2.5 에만 있는 `xhigh`·`max` 를 골라 둔
   * 채 gpt-image-2 로 전환하는 경로가 생겨 모델별 허용 집합 전체로 넓혔다. 접지 않으면
   * 요금표가 모르는 이름을 폴백으로 떨어뜨려 견적과 실제 차감이 어긋난다.
   */
  useEffect(() => {
    // 값이 있는데 지원하지 않을 때만 접는다 — 미설정(undefined)까지 되돌리면 노드를 열기만
    // 해도 저장이 일어난다.
    if (data.quality && !isQualitySupported(model, data.quality)) {
      data.onQualityChange?.(defaultQualityForModel(model));
    }
  }, [model, data]);
  const isEditMode = !!data.connectedImageUrl;
  // 연결된 입력(참조) 이미지 개수 — 서버 과금(images.length)과 일치시켜 divergence 방지
  const inputImageCount = useMemo(() => {
    const multi = data.connectedImageUrls;
    if (multi && multi.length > 0) return multi.filter(Boolean).length;
    return data.connectedImageUrl ? 1 : 0;
  }, [data.connectedImageUrl, data.connectedImageUrls]);
  const estimatedCreditCost = useMemo(
    () => calculateImageGenerationCreditCost(model, quality, null, inputImageCount),
    [model, quality, inputImageCount],
  );
  const availableCreditAmount =
    typeof data.availableCreditAmount === "number"
      ? Math.max(0, data.availableCreditAmount)
      : null;
  const insufficientCreditMessage =
    availableCreditAmount !== null && availableCreditAmount < estimatedCreditCost
      ? tNC.insufficientCreditsDetail(
          estimatedCreditCost,
          availableCreditAmount,
        )
      : null;

  const graphTextConnected = data.connectedPromptFromText != null;
  /* 첫 노드 안내 — 캔버스가 이 노드를 고르면 입력칸 위에 선다(`hooks/useFirstNodeHintSlot.ts`) */
  const firstNodeHint = useFirstNodeHintSlot(nodeId);
  /** `hasImage`만으로도 모델/비율 잠금 — 상위 동기화 누락 한 프레임도 방어 */
  const metaSpecsLocked = isLocked || isGenerating || hasImage;

  const isUploadOrigin = data.imageOrigin === "upload";
  /**
   * 업로드 전용 노드는 프롬프트가 없지만, 텍스트 연결·편집 모드일 때는 영역 유지.
   * 각도 노드도 프롬프트가 없다 — 문장이 아니라 각도로 지시하고, fal 이 프롬프트를 조립한다.
   */
  const showPromptSection =
    !isAngleNode && (!isUploadOrigin || isEditMode || graphTextConnected);
  /** 각도 노드는 모델·비율·화질이 전부 고정이라 고를 것이 없다. */
  const showModelAndRatioToolbar = !isUploadOrigin && !isAngleNode;

  /* 출력점 「다음 단계」 메뉴 — 이미지가 있을 때만 */
  const [nextStepOpen, setNextStepOpen] = useState(false);
  const nextStepRef = useRef<HTMLDivElement>(null);
  const closeNextStep = useCallback(() => setNextStepOpen(false), []);
  useCloseOnOutside(nextStepOpen, nextStepRef, closeNextStep);
  const canShowNextStep = hasImage && Boolean(data.onAddNextNode);
  const nextStep = useNextStepTrigger({
    open: nextStepOpen,
    setOpen: setNextStepOpen,
    enabled: canShowNextStep,
  });
  /* 「다음 단계」 안내 — 첫 이미지가 완성된 이 노드의 출력점 옆에 코치마크를 붙이고 그 출력점만 깜빡인다
     (대상은 캔버스가 정한다, `lib/nextStepHint.ts`). 영상 노드와 같은 훅이다. */
  const nextStepHint = useNextStepCoachmark({
    nodeId,
    enabled: canShowNextStep,
    menuOpen: nextStepOpen,
    handleRef: nextStep.handleRef,
  });

  /** 결과 이미지가 보이면 생성 FAB 숨김 */
  const showGenerateButton = !isLocked && !hasImage;

  const promptLinkedImageUrls = useMemo(() => {
    const multi = data.connectedImageUrls;
    if (multi && multi.length > 0) return multi.filter(Boolean) as string[];
    return data.connectedImageUrl ? [data.connectedImageUrl] : [];
  }, [data.connectedImageUrl, data.connectedImageUrls]);

  const imageLayoutSyncExtra = useMemo(
    () =>
      [
        aspectRatio,
        String(graphTextConnected),
        data.videoFrameTitle ?? "",
        model,
        String(Boolean(data.imageUrl)),
        String(isGenerating),
        data.imageOrigin ?? "",
        String(showPromptSection),
        String(showModelAndRatioToolbar),
        String(data.mediaAspect ?? ""),
        String(promptLinkedImageUrls.length),
      ].join("|"),
    [
      aspectRatio,
      graphTextConnected,
      data.videoFrameTitle,
      model,
      data.imageUrl,
      isGenerating,
      data.imageOrigin,
      showPromptSection,
      showModelAndRatioToolbar,
      data.mediaAspect,
      promptLinkedImageUrls.length,
    ],
  );

  const nodeLayoutRef = useNodeInternalsOnLayoutResize(
    nodeId,
    imageLayoutSyncExtra,
  );

  const effectivePrompt = graphTextConnected
    ? (data.connectedPromptFromText ?? "")
    : prompt;
  const showConnectedChip = graphTextConnected;
  const promptTextareaRef = useRef<HTMLTextAreaElement>(null);

  const promptResize = usePromptResize(promptTextareaRef, [
    effectivePrompt,
    showConnectedChip,
  ]);

  /** 비디오 노드(`VideoNode`)와 동일 — 연결 칩에는 프롬프트 본문 대신 고정 상태 문구만 표시 */
  const imageConnectionChipLabel =
    data.connectedTextMode === "llm"
      ? tNC.imageConnectedChipAi
      : tNC.textConnectedChip;
  const isPromptReadOnly =
    graphTextConnected && data.connectedTextMode === "text";

  /** 비어 있는 편집 가능 프롬프트 영역에서는 pane 패닝(트랙패드 드래그) 허용 */
  const promptTextareaFlowClass =
    isPromptReadOnly ||
    isLocked ||
    isGenerating ||
    effectivePrompt.trim().length > 0
      ? REACT_FLOW_NO_DRAG_PAN
      : REACT_FLOW_NODE_NO_DRAG;

  useEffect(() => {
    if (marketingModelMenuOpen) {
      setModelOpen(true);
    }
  }, [marketingModelMenuOpen]);

  useEffect(() => {
    if (!modelOpen || marketingModelMenuOpen) return;
    const handleClick = (e: MouseEvent) => {
      if (
        modelRef.current &&
        !modelRef.current.contains(e.target as globalThis.Node)
      ) {
        setModelOpen(false);
      }
    };
    document.addEventListener("mousedown", handleClick, true);
    return () => document.removeEventListener("mousedown", handleClick, true);
  }, [modelOpen, marketingModelMenuOpen]);

  useEffect(() => {
    if (!ratioOpen) return;
    const handleClick = (e: MouseEvent) => {
      if (
        ratioRef.current &&
        !ratioRef.current.contains(e.target as globalThis.Node)
      ) {
        setRatioOpen(false);
      }
    };
    document.addEventListener("mousedown", handleClick, true);
    return () => document.removeEventListener("mousedown", handleClick, true);
  }, [ratioOpen]);

  useEffect(() => {
    if (!qualityOpen) return;
    const handleClick = (e: MouseEvent) => {
      if (
        qualityRef.current &&
        !qualityRef.current.contains(e.target as globalThis.Node)
      ) {
        setQualityOpen(false);
      }
    };
    document.addEventListener("mousedown", handleClick, true);
    return () => document.removeEventListener("mousedown", handleClick, true);
  }, [qualityOpen]);

  useEffect(() => {
    if (metaSpecsLocked) {
      setModelOpen(false);
      setRatioOpen(false);
      setQualityOpen(false);
    }
  }, [metaSpecsLocked]);

  const handleChange = useCallback(
    (e: ChangeEvent<HTMLTextAreaElement>) => {
      if (isPromptReadOnly) return;
      data.onPromptChange?.(e.target.value);
      setError(null);
    },
    [isPromptReadOnly, data],
  );

  const handleKeyDown = useCallback((e: React.KeyboardEvent) => {
    e.stopPropagation();
  }, []);

  const generateInflightRef = useRef(false);
  /**
   * 제출 단위 멱등키. **클릭마다 새로 만들지 않는다.**
   *
   * 매번 새로 만들면 연타가 서로 다른 제출로 보여 차감도 프로바이더 호출도 그만큼 반복된다.
   * 한 번의 제출이 끝날 때까지 같은 값을 유지해, 가드가 뚫려 요청이 두 번 나가도 서버가
   * 같은 제출로 알아보고 한 번만 처리하게 한다.
   *
   * 생성이 끝나면(성공이든 실패든) 비운다 — 같은 프롬프트로 다시 굴리는 것은 새 제출이다.
   */
  const submissionKeyRef = useRef<string | null>(null);
  const doGenerate = useCallback(async () => {
    if (isGenerating || generateInflightRef.current) return;
    // 백스톱 — 게이트 부재·확인 사이 보유량 변동 시 서버 요청 전에 차단
    if (insufficientCreditMessage) {
      setError(insufficientCreditMessage);
      return;
    }
    generateInflightRef.current = true;
    data.onImageGenerateStart?.(nodeId!);
    setError(null);

    /** 서버가 실제로 환불한 크레딧. 0 이면 안내 문구에 환불을 붙이지 않는다. */
    let refundedCredits = 0;
    /** 응답이 끊겼을 때 결과를 되짚을 열쇠 — `finally` 가 ref 를 비우므로 따로 들고 있는다. */
    let submissionKey: string | null = null;
    /**
     * 서버의 판정(JSON)을 실제로 받아봤는가.
     *
     * 못 받았다면 실패한 쪽은 생성이 아니라 **응답을 받아오는 길**이다 — 서버는 대개 그대로
     * 끝내고 차감도 유지된다. 그 구분이 있어야 "되짚어 볼 건"과 "서버가 실패라고 말한 건"을
     * 섞지 않는다.
     */
    let gotServerVerdict = false;

    try {
      const rawConnectedUrls =
        data.onPruneEmptyImageInputs?.(nodeId!) ??
        data.connectedImageUrls ??
        (data.connectedImageUrl ? [data.connectedImageUrl] : []);

      // base64 data URL → Storage 업로드 → public URL 변환 (Vercel 4.5MB 제한 회피)
      const allConnectedUrls = await Promise.all(
        rawConnectedUrls.map(async (url) => {
          if (url.startsWith("data:")) {
            try {
              const { publicUrl } = await uploadCanvasImage(url, data.projectId);
              return publicUrl;
            } catch {
              return url; // fallback
            }
          }
          return url;
        }),
      );

      submissionKey = submissionKeyRef.current ??= crypto.randomUUID();
      const res = await fetch("/api/image/generate", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({
          // 멱등성 키 — 중복 도달 시 서버가 재차감하지 않도록 한다.
          idempotencyKey: submissionKey,
          // 서버가 결과를 어느 노드에 붙일지 알아야 기록이 완성된다.
          nodeId,
          prompt: effectivePrompt,
          model,
          aspectRatio,
          quality,
          ...(allConnectedUrls.length > 0 ? { images: allConnectedUrls } : {}),
          // 각도 변환 노드만 싣는다. 서버가 격자로 다시 접고 범위를 검증한다.
          ...(data.camera ? { camera: data.camera } : {}),
        }),
      });

      const bodyText = await res.text();
      const json = parseJsonFromApiResponse(res, bodyText) as {
        ok: boolean;
        error?: string;
        refundedCredits?: number;
        data?: {
          mimeType: string;
          /** 서버가 스토리지에 올린 경우 — 이 URL 을 그대로 쓴다 */
          imageUrl?: string;
          storageKey?: string;
          /** 서버 업로드가 실패했을 때만 온다 (예전 경로 폴백) */
          imageBase64?: string;
          generatedImageId?: string;
        };
      };

      gotServerVerdict = true;

      // 실패 시 서버가 환불한 금액 — 아래 catch 에서 안내 문구에 붙인다.
      // Error 로는 문구만 흐르므로 여기서 받아 둔다.
      if (typeof json.refundedCredits === "number") {
        refundedCredits = json.refundedCredits;
      }

      // 같은 제출이 이미 서버에서 돌고 있다는 응답. 이건 실패가 아니라 **중복 요청이
      // 걸러진 것**이므로 조용히 물러난다. 오류로 처리하면 먼저 돌던 요청의 생성 중
      // 상태까지 꺼 버려서, 정작 그 요청이 끝나도 결과가 붙을 자리가 없어진다.
      if (!json.ok && json.error === "generation_in_progress") {
        return;
      }

      if (!json.ok) {
        throw new Error(json.error ?? tNC.imageGenerationFailed);
      }
      // 서버가 올렸으면 URL, 실패했으면 base64 — 둘 중 하나는 온다.
      const resultUrl =
        json.data?.imageUrl ??
        (json.data?.mimeType && json.data?.imageBase64
          ? `data:${json.data.mimeType};base64,${json.data.imageBase64}`
          : null);
      if (!resultUrl) {
        throw new Error(tNC.imageGenerationFailed);
      }

      data.onImageGenerated?.(
        nodeId!,
        resultUrl,
        json.data?.generatedImageId,
        json.data?.storageKey,
      );
      data.onCreditBalanceMayHaveChanged?.();
    } catch (err) {
      // 요청은 나갔는데 서버의 판정을 못 받은 경우 — 끊긴 건 생성이 아니라 응답 경로다.
      //
      // 대표적으로 JSON 대신 HTML 이 온다: 앞단 게이트웨이(ALB idle timeout)가 우리 응답을
      // 끊고 제 에러 페이지를 대신 돌려준 것이다. 네트워크 단절·탭 절전도 결과는 같다.
      // 어느 쪽이든 **서버는 대개 그대로 끝까지 간다** — 크레딧은 이미 차감됐고 이미지도
      // 스토리지에 올라간다. 여기서 바로 실패로 접으면 사용자는 돈만 내고 결과를 잃는다
      // (게이트웨이 절단만 해도 30일간 약 30건). 제출 키로 그 행을 되짚어 온다.
      if (submissionKey && !gotServerVerdict) {
        const recovered = await recoverImageGeneration(submissionKey);

        if (recovered.status === "completed") {
          data.onImageGenerated?.(
            nodeId!,
            recovered.imageUrl,
            recovered.generatedImageId || undefined,
            recovered.storageKey ?? undefined,
          );
          data.onCreditBalanceMayHaveChanged?.();
          return;
        }

        if (recovered.status === "failed") {
          // 실패로 끝났다면 서버가 이미 환불했다 — 얼마가 돌아왔는지 같이 알린다.
          const failedMessage =
            recovered.refundedCredits > 0
              ? `${tNC.imageGenerationFailed} ${tCreate.errors.creditsRefunded(recovered.refundedCredits)}`
              : tNC.imageGenerationFailed;
          setError(failedMessage);
          data.onImageGenerationError?.(nodeId!, failedMessage);
          data.onImageGenerated?.(nodeId!, "");
          data.onCreditBalanceMayHaveChanged?.();
          return;
        }

        // 되짚어도 결론이 안 났다. HTML 을 받은 경우에만 그 사정을 그대로 알리고,
        // 나머지(네트워크 단절 등)는 아래 일반 경로가 사유에 맞는 문구를 고른다.
        if (err instanceof ApiReturnedNonJsonError) {
          setError(tNC.apiUnexpectedHtmlResponse);
          data.onImageGenerationError?.(nodeId!, tNC.apiUnexpectedHtmlResponse);
          data.onImageGenerated?.(nodeId!, "");
          return;
        }
      }
      const message = err instanceof Error ? err.message : tNC.imageGenerationFailed;
      // 라우트는 크레딧 부족을 402 와 사유 코드(`insufficientCredits`)로 보낸다 — 원문 정규식으로 알아보지 않는다.
      const isInsufficientCredits = message === "insufficientCredits";
      // 429 는 낱말로만 본다 — 부분 문자열이면 공급사 request id 속 숫자에 걸린다(useNodeGeneration 과 같다).
      const isProviderBusy = /provider_busy|\b429\b|too many requests/i.test(message);
      const baseMessage = isProviderBusy
        ? tCreate.errors.providerBusy
        : isInsufficientCredits
        ? (insufficientCreditMessage ?? tNC.insufficientCreditsShort)
        // 안전 필터·저작권 차단 같은 프로바이더 사유를 그대로 흘리면 "실패했습니다" 로만
        // 뜨고, 사용자는 같은 프롬프트로 다시 눌러 같은 이유로 또 실패한다. 영상이 쓰는
        // 매퍼를 그대로 태운다 — 못 알아본 문구는 매퍼가 일반 문구로 떨어뜨리므로
        // 프로바이더 원문이 화면에 새지 않는다.
        : mapVideoGenerationErrorToUserString(message, videoGenErr);
      // 크레딧 부족으로 아예 차감되지 않은 경우엔 환불도 없다 — 그때는 붙지 않는다(0).
      const userMessage =
        refundedCredits > 0
          ? `${baseMessage} ${tCreate.errors.creditsRefunded(refundedCredits)}`
          : baseMessage;
      console.error("[ImageNode] image generation error:", err);
      setError(userMessage);
      data.onImageGenerationError?.(nodeId!, userMessage);
      data.onImageGenerated?.(nodeId!, "");
      // 환불이 실패했다면 잔액이 실제로 줄어든 상태다 — 표시된 숫자를 실제와 맞춘다.
      data.onCreditBalanceMayHaveChanged?.();
    } finally {
      generateInflightRef.current = false;
      // 다음 클릭은 새 제출이다 — 같은 프롬프트를 다시 굴리는 것도 포함해서.
      submissionKeyRef.current = null;
    }
  }, [
    effectivePrompt,
    isGenerating,
    insufficientCreditMessage,
    locale,
    data,
    model,
    aspectRatio,
    nodeId,
  ]);

  /** 생성 버튼 → 부모 크레딧 게이트(사용 확인·부족 안내) 경유 후 실제 생성 */
  const handleGenerate = useCallback(
    (opts?: { preconfirmed?: boolean }) => {
      /**
       * 각도 변환은 프롬프트가 없다 — fal 이 각도 값에서 프롬프트를 직접 조립하므로
       * 사용자가 쓸 문장이 애초에 없다. 프롬프트 요구는 일반 생성에만 건다.
       */
      const needsPrompt = !data.camera;
      if (needsPrompt && !effectivePrompt.trim()) return;
      if (isGenerating || generateInflightRef.current) return;
      if (data.onCreditGateRequest) {
        data.onCreditGateRequest({
          cost: estimatedCreditCost,
          proceed: () => void doGenerate(),
          ...(opts?.preconfirmed ? { preconfirmed: true } : {}),
        });
        return;
      }
      void doGenerate();
    },
    [data, effectivePrompt, isGenerating, estimatedCreditCost, doGenerate],
  );

  /**
   * 각도 모달이 만든 노드는 마운트 직후 한 번 스스로 생성한다.
   *
   * ref 로 1회를 못박는다 — StrictMode 이중 실행·리렌더·부모의 data 재생성 어디서도 두 번
   * 돌면 그만큼 크레딧이 빠진다. 플래그 자체는 저장되지 않으므로(`TRANSIENT_KEYS`) 새로고침
   * 으로 되살아나지도 않는다.
   */
  const autoGenerateFiredRef = useRef(false);
  useEffect(() => {
    if (!data.autoGenerateOnce || autoGenerateFiredRef.current) return;
    if (isGenerating || generateInflightRef.current) return;
    autoGenerateFiredRef.current = true;
    data.onAutoGenerateConsumed?.(nodeId!);
    handleGenerate({ preconfirmed: true });
  }, [data, nodeId, isGenerating, handleGenerate]);

  const modelLabel =
    IMAGE_MODEL_OPTIONS.find((option) => option.id === model)?.label ?? model;

  /** 툴바에서 고른 비율 — 생성 노드 플레이스홀더·생성 중 */
  const toolbarAspect = aspectRatioStringToNumber(aspectRatio);
  const storedMediaAspect =
    typeof data.mediaAspect === "number" && data.mediaAspect > 0
      ? data.mediaAspect
      : toolbarAspect;
  /** 업로드 노드는 저장된 크롭 비율, 생성 노드는 툴바 비율 */
  const imageFrameAspect = isUploadOrigin ? storedMediaAspect : toolbarAspect;

  const handleDownloadImage = useCallback(async () => {
    const url = data.imageUrl;
    if (!url) return;
    const ext = url.startsWith("data:image/jpeg") ? "jpg" : "png";
    try {
      await downloadMediaUrl(url, `image-${Date.now()}.${ext}`);
    } catch {
      window.open(url, "_blank", "noopener,noreferrer");
    }
  }, [data.imageUrl]);

  /** 업로드 노드: 좌측 이미지 버튼 항상 비활성. 생성 노드: 이미지가 있으면(생성 완료) 비활성 */
  const imageSideButtonDisabled = imageInputLocked({
    isUploadOrigin,
    hasImage: hasImage,
  });
  const imageSideButtonDisabledHint = isUploadOrigin
    ? tNC.sideButtonsV2.imageSideDisabledUpload
    : hasImage
      ? tNC.sideButtonsV2.imageSideDisabledAfterGenerate
      : undefined;

  // 실제 생성이 단계 라벨보다 먼저 끝나도 결과가 뚝 끊겨 나타나지 않도록,
  // 완료 후에도 잠깐 생성 중 표시를 유지(tail)하고 그 사이 라벨을 마지막 단계로 고정.
  const { showGenerating: showRealImageGenerating, isTail: imageGeneratingTail } =
    useGeneratingWithTail(isGenerating, IMAGE_GENERATING_TAIL_MS);
  const showImageAreaGenerating = showRealImageGenerating;

  const [headerToneImgEl, setHeaderToneImgEl] =
    useState<HTMLImageElement | null>(null);
  const attachHeaderToneImgRef = useCallback((node: HTMLImageElement | null) => {
    setHeaderToneImgEl((prev) => (prev === node ? prev : node));
  }, []);
  const imageHeaderToneEnabled = hasImage && !showImageAreaGenerating;
  const imageHeaderMediaTone = useNodeHeaderMediaTone(
    headerToneImgEl,
    imageHeaderToneEnabled,
    data.imageUrl?.trim() ?? "",
  );
  const imageHeaderToneClass =
    imageHeaderMediaTone === "bright"
      ? NODE_TITLE_MEDIA_BACKDROP_BRIGHT
      : imageHeaderMediaTone === "dark" || imageHeaderToneEnabled
        ? NODE_TITLE_MEDIA_BACKDROP_DARK
        : "";

  const imagePromptActionSlot = showGenerateButton ? (
    <ChromeTooltip
      label={
        isGenerating
          ? tCreate.generateBusy
          : !effectivePrompt.trim()
            ? data.connectedTextMode === "llm"
              ? tNC.generateHintLlmNotReady
              : tNC.promptRequiredTitle
            : insufficientCreditMessage ?? ""
      }
      placement="top"
      invertCanvasZoom
      hostClassName={TOOLTIP_HOST_CONTENTS}
    >
      <NodePromptGenerateButton
        className={`${PROMPT_SUBMIT_FAB}${
          isGenerating || !effectivePrompt.trim()
            ? ` ${PROMPT_SUBMIT_FAB_DIMMED}`
            : ""
        }`}
        onClick={() => handleGenerate()}
        disabled={isGenerating || !effectivePrompt.trim()}
        loading={isGenerating}
        creditCost={estimatedCreditCost}
        aria-label={
          isGenerating
            ? tCreate.generateBusy
            : isEditMode
              ? tNC.generateEdit
              : tNC.imageToolbarGenerate
        }
      />
    </ChromeTooltip>
  ) : hasImage && !isUploadOrigin ? (
    /** 생성 완료 — 같은 자리에 재생성(같은 설정으로 새 노드 복제) FAB */
    <ChromeTooltip
      label={tV2.regenerateClone}
      placement="top"
      invertCanvasZoom
      hostClassName={TOOLTIP_HOST_CONTENTS}
    >
      <NodePromptGenerateButton
        className={`${PROMPT_SUBMIT_FAB}${isGenerating ? ` ${PROMPT_SUBMIT_FAB_DIMMED}` : ""}`}
        onClick={() => data.onRegenerateClone?.()}
        disabled={isGenerating}
        caption={tV2.regenerate}
        aria-label={tV2.regenerateClone}
      />
    </ChromeTooltip>
  ) : null;


  /**
   * 업로드 전용 노드(`isUploadOrigin && !showPromptSection`)는 모델/비율 툴바도 숨기고
   * 미디어 밴드만 노출 → 미디어 영역 하단을 카드 곡률로 마감.
   */
  const showMetaToolbar = showModelAndRatioToolbar;

  /**
   * 업로드·생성 결과 모두 같은 프레임(비율 + cover). 미디어 아래 카드블록 유무로만 하단 라운드를 정함.
   *
   * 연결 이미지 스트립은 **프롬프트 섹션 안에서만** 그려지므로(아래 JSX) 독립 항으로 세지
   * 않는다. 세면 섹션을 숨긴 노드(각도 변환)에서 아래에 아무것도 없는데 하단이 각지게 남아,
   * 카드의 24px 모서리 밖으로 사진이 삐져나온다 — 셸이 `overflow-visible` 이라 잘리지도 않는다.
   */
  const blockAttachedBelowMediaBand =
    showMetaToolbar || Boolean(showPromptSection);

  const imageAreaCardBottomRounded = !error && !blockAttachedBelowMediaBand;

  return (
    <div
      ref={nodeLayoutRef}
      className={`${NODE_CONTAINER} ${NODE_CONTAINER_CHROME} ${isSpawned ? NODE_CONTAINER_ANIMATE : NODE_CONTAINER_IDLE}`}
      data-node-accent="image"
      {...(marketingModelMenuOpen
        ? { "data-marketing-model-picker": "" }
        : {})}
      {...(marketingModelMenuOpen && !marketingMenuInteracted
        ? { "data-marketing-model-static": "" }
        : {})}
    >
      {/* 피그마식 — 헤더(아이콘+타이틀 / 다운로드·삭제)를 노드 카드 위로. 선택 시 accent 색은
         오버레이 아닌 nodeTitleWrap 을 칠하는 기존 규칙(NodeCanvasV2.module.css)이 자동 적용. */}
      <div className={NODE_HEADER_ABOVE}>
        <div className={NODE_TITLE_WRAP} data-node-title="plain">
          <span className={NODE_TITLE_ICON}>
            <NodeHeaderGlyph kind="image" data={data} />
          </span>
          <span className={`type-body-14-medium ${NODE_TITLE_LABEL}`}>
            {data.videoFrameTitle === "startFrame"
              ? tNC.sideButtonsV2.startFrame
              : data.videoFrameTitle === "endFrame"
                ? tNC.sideButtonsV2.endFrame
                : tNC.sideButtonsV2.image}
          </span>
        </div>
        {/* 편집 모드 칩 — 타이틀 바로 옆에 붙인다(삭제 액션 묶음과 분리). */}
        {isEditMode ? (
          <div className={EDIT_BADGE}>
            <NodeTitleChipGlyph kind="editMode" />
            {tNC.editModeBadge}
          </div>
        ) : null}
        <div className={`${NODE_HEADER_ABOVE_ACTIONS} ml-auto`}>
            <NodeHeaderActions
              download={{
                label: tV2.download,
                onClick: () => void handleDownloadImage(),
                disabled: !hasImage,
              }}
              remove={{
                label: tV2.delete,
                disabledLabel: tNC.imageDeleteGeneratingHint,
                onClick: () => data.onDeleteNode?.(),
                disabled: isGenerating,
              }}
            />
        </div>
      </div>
      <div className={NODE_MAIN}>
        <div className={NODE_WRAP} data-node-chrome="wrap">
          <NodeSideButtons
            variant="image"
            showImageHandle
            showTextHandle
            imageButtonDisabled={imageSideButtonDisabled}
            imageButtonDisabledHint={imageSideButtonDisabledHint}
            onAddImageNode={data.onAddImageNode}
            onAddTextNode={data.onAddTextNode}
            allDisabled={isLocked}
            allDisabledHint={tNC.sideButtonsV2.lockedAfterGenerate}
            projectId={data.projectId}
          />

          {/* 출력점을 누르면 「다음 단계」 메뉴 — 예전엔 눌러도 아무 일이 없고 끌어야만 이어졌다 */}
          <div className="contents" ref={nextStepRef}>
            <Handle
              type="source"
              position={Position.Right}
              id="image"
              className={nextStepHint.active ? `${SOURCE_HANDLE} ${SOURCE_HANDLE_HINT_PULSE}` : SOURCE_HANDLE}
              {...nextStep.handleProps}
            >
              <span className={SIDE_HANDLE_FACET} data-side-handle-facet>
                <NodeHandleGlyph id="image" />
              </span>
            </Handle>
            {nextStepHint.visible ? (
              <CanvasNextStepHint
                kind="image"
                side={nextStepHint.side}
                onDismiss={nextStepHint.close}
                announce={nextStepHint.announce}
              />
            ) : null}
            {canShowNextStep ? (
              <NodeNextStepMenu
                id={nextStep.menuId}
                open={nextStepOpen}
                onClose={closeNextStep}
                side={nextStep.side}
                items={[
                  {
                    key: "video-start",
                    icon: <VideoCameraIcon size={15} />,
                    label: tNC.sideButtonsV2.nextStep.imageToVideo,
                    hint: tNC.sideButtonsV2.nextStep.imageToVideoHint,
                    onSelect: () => data.onAddNextNode?.("video-start"),
                  },
                  {
                    key: "video-ref",
                    icon: <VideoCameraIcon size={15} />,
                    label: tNC.sideButtonsV2.nextStep.imageAsReference,
                    hint: tNC.sideButtonsV2.nextStep.imageAsReferenceHint,
                    onSelect: () => data.onAddNextNode?.("video-ref"),
                  },
                  {
                    key: "image-ref",
                    icon: <ImageIcon size={15} />,
                    label: tNC.sideButtonsV2.nextStep.imageToImage,
                    hint: tNC.sideButtonsV2.nextStep.imageToImageHint,
                    onSelect: () => data.onAddNextNode?.("image-ref"),
                  },
                ]}
              />
            ) : null}
          </div>

          <div className={NODE_MAIN_MEDIA_BAND}>
            <div
              className={`${IMAGE_AREA} ${
                hasImage
                  ? IMAGE_AREA_MEDIA_FRAMED
                  : IMAGE_AREA_ASPECT_TRANSITION
              }${imageAreaCardBottomRounded ? ` ${IMAGE_AREA_CARD_BOTTOM_ROUND}` : ""}${showImageAreaGenerating && !hasImage ? ` ${IMAGE_AREA_GENERATING}` : ""}`}
              style={{ aspectRatio: imageFrameAspect }}
            >
              {hasImage ? (
                // eslint-disable-next-line @next/next/no-img-element
                <img
                  ref={attachHeaderToneImgRef}
                  src={data.imageUrl}
                  alt={tNC.imageAltGenerated}
                  className={IMAGE_EL}
                />
              ) : showImageAreaGenerating ? (
                <GeneratingState
                  stages={tNC.imageGeneratingStages}
                  startedAt={data.generationStartedAt}
                  forceLastStage={imageGeneratingTail}
                />
              ) : (
                <ImagePlaceholder emptyLabel={tNC.imageNoImageYet} />
              )}
            </div>
          </div>

                      {showPromptSection ? (
            <div
              className={`${PROMPT_AREA} ${PROMPT_AREA_CARD_BOTTOM_ROUND}`}
            >
              {firstNodeHint ? (
                <CanvasFirstNodeHint
                  body={firstNodeHint.body}
                  anchor="prompt"
                  onDismiss={firstNodeHint.onDismiss}
                  announce={firstNodeHint.announce}
                />
              ) : null}
              <div
                className={`${PROMPT_COMPOSER}${showMetaToolbar ? ` ${PROMPT_COMPOSER_WITH_META_FOOTER}` : ""}`}
              >
                <div
                  className={`${PROMPT_FIELD_SHELL} ${
                    showConnectedChip ||
                    promptLinkedImageUrls.length > 0
                      ? PROMPT_FIELD_SHELL_WITH_REFERENCE_MEDIA
                      : PROMPT_FIELD_SHELL_MIN_H
                  }${
                    showMetaToolbar ? ` ${PROMPT_FIELD_SHELL_WITH_META_FOOTER}` : ""
                  }`}
                  {...(marketingModelMenuOpen
                    ? { "data-embed-marketing-model-focus": "" }
                    : {})}
                >
                  {promptLinkedImageUrls.length > 0 ? (
                    <div className={PROMPT_REFERENCE_MEDIA_INSIDE_SHELL}>
                      <PromptLinkedImageStrip urls={promptLinkedImageUrls} />
                    </div>
                  ) : null}
                  {showConnectedChip ? (
                    <div className={PROMPT_CHIP_INSIDE_SHELL}>
                      <div className={PROMPT_CONNECTION_CHIP} role="status">
                        <SparkleIcon size={16} className="shrink-0 text-[var(--accent-yellow-500)]" />
                        <span
                          className={PROMPT_CONNECTION_CHIP_TEXT}
                          title={
                            effectivePrompt.trim().length > 0
                              ? effectivePrompt
                              : undefined
                          }
                        >
                          {imageConnectionChipLabel}
                        </span>
                      </div>
                    </div>
                  ) : (
                    <>
                      <div className={PROMPT_COPY_COUNT_ROW}>
                        <NodePromptInputCopyButton
                          textToCopy={effectivePrompt}
                          tooltip={tNC.promptInputCopy}
                          ariaLabel={tNC.promptInputCopyAria}
                        />
                        <span
                          className={`type-caption-12-regular ${PROMPT_CHAR_COUNT_IN_SHELL}`}
                          aria-live="polite"
                        >
                          {tV2.textNodeCharCount(effectivePrompt.length)}
                        </span>
                      </div>
                      <textarea
                        ref={promptTextareaRef}
                        className={`type-body-14-regular ${PROMPT_TEXTAREA} ${isPromptReadOnly ? PROMPT_TEXTAREA_CONNECTED : PROMPT_TEXTAREA_TONE} ${promptTextareaFlowClass}`}
                        value={effectivePrompt}
                        onChange={handleChange}
                        onKeyDown={handleKeyDown}
                        onWheelCapture={wheelCaptureWhenFocusedScrollable}
                        placeholder={
                          isPromptReadOnly
                            ? tNC.imagePromptReadonlyPlaceholder
                            : isEditMode
                              ? tNC.imagePromptEditPlaceholder
                              : tNC.imagePromptPlaceholder
                        }
                        readOnly={isPromptReadOnly || isLocked}
                        rows={3}
                      />
                    </>
                  )}
                  <div className={PROMPT_FOOTER}>
                    <div className={PROMPT_FOOTER_CONTROLS}>
                      {showMetaToolbar ? (
            <div className={META_TOOLBAR}>
              {/* VideoNode 와 동일한 space-between 패턴 — 좌측 모델 / 우측 비율 */}
              <div className={META_TOOLBAR_LEADING}>
                {showModelAndRatioToolbar ? (
                  <div
                    className={`${DROPDOWN_WRAP} ${DROPDOWN_WRAP_MODEL}`}
                    ref={modelRef}
                    {...(marketingModelMenuOpen
                      ? { "data-embed-marketing-model-focus": "" }
                      : {})}
                  >
                    <ChromeTooltip
                      label={
                        isGenerating ? tCreate.generateBusy : modelLabel
                      }
                      placement="top"
                      invertCanvasZoom
                      hostClassName={META_TOOLTIP_HOST_MODEL}
                      // 마케팅 데모: 호버 시 버튼 위로 뜨는 모델명 툴팁(버튼 라벨과 중복)을 끈다.
                      // 툴팁 박스+그림자가 버튼 상단을 어둡게 덮는 현상 제거. 실제 에디터에선 유지.
                      suppress={modelOpen || marketingModelMenuOpen}
                    >
                      <button
                        type="button"
                        className={`type-caption-12-regular ${META_MODEL} ${REACT_FLOW_NODE_NO_DRAG}`}
                        aria-disabled={metaSpecsLocked || undefined}
                        onClick={() => {
                          if (metaSpecsLocked) return;
                          if (marketingModelMenuOpen) {
                            setMarketingMenuInteracted(true);
                          }
                          setModelOpen((p) => {
                            const next = !p;
                            if (next) {
                              setRatioOpen(false);
                              setQualityOpen(false);
                            }
                            return next;
                          });
                        }}
                        aria-expanded={modelOpen}
                        disabled={metaSpecsLocked}
                      >
                        <span className={META_MODEL_LABEL}>{modelLabel}</span>
                        <span className={`${META_CHEVRON}${modelOpen ? ` ${META_CHEVRON_OPEN}` : ""}`}>
                          <ToolbarChevronDown />
                        </span>
                      </button>
                    </ChromeTooltip>
                    <MetaDropdownPanel
                      open={modelOpen}
                      staticOpen={
                        marketingModelMenuOpen &&
                        modelOpen &&
                        !marketingMenuInteracted
                      }
                      anchorClassName={
                        marketingModelMenuOpen
                          ? DROPDOWN_ANCHOR_BELOW
                          : DROPDOWN_ANCHOR
                      }
                      surfaceClassName={DROPDOWN_SURFACE}
                      motionOrigin={
                        marketingModelMenuOpen ? "top-center" : "bottom-center"
                      }
                      autoVerticalFlip={marketingModelMenuOpen ? false : undefined}
                    >
                      <div
                        className={`type-caption-12-regular ${DROPDOWN_EYEBROW}`}
                        aria-hidden="true"
                      >
                        {tNC.imageModelLabel}
                      </div>
                      {IMAGE_MODEL_OPTIONS.map(({ id, label }) => (
                        <button
                          key={id}
                          type="button"
                          className={`type-body-14-regular ${DROPDOWN_OPTION} ${id === model ? DROPDOWN_OPTION_ACTIVE : DROPDOWN_OPTION_IDLE}`}
                          onClick={() => {
                            const prevModelId = model;
                            preferredAspectByModelRef.current[prevModelId] =
                              aspectRatio;

                            data.onModelChange?.(id);
                            const supported = getAspectRatiosForModel(id);
                            const remembered =
                              preferredAspectByModelRef.current[id];
                            let next: AspectRatio;
                            if (
                              remembered !== undefined &&
                              supported.includes(remembered)
                            ) {
                              next = remembered;
                            } else if (supported.includes(aspectRatio)) {
                              next = aspectRatio;
                            } else {
                              next = pickNearestSupportedAspect(
                                aspectRatio,
                                supported,
                              );
                            }
                            setAspectRatio(next);
                            preferredAspectByModelRef.current[id] = next;
                            data.onMediaAspectChange?.(
                              aspectRatioStringToNumber(next),
                            );
                            setModelOpen(false);
                          }}
                        >
                          {label}
                        </button>
                      ))}
                    </MetaDropdownPanel>
                  </div>
                ) : null}
              </div>

              {showModelAndRatioToolbar ? (
                <div className={META_TOOLBAR_TRAILING}>
                  <div className={DROPDOWN_WRAP} ref={ratioRef}>
                    <ChromeTooltip
                      label={tV2.metaAspectRatio}
                      placement="top"
                      invertCanvasZoom
                      suppress={ratioOpen}
                    >
                      <button
                        type="button"
                        className={`type-caption-12-regular ${META_ITEM} ${REACT_FLOW_NODE_NO_DRAG}`}
                        aria-disabled={metaSpecsLocked || undefined}
                        onClick={() => {
                          if (metaSpecsLocked) return;
                          setRatioOpen((p) => {
                            const next = !p;
                            if (next) {
                              setModelOpen(false);
                              setQualityOpen(false);
                            }
                            return next;
                          });
                        }}
                        disabled={metaSpecsLocked}
                      >
                        {aspectRatio}
                        <span className={`${META_CHEVRON}${ratioOpen ? ` ${META_CHEVRON_OPEN}` : ""}`}>
                          <ToolbarChevronDown />
                        </span>
                      </button>
                    </ChromeTooltip>
                    <MetaDropdownPanel
                      open={ratioOpen}
                      anchorClassName={DROPDOWN_ANCHOR}
                      surfaceClassName={DROPDOWN_SURFACE}
                      motionOrigin="bottom-center"
                    >
                      <div
                        className={`type-caption-12-regular ${DROPDOWN_EYEBROW}`}
                        aria-hidden="true"
                      >
                        {tV2.metaAspectRatio}
                      </div>
                      {getAspectRatiosForModel(model).map((r) => (
                        <button
                          key={r}
                          type="button"
                          className={`type-body-14-regular ${DROPDOWN_OPTION} ${r === aspectRatio ? DROPDOWN_OPTION_ACTIVE : DROPDOWN_OPTION_IDLE}`}
                          onClick={() => {
                            setAspectRatio(r);
                            preferredAspectByModelRef.current[model] = r;
                            data.onMediaAspectChange?.(aspectRatioStringToNumber(r));
                            setRatioOpen(false);
                          }}
                        >
                          {r}
                        </button>
                      ))}
                    </MetaDropdownPanel>
                  </div>

                  {/* 품질 선택 (OpenAI 모델만) */}
                  {model.startsWith("gpt-image") ? (
                    <div className={DROPDOWN_WRAP} ref={qualityRef}>
                      <ChromeTooltip
                        label={tNC.imageQualityLabel}
                        placement="top"
                        invertCanvasZoom
                        suppress={qualityOpen}
                      >
                        <button
                          type="button"
                          className={`type-caption-12-regular ${META_ITEM} ${REACT_FLOW_NODE_NO_DRAG}`}
                        aria-disabled={metaSpecsLocked || undefined}
                          onClick={() => {
                            if (metaSpecsLocked) return;
                            setQualityOpen((p) => {
                              const next = !p;
                              if (next) { setModelOpen(false); setRatioOpen(false); }
                              return next;
                            });
                          }}
                          disabled={metaSpecsLocked}
                        >
                          {QUALITY_OPTIONS.find((q) => q.id === quality)?.label ??
                            tNC.imageQualityOptions[defaultQualityForModel(model)]}
                          <span className={`${META_CHEVRON}${qualityOpen ? ` ${META_CHEVRON_OPEN}` : ""}`}>
                            <ToolbarChevronDown />
                          </span>
                        </button>
                      </ChromeTooltip>
                      <MetaDropdownPanel
                        open={qualityOpen}
                        anchorClassName={DROPDOWN_ANCHOR}
                        surfaceClassName={DROPDOWN_SURFACE}
                        motionOrigin="bottom-center"
                      >
                        <div
                          className={`type-caption-12-regular ${DROPDOWN_EYEBROW}`}
                          aria-hidden="true"
                        >
                          {tNC.imageQualityLabel}
                        </div>
                        {QUALITY_OPTIONS.map(({ id: qId, label: qLabel }) => (
                          <button
                            key={qId}
                            type="button"
                            className={`type-body-14-regular ${DROPDOWN_OPTION} ${qId === quality ? DROPDOWN_OPTION_ACTIVE : DROPDOWN_OPTION_IDLE}`}
                            onClick={() => {
                              data.onQualityChange?.(qId);
                              setQualityOpen(false);
                            }}
                          >
                            {qLabel}
                          </button>
                        ))}
                      </MetaDropdownPanel>
                    </div>
                  ) : null}
                </div>
              ) : null}

            </div>
                                  ) : null}
                      <div className={PROMPT_FOOTER_GENERATE}>
                        {imagePromptActionSlot}
                      </div>
                    </div>
                    {(() => {
                      const promptError =
                        error ||
                        (effectivePrompt.trim() ? insufficientCreditMessage : null);
                      return promptError ? (
                        <div className={PROMPT_ERROR_BANNER} role="alert">
                          <span
                            className={`type-body-14-regular ${PROMPT_ERROR_BANNER_TEXT}`}
                            title={promptError}
                          >
                            {promptError}
                          </span>
                        </div>
                      ) : null;
                    })()}
                  </div>
                        </div>
              </div>
            </div>
          ) : null}
        </div>
      </div>

      {promptResize.showHandle ? (
        <NodePromptResizeHandle
          onPointerDown={promptResize.onHandlePointerDown}
          onDoubleClick={promptResize.onHandleDoubleClick}
          ariaLabel={tNC.promptResizeAria}
        />
      ) : null}
    </div>
  );
}
