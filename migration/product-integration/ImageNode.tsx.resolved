} from "../nodeShellStyles";

/* ── 스타일 ────────────────────────────────────────────────────────────────────
 * 이전 `ImageNode.module.css` (삭제) + 이 컴포넌트가 쓰던 공유 모듈 세 갈래
 * (`NodeGeneratingShimmer.module.css` · `nodeSideHandleChrome.module.css` ·
 * `ImageNode.module.css` 가 `composes` 로 끌어오던 `NodePromptArea.module.css`)
 * 를 전부 유틸리티로 옮긴 것. 공유 모듈 파일 자체는 다른 노드가 계속 쓰므로 남는다.
 *
 * **네 갈래를 함께 옮긴 이유**: 레이어 밖 모듈 CSS 는 `@layer utilities` 를 특이도와
 * 무관하게 무조건 이긴다. 한 요소에 유틸리티와 모듈을 섞으면 옮긴 선언이 조용히 죽는다
 * (예: 쉬머의 `.mediaCaption{color}` 와 자체 `.generatingLabel{color}`).
 *
 * 원본은 다크 기본 + 라이트 오버라이드 구조다. 라이트 킬스위치 셀렉터
 * `:is(html[data-theme="light"]:not(:has([data-landing-walkthrough-dark])), [data-landing-walkthrough-light])`
 * 는 `tailwind.css` 에 `light:` 변형으로 그대로 등록되어 있으므로 테마 방향을 뒤집지 않는다.
 *
 * `hover:` 대신 `[&:hover]:` — 원본 모듈 CSS 의 `:hover` 에는 `@media (hover: hover)`
 * 가드가 없었다. `@keyframes media-icon-*` · `media-caption-*` 는 `app/keyframes.css`
 * 로 이미 전역화되어 있다(이름·본문 전수 대조 완료 — 추가 필요 없음).
 *
 * `type-*` 전역 클래스는 `globals.css` 의 `@layer base` 안이므로 `@layer utilities` 가
 * `!` 없이 이긴다. 원본에서 모듈 CSS 가 type-* 를 덮던 선언(line-height·font-family·
 * 워크스루 폰트)은 그래서 `!` 없는 평범한 유틸리티로 옮긴다.
 *
 * ## 레이어 밖 전역과 다투는 선언 — `!` 가 필요한 곳
 *
 * 같은 이유로, **특이도가 낮아도 레이어 밖이면 유틸리티를 이긴다**. 원본 모듈 CSS 는
 * 레이어 밖이라 소스 순서로 이기고 있었으므로, 옮길 때 `!` 를 붙이지 않으면 조용히 죽는다:
 *
 *   1. `globals.css` 의 `* { scrollbar-width; scrollbar-color }` 와
 *      `*::-webkit-scrollbar{,-track,-thumb,-thumb:hover}` — 특이도 0 이지만 레이어 밖이라
 *      스크롤바 커스터마이즈가 전부 무력화된다. → 프롬프트 textarea 스크롤바 선언 전부 `!`
 *      (width · background · border-radius). 전역 thumb 은 `background-clip: padding-box`
 *      까지 깔아 두는데 원본은 `background` 단축으로 그걸 초기값(border-box)으로 되돌렸다
 *      → `bg-clip-border!` 를 함께 준다. (전역 thumb 의 `border: 2px solid transparent`
 *      는 원본에서도 살아 있던 값이라 그대로 둔다.)
 *   2. 랜딩 `page.module.css` 의 `[data-page-root] :where(h1,…,span,button,…) { text-wrap: balance;
 *      word-break: keep-all; overflow-wrap: break-word }` — `text-wrap` 이 `white-space`
 *      와 `text-wrap-mode` 롱핸드를 공유해 `whitespace-nowrap` 이 무시된다.
 *      → span/button 요소의 `whitespace-nowrap!` 6곳. (`div` 는 그 `:where()` 목록에
 *      없으므로 `.metaToolbar`/`.dropdownEyebrow` 의 white-space 는 `!` 가 필요 없다.)
 *   3. globals `[data-tooltip]:not([data-tooltip=""])::after` 가 position·top·white-space·
 *      pointer-events·color·box-shadow·padding 을 레이어 밖에서 공급한다. 소스 핸들이
 *      옮기는 것은 `left` 하나뿐이고 전역은 `left` 를 세우지 않으므로 충돌이 없다
 *      (그 일곱 프로퍼티는 이 파일에서 아예 옮기지 않는다 — 전역 SSOT 그대로 둔다).
 *   4. React Flow 자체 스타일시트(`@xyflow/react/dist/style.css`) 는 레이어 밖이라
 *      `.react-flow__handle` 의 position·top·left·크기·배경·테두리·transform 을 이긴다.
 *      원본 `.sourceHandle` 이 전 선언에 `!important` 를 달았던 이유가 그것이므로 그대로 옮긴다.
 *   5. `NodePromptGenerateButton.module.css` 의 `.root{margin:0}` · `.chrome{transform;
 *      transition;flex-shrink}` 도 레이어 밖 → 생성 FAB 의 `ml-4!` · `flex-[0_0_auto]!` ·
 *      워크스루 프레스 변형 `!`.
 *   6. `MetaDropdownPanel.module.css` 의 `.motion{opacity;transform}` · `.motionOpen
 *      {pointer-events}` 도 레이어 밖 → 마케팅 정적 노출 오버라이드에 `!`.
 *   7. ChromeTooltip 호스트의 기본 `inline-flex` 를 덮던 `display: contents` → `contents!`.
 *
 * 노드 카드 외곽선(2px) · 선택 accent · 사이드 핸들 비활성 배경은
 * `NodeCanvasV2.module.css` 가 `data-node-chrome="wrap"` · `data-node-title="plain"` ·
 * `data-side-handle-facet` 속성으로 공급한다 (SSOT) — 속성은 그대로 유지한다.
 */

/* ── Node Container ── */
const NODE_CONTAINER = [
  "[--node-card-width:400px]",
  "[--node-side-outset:0px]",
  "relative flex flex-col items-center gap-5",
  "[transition:opacity_220ms_ease-out,transform_220ms_cubic-bezier(0.34,1.56,0.64,1)]",
].join(" ");

/* 등장(spawn) 전/후 — 같은 프로퍼티를 다투므로 상호배타 분기로 갈라 둔다. */
const NODE_CONTAINER_IDLE = "opacity-0 [transform:scale(0.96)]";
const NODE_CONTAINER_ANIMATE = "opacity-100 [transform:scale(1)]";

/* 원본 `.nodeContainerChrome` 의 기본 선언(`--node-side-outset: 0px`, `align-items: center`)은
   `.nodeContainer` 와 값이 같아 no-op 이라 생략한다. 실제로 달라지는 것은 마케팅 스코프뿐:
   랜딩/마케팅(`data-node-canvas-marketing`) 에서만 좌우 크롬을 노드 박스 안에 포함한다. */
const NODE_CONTAINER_CHROME = [
  "[[data-node-canvas-marketing]_&]:[--node-side-outset:var(--node-side-leading-offset)]",
  "[[data-node-canvas-marketing]_&]:items-stretch",
].join(" ");

const NODE_MAIN =
  "relative w-[calc(var(--node-card-width)_+_2_*_var(--node-side-outset))]";

/* 미디어 코너 반경 · 오버레이 타이틀 등 — 카드 크롬 기준은 NODE_WRAP */
const NODE_MAIN_MEDIA_BAND = "relative w-full";

/* ── Card ──
 * 미디어·프롬프트 코너 곡률은 캔버스 `--node-inner-radius` 상속 (외곽 24px − border 2px).
 * 외곽선(border)은 NodeCanvasV2.module.css 에서 일괄 관리한다 (SSOT). */
const NODE_WRAP = [
  "relative w-[var(--node-card-width)] ml-[var(--node-side-outset)] box-border",
  "rounded-[var(--node-outer-radius,24px)] overflow-visible",
  /* 카드 면 — 바닥의 한 칸 위(`NODE_CARD_SURFACE` 주석). */
  NODE_CARD_SURFACE,
  "cursor-default select-none",
].join(" ");

/* 아이콘·타이틀 한 줄 수직 정렬.
   미선택 다크 헤더 색 — 라이트 gray-700 override 는 원본 `.nodeHeaderAbove .nodeTitleWrap`
   규칙에서 왔다(이 파일의 유일한 사용처가 헤더 안이라 승자 선언만 남긴다).
   선택 시 accent 는 NodeCanvasV2 가 `data-node-title="plain"` 으로 !important 로 덮는다.
   `w-auto`~`p-0`: 내용폭만 차지(늘어나지 않음) → 편집 모드 칩이 타이틀 바로 옆에 붙는다. */
const NODE_TITLE_WRAP = [
  "flex items-center gap-[5px]",
  "w-auto flex-[0_1_auto] min-w-0 m-0 p-0",
  "text-[rgb(var(--palette-gray-400-rgb)/100%)]",
  "light:text-[rgb(var(--palette-gray-700-rgb)/100%)]",
].join(" ");

const NODE_TITLE_ICON =
  "inline-flex items-center justify-center flex-[0_0_auto] text-inherit";

/* type-body-14 의 line-height 1.5 기본값을 헤더 한 줄에서 1 로 좁혀 아이콘과 시각 중앙 정렬
   (`type-*` 는 `@layer base` 안이라 `leading-[1]` 이 `!` 없이 이긴다).
   `whitespace-nowrap!` 의 `!` 는 랜딩
   `[data-page-root] :where(span, …) { text-wrap: balance }` 때문 — 위 스타일 헤더 2번 참조. */
const NODE_TITLE_LABEL = [
  "text-inherit min-w-0",
  NODE_TITLE_CLIP,
  "leading-[1]",
].join(" ");

/* 미디어 상단 줄 밝기 샘플(`useNodeHeaderMediaTone`) — 미디어 기반 단일 SSOT(테마 무관).
 * 원본에서 이 두 클래스의 규칙은 `.nodeMediaHeaderRow` 와 함께 걸릴 때만 성립했는데,
 * 이 컴포넌트는 그 행을 렌더하지 않는다(값을 계산만 하고 어디에도 붙이지 않는다).
 * 원본 선언을 그대로 옮겨 둔다 — 자식(아이콘·라벨·더보기 글리프)이 var() 로 받는 토큰 포함. */
const NODE_TITLE_MEDIA_BACKDROP_BRIGHT = [
  "text-[rgb(var(--palette-gray-900-rgb)/88%)]",
  "[--header-icon-filter:drop-shadow(0_1px_1px_rgb(0_0_0/24%))]",
  "[--header-text-shadow:0_1px_2px_rgb(0_0_0/12%)]",
].join(" ");

const NODE_TITLE_MEDIA_BACKDROP_DARK = [
  "text-[rgb(var(--palette-gray-000-rgb)/96%)]",
  "[--header-icon-filter:drop-shadow(0_1px_2px_rgb(0_0_0/40%))]",
  "[--header-text-shadow:0_0_1px_rgb(0_0_0/40%),0_1px_3px_rgb(0_0_0/32%)]",
].join(" ");

/* ── Edit mode badge (헤더 행 — 타이틀 옆) ──
 * 치수와 글자는 편집 노드의 재편집 필요 칩과 같은 `NODE_TITLE_CHIP` 이고, 여기는 색만 붙인다. */
const EDIT_BADGE = [
  NODE_TITLE_CHIP,
  "bg-[rgb(139_92_246/16%)] text-[rgb(167_139_250)]",
  "light:bg-[rgb(139_92_246/8%)] light:text-[rgb(109_40_217)]",
].join(" ");

/* ── Source Handle (우측 연결 버튼) ──
 * 크롬·호버 SSOT 였던 `nodeSideHandleChrome` 의 `.shellTransition` · `.interactive` ·
 * `.toneImage` 를 함께 인라인한다.
 * 툴팁은 위치만 — surface/motion 은 globals `[data-tooltip]` SSOT
 * (노드 우측 소스 핸들이라 툴팁은 버튼의 바깥=우측으로). */
const SOURCE_HANDLE = [
  "absolute! top-[50%]! left-[var(--node-handle-outbound-slot)]!",
  "w-[var(--node-side-handle-size)]! h-[var(--node-side-handle-size)]!",
  "min-w-[var(--node-side-handle-size)]! min-h-[var(--node-side-handle-size)]!",
  "rounded-[var(--node-side-handle-radius)]! [border:none]! cursor-pointer!",
  "[transform:translateY(-50%)]!",
  "flex! items-center! justify-center!",
  /* `.toneImage` — 채색은 facet 으로 이전, shell 은 투명 */
  "[background:transparent]!",
  /* `.shellTransition` */
  "[transition:filter_0.13s_ease,color_0.13s_ease,border-color_0.13s_ease]",
  /* `.interactive` — 디스크(facet) 전체 스케일. 자식은 facet 하나뿐이라 `> *` 로 집는다.
     원본에서 active 규칙이 hover 보다 특이도가 높아 항상 이겼으므로 `!` 로 고정한다. */
  "[&:hover>*]:[transform:scale(1.08)]",
  "[&:active>*]:[transform:scale(0.94)]!",
  /* 채색 활성 shell: 디스크에 filter(brightness)가 보이도록 shell 에 적용 */
  "[&:hover]:[filter:brightness(1.1)]",
  "[&:active]:[filter:brightness(0.94)]!",
  "[&[data-tooltip]:not([data-tooltip=''])::after]:left-[calc(100%_+_9px)]",
].join(" ");

/* 「다음 단계」 안내가 떠 있는 동안 이 출력점만 깜빡인다 — 영상 노드의 `EDIT_OUT_HANDLE_HINT_PULSE` 와 같은 동작이고,
   동작 줄이기면 깜빡임만 끈다(안내는 남는다). */
const SOURCE_HANDLE_HINT_PULSE =
  "motion-safe:animate-[connectHintHandlePulse_1.6s_ease-in-out_infinite]";

/* 디스크(아이콘+채널 배경) — 항상 셀 꽉 채움, 포인터는 shell 이 받음.
 * `::before` 는 Figma 이너 섀도(X/Y 0 · Blur 8 · Spread 0 · gray-000 100% · Overlay 블렌드)
 * 근사 레이어 (::before 가 배경 아래·아이콘 아래 페인팅 순서).
 * 배경·글자색은 `.toneImage > .facet` 의 승자 선언만 남긴다. */
const SIDE_HANDLE_FACET = [
  "inline-flex items-center justify-center box-border w-full h-full",
  "rounded-[inherit] pointer-events-none",
  "[transform:scale(1)] [transition:transform_0.1s_ease]",
  "relative isolate overflow-hidden",
  "[background:var(--node-handle-icon-image)]!",
  "text-[rgb(var(--palette-gray-000-rgb)/100%)]!",
  "[&::before]:[content:'']",
  "[&::before]:absolute [&::before]:inset-0 [&::before]:rounded-[inherit]",
  "[&::before]:pointer-events-none",
  "[&::before]:[box-shadow:inset_0_0_8px_0_rgb(var(--palette-gray-000-rgb)/100%)]",
  "[&::before]:[mix-blend-mode:overlay]",
  "[&::before]:[transform:translateZ(0)]",
].join(" ");

/* ── Image Area ──
 * 상단 코너는 원본 `.nodeMainMediaBand .imageArea` — 이 파일에서 imageArea 는 항상
 * 미디어 밴드 안이라 조합이 언제나 성립한다. */
const IMAGE_AREA = [
  "w-full bg-transparent flex items-center justify-center",
  "relative overflow-hidden",
  "rounded-t-[var(--node-inner-radius)]",
].join(" ");

/* 비율 변화 트랜지션 — 결과 프레임(`IMAGE_AREA_MEDIA_FRAMED`)의 `transition: none` 과
   같은 프로퍼티를 다투므로 상호배타 분기로 갈라 둔다. */
const IMAGE_AREA_ASPECT_TRANSITION = [
  "[transition:aspect-ratio_0.42s_cubic-bezier(0.33,1,0.68,1)]",
  "motion-reduce:[transition:none]",
].join(" ");

/* 결과 이미지(업로드·생성 공통): `imageFrameAspect` 프레임 + contain 대신 가로 채운 cover */
const IMAGE_AREA_MEDIA_FRAMED = "max-h-[2000px] min-h-0 [transition:none]";

/* 하단 코너: 임베드에서 카드 하단까지 미디어만 노출될 때만 적용. 본앱에서는 메타 툴바와 맞닿도록 미적용. */
const IMAGE_AREA_CARD_BOTTOM_ROUND = "rounded-b-[var(--node-inner-radius)]";

/* 생성 중에도 미디어 영역의 코너 곡률은 카드 내부 곡률(`--node-inner-radius`)을 그대로 따른다.
   (상단은 `IMAGE_AREA` 가 이미 같은 값을 주고, 하단은 위 상수가 준다 — 원본과 결과가 같다) */
const IMAGE_AREA_GENERATING = "rounded-t-[var(--node-inner-radius)]";

/* `.imageAreaMediaFramed .imageEl` 조합은 결과 이미지가 있을 때만 렌더되므로
   기본 `.imageEl` 과 합쳐 승자만 남긴다. */
const IMAGE_EL = "w-full h-full max-w-none max-h-none object-cover block";

const IMAGE_PLACEHOLDER = [
  "flex flex-col items-center justify-center gap-2",
  "opacity-[0.28] pointer-events-none",
].join(" ");

const IMAGE_PLACEHOLDER_ICON = [
  "inline-flex items-center justify-center w-32 h-32",
  "text-[rgb(var(--palette-gray-000-rgb)/100%)]",
  "light:text-[rgb(0_0_0/100%)]",
].join(" ");

const IMAGE_PLACEHOLDER_LABEL = [
  "text-[rgb(var(--palette-gray-000-rgb)/100%)]",
  "light:text-[rgb(0_0_0/100%)]",
].join(" ");

/* ── 생성 중 placeholder (`NodeGeneratingShimmer` SSOT 이식) ──
 * `.mediaRootTranslucentInner` 는 호환용 별칭 — 베일/카드 레벨 파티클이 사라진 뒤로
 * `border-radius: inherit` 만 다르고 나머지는 `.mediaRoot` 와 같다(같은 요소에 둘 다
 * 붙으므로 radius 는 inherit 이 승자). */
const MEDIA_ROOT = [
  "relative flex flex-col items-center justify-center gap-2",
  "w-full h-full min-h-60 overflow-hidden pointer-events-none",
  "rounded-[inherit] bg-transparent",
].join(" ");

/* 아이콘 — idle → generating 전환 시 grow-in(1회) 뒤로는 크기가 변하지 않고, 글자와 같은
   빛줄기(`NodeGeneratingIconSheen`)가 위로 지나간다.
   매체별 accent(`.mediaIconImage`)는 `.mediaIcon` 의 gray-000 을 덮는다(원본 순서와 동일). */
const MEDIA_ICON_IMAGE = [
  "relative z-[1] isolate inline-flex items-center justify-center",
  "w-32 h-32",
  "text-[var(--accent-green-500)]",
  "[filter:none] [transform-origin:center_center] [will-change:transform,opacity]",
  "animate-[media-icon-grow-in_320ms_cubic-bezier(0.22,1,0.36,1)_both]",
  "motion-reduce:animate-none",
  "[&>svg]:w-full [&>svg]:h-full [&>svg]:block",
].join(" ");

/* 라벨 — 인접 아이콘(`.mediaIconImage ~ .mediaCaption`, 특이도 0,2,0)이 색을 정한다.
   그 형제 셀렉터가 자체 `.generatingLabel{color}`(gray-000 56% / 라이트 0 0 0 48%)와
   `.mediaCaptionFade{color:transparent}`(둘 다 0,1,0)를 항상 이겼으므로 accent-mint 승자만 남긴다.
   `--caption-tone` 은 쉬머 그라디언트가 참조하는 보존 변수 — `color` 가 텍스트 클립용으로
   transparent 될 수 있어 currentColor 대신 별도 커스텀 프로퍼티로 둔다.
   라이트: 밝은 100 셰이드는 밝은 카드 표면에서 대비가 약해 700 셰이드로 낮춘다.
   `key={label}` remount 시 fade-in + 대각선 하이라이트 스윕을 텍스트에 얹는다. 스윕의 그림은
   `NODE_GENERATING_CAPTION_SHIMMER` 가 갖고(감속 모션에서 되돌리는 것까지), 여기는 흐르게만 한다. */
const MEDIA_CAPTION_IMAGE = [
  "relative z-[1] text-center max-w-[92%] inline-block",
  "text-[var(--accent-green-100)] [--caption-tone:var(--accent-green-100)]",
  "light:text-[var(--accent-green-700)] light:[--caption-tone:var(--accent-green-700)]",
  NODE_GENERATING_CAPTION_SHIMMER,
  "motion-safe:animate-[media-caption-fade-in_320ms_cubic-bezier(0.22,1,0.36,1)_both,media-caption-shimmer-sweep_2s_linear_infinite]",
].join(" ");

/* ── Prompt Area (`NodePromptArea` SSOT 이식) ──
 * 원본 `.promptArea` 등은 `composes: … from "./NodePromptArea.module.css"` 순수 별칭이었다
 * — 원본 정의를 그대로 옮긴다(라이트 오버라이드·scrollbar/placeholder/focus 포함). */
const PROMPT_AREA = [
  "relative flex flex-col items-stretch gap-4",
  "p-[var(--node-inner-padding,8px)] bg-transparent",
].join(" ");

const PROMPT_AREA_CARD_BOTTOM_ROUND = "rounded-b-[var(--node-inner-radius)]";

/* 기존 텍스트 노드의 생성 버튼 인셋과 호환한다(`--node-prompt-gen-btn-w`). */
const PROMPT_COMPOSER = [
  "relative w-full flex flex-col items-stretch min-w-0",
  "[--node-prompt-gen-btn-w:48px]",
].join(" ");

/* 메타 툴바가 흐름에 들어오면 composer 자체 하단 패딩은 없앤다(원본도 0 = 기본값).
   원본 `.promptComposerWithMetaFooter .promptSubmitFab{bottom}` 은
   `.promptFooterGenerate button{bottom:auto !important}` 에 이미 지고 있던 죽은 선언이라 옮기지 않는다. */
const PROMPT_COMPOSER_WITH_META_FOOTER = "pb-0";

/* 둥근 인풋 셸 — 비디오 에디터와 동일한 테마별 글래스 섀도우 프레임 (다크/라이트 자동 전환).
   원본 `.promptFieldShellFootTray`(padding-bottom) 는 기본 셸과 같은 값이라 no-op 로 합쳤다.
   `min-height` 만 분기가 실제로 갈리므로 아래 두 상수로 상호배타 처리한다. */
const PROMPT_FIELD_SHELL = [
  "relative flex flex-col box-border w-full min-w-0",
  "pt-[var(--node-inner-padding,8px)] pr-[var(--node-inner-padding,8px)]",
  "pb-[var(--node-inner-padding,8px)] pl-[var(--node-inner-padding,8px)]",
  "rounded-[var(--node-input-radius,16px)]",
  "[box-shadow:var(--louis-hairline-inset)]",
  /* 카드(NODE_WRAP)보다 «한 칸 위». 카드가 pg-800 → pg-900 으로 내려가서 이 셸도 같이
     내렸다 — 계약은 pg-800 이라는 값이 아니라 카드와의 한 칸 차이다(불투명이라 카드를
     저절로 따라가지 못한다). 라이트는 카드 pg-000 위 흰색으로 한 칸(2026-10-01 카드와 함께 pg-000 에서 올렸다). */
  "bg-[var(--palette-gray-800)]",
  /* 예전 `backdrop-filter: blur(--louis-blur-panel) saturate(120%)` 는 보이지 않는 효과라 뺐다.
     면이 두 테마 모두 불투명이다 — pg-800 `color(srgb … / 1)` · pg-000 `color(srgb … / 1)`
     (`@klipse-design/css` tokens.css, `:root` 한 곳에서만 선언되고 테마 블록이 덮지 않는다). 불투명 면
     아래를 흐리게 해도 면이 전부 가리므로, 남는 것은 GPU 합성 레이어와 흐림 계산 비용뿐이었다.
     `isolate` 는 backdrop-filter 가 덤으로 만들던 쌓임 맥락을 그대로 남긴다 — 셸 안 드롭다운 앵커
     (`z-[100]`)가 셸 밖 형제와 z 를 겨루기 시작하면 겹침 순서가 바뀔 수 있다. 셸은 이미 `relative`
     라 absolute 자손의 기준도 그대로다(fixed 자손은 없다 — 툴팁은 body 포털). */
  "isolate",
  "light:bg-[var(--palette-white)]",
].join(" ");

const PROMPT_FIELD_SHELL_MIN_H = "min-h-70 h-auto";

/* 참조 미디어가 셸 안에 오면 최소 높이 해제 (원본에서 메타 푸터 규칙보다 뒤라 이겼다) */
