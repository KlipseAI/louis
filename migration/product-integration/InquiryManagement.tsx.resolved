"use client";

import { AdminSearch } from "./AdminSearch";
import { useAdminMessages, formatAdminMessage, formatAdminTimeAgo } from "./useAdminMessages";
import { useAdminViewState } from "./useAdminViewState";

import { useState, useEffect, useCallback, useRef, useId } from "react";

import { Button } from "../../components/ui/Button";
import InlineLoadingLabel from "../../components/ui/InlineLoadingLabel";
import { useDialogFocus } from "../../components/ui/useDialogFocus";

import {
  ADMIN_MODAL_SURFACE,
  AdminToolbar,
  AdminSegmented,
  AdminAlert,
  AdminBadge,
  AdminLines,
  AdminRefreshButton,
  AdminSectionHeader,
  AdminState,
  AdminLoadError,
  type AdminBadgeTone,
  AdminOpenUserButton,
} from "./AdminSection";

type Inquiry = {
  id: string;
  user_id: string | null;
  email: string;
  category: string;
  title: string;
  description: string;
  image_urls: string[];
  created_at: string;
  /** null 이면 미해결. 해결 처리는 삭제가 아니라 이 값을 세우는 것이다. */
  resolved_at: string | null;
};

type InquiryView = "open" | "resolved";

/* ── 스타일 ────────────────────────────────────────────────────────────────────
 * 이전 `app/admin/page.module.css` 에서 이 파일이 쓰던 클래스만 유틸리티로 옮긴 것.
 * 모듈 파일 자체는 어드민의 다른 소비자가 아직 쓰므로 남는다(인라인 전개).
 *
 * 라이트 오버라이드 셀렉터는 랜딩 킬스위치가 아니라 평범한 후손
 * `html[data-theme="light"] .foo` 라서 `[html[data-theme=light]_&]:` 임의 변형으로 옮긴다
 * (`light:` 가 아니다). 원본 `:hover` 에는 `@media (hover: hover)` 가드가 없어
 * `hover:` 대신 `[&:hover]:` 를 쓴다.
 *
 * 레이어 밖 전역과 다투는 선언(중요 선언으로 승자 고정):
 *  · `.inquiryDescription` 의 `line-height` 는 같은 요소에 붙은 전역 `type-*` 클래스
 *    (레이어 밖)와 같은 프로퍼티를 다툰다. 값 자체는 같다.
 *  · 첨부 링크의 `<a>` 는 전역이 색·밑줄만 잡는데 원본이 그 둘을 건드리지 않아 충돌 없음.
 *  · 스크롤바·툴팁·셰브런 마커 전역은 이 파일이 해당 의사요소/속성을 쓰지 않아 해당 없음.
 *
 * 헤더·빈 상태·오류·배너·배지, 그리고 **행 표면**은 `./AdminSection` 의 어드민 공용
 * 프리미티브가 소유한다. 행이 `ADMIN_SURFACE` 를 쓰는 이유: 원본의 라이트 채움
 * (`--palette-gray-100`)이 어드민 카드 바닥 `.appMainCardChrome`(globals.css)과 **같은 색**
 * 이고 그림자마저 `[box-shadow:none]` 으로 꺼져 있어, 라이트에서는 행 경계가 통째로
 * 사라져 있었다. `bg-raised` 는 두 테마 모두에서 바닥보다 밝은 유일한 단이다.
 * 카드 면이 불투명해지면서 원본의 backdrop-filter 는 아무것도 하지 않으므로 함께 지운다.
 *
 * `@keyframes fadeIn` · `scaleIn` 은 저장소에 같은 이름이 서로 다른 본문으로 여럿 있어
 * `adminFadeIn` · `adminScaleIn` 으로 이름을 붙여 `app/keyframes.css` 에 올린다.
 */

const INQUIRY_LIST = "flex flex-col [border-top:var(--louis-border-width-hairline)_solid_var(--louis-color-stroke-hairline)]";

/* 펼친 행도 면을 올리지 않는다. 예전의 펼침 면(`bg-raised`)은 라이트에서만 흰 면이 서고 다크에서는
   카드와 같은 값(pg-900)이라 테마마다 모양이 갈렸다. 펼친 내용은 위아래 헤어라인과 자기 위 선
   (`INQUIRY_DETAIL`)이 묶는다. */
const INQUIRY_CARD = "overflow-hidden [border-bottom:var(--louis-border-width-hairline)_solid_var(--louis-color-stroke-hairline)]";

/* 원본은 `onClick` 이 달린 `<div>` 였다 — 키보드로 열 수 없었다.
   `<button>` 으로 바꾸면서 네이티브 버튼 면(제품 리셋이 지우지 않는다)과 가운데 정렬을
   끈다. 호버 델타는 4% → 8% — 4% 는 원본 카드 채움과 같은 값이라 호버가 보이지 않았다. */
const INQUIRY_CARD_HEADER = [
  "w-full text-left bg-transparent",
  "flex flex-col gap-4 px-10 py-7 cursor-pointer",
  "[transition:background_150ms]",
  "[&:hover]:bg-[rgb(var(--gray-000-rgb)/8%)]",
  "[html[data-theme=light]_&:hover]:bg-palette-gray-100",
].join(" ");

/* 세 상수는 `<button>` 안에 서므로 요소가 `<span>` 이다(버튼의 내용 모델은 phrasing
   content). `flex` 는 표시 타입만 바꾸므로 동작은 같다. */
const INQUIRY_CARD_TOP = "flex items-center justify-between gap-6";

const INQUIRY_CARD_BOTTOM = "flex items-center gap-6";

/* 제목이 두 줄이 되면 분류 알약은 첫 줄에 맞춘다(좁은 폭). */
const INQUIRY_META = "flex items-center max-sm:items-start gap-5 min-w-0";

/* 문의는 읽어야 하는 글이라 두 줄까지 보인다. 예전에는 한 줄에서 잘려 390 폭에서는 제목 반이 사라졌다. */
const INQUIRY_TITLE = [
  "text-gray-000 min-w-0 line-clamp-2 [overflow-wrap:anywhere]",
  "[html[data-theme=light]_&]:text-palette-gray-900",
].join(" ");

const CHEVRON = [
  "shrink-0 text-[rgb(var(--gray-000-rgb)/24%)]",
  "[transition:transform_200ms]",
  "[html[data-theme=light]_&]:text-palette-gray-600",
].join(" ");

const CHEVRON_OPEN = "[transform:rotate(180deg)]";

/* 카드의 `overflow-hidden` 이 긴 주소를 말줄임 없이 잘라내던 자리 — 이메일이 줄고,
   시각이 밀려나지 않는다. */
const INQUIRY_EMAIL = [
  "min-w-0 truncate",
  "text-[rgb(var(--gray-000-rgb)/40%)]",
  "[html[data-theme=light]_&]:text-palette-gray-500",
].join(" ");

const INQUIRY_DATE = [
  "shrink-0",
  "text-[rgb(var(--gray-000-rgb)/28%)]",
  "[html[data-theme=light]_&]:text-palette-gray-600",
].join(" ");

/** 원본 CSS 에 톤 규칙이 있는 카테고리만. 그 외(`other` 포함)는 중립 배지다.
 *  기하·면·글자색은 `AdminBadge`(LOUIS `.louis-badge`)가 갖는다 — 원본의 계정 톤은
 *  이 저장소가 지운 Tailwind 기본 팔레트를 리터럴(`rgb(96,165,250)`)로 적고 있었다. */
const CATEGORY_TONES: Record<string, AdminBadgeTone> = {
  bug: "danger",
  payment: "success",
  account: "info",
};

/* 펼친 상세와 위 행을 가르는 구분선 — 0.5px × `--louis-color-stroke-hairline`.
   그 토큰이 라이트 잉크 12% · 다크 흰색 8% 로 뒤집히므로 라이트 전용 덮어쓰기가 없다. */
const INQUIRY_DETAIL = [
  "pt-0 px-10 pb-8 flex flex-col gap-6",
  "[border-top:var(--louis-border-width-hairline)_solid_var(--louis-color-stroke-hairline)]",
].join(" ");

/* `line-height` 는 같은 요소의 전역 `type-body-14-regular`(레이어 밖)과 다투므로 중요 선언. */
const INQUIRY_DESCRIPTION = [
  "text-[rgb(var(--gray-000-rgb)/72%)]",
  "[line-height:var(--type-body-16-line-height)]!",
  "whitespace-pre-wrap pt-6",
  "[html[data-theme=light]_&]:text-palette-gray-700",
].join(" ");

/* 개수 라벨은 격자의 형제가 아니라 **위에 서는 라벨**이다. 원본에서는 마지막 flex 자식이라
   120px 썸네일 바닥에 붙어 매달려 있었다. */
const INQUIRY_IMAGES = "flex flex-col gap-4";

const INQUIRY_IMAGE_GRID = "flex flex-wrap gap-4";

const INQUIRY_IMAGE_LINK = "block w-fit";

const INQUIRY_IMAGE = [
  "w-60 h-60 object-cover rounded-12",
  "[border:1px_solid_rgb(var(--gray-000-rgb)/8%)]",
  "cursor-pointer [transition:opacity_150ms]",
  "[&:hover]:opacity-[0.85]",
  "[html[data-theme=light]_&]:[border-color:var(--palette-gray-300)]",
].join(" ");

const INQUIRY_IMAGE_LABEL = [
  "type-caption-12-medium",
  "text-[rgb(var(--gray-000-rgb)/56%)]",
  "[html[data-theme=light]_&]:text-palette-gray-600",
].join(" ");

const INQUIRY_ACTIONS = "flex justify-end gap-4 pt-2";

/* 가림막은 다른 편집 창(`AdminEditorDialog` 의 `.louis-dialog__backdrop`, `CaptionTemplateManagement`)
   과 같은 LOUIS 토큰이다. 예전 값(pg-900 48%, 두 테마 같음)은 다크에서 카드와 같은 색이라 뒤가
   어두워지지 않았다(LOUIS DS-D-0072). */
const MODAL_OVERLAY = [
  "fixed inset-0 z-[1400] flex items-center justify-center",
  "bg-[var(--louis-color-dim-modal)]",
  "animate-[adminFadeIn_200ms_ease_forwards]",
].join(" ");

const MODAL_CARD = [
  "w-[min(380px,calc(100vw_-_40px))] p-12 rounded-20",
  ADMIN_MODAL_SURFACE,
  "[box-shadow:var(--louis-hairline-inset)]",
  "animate-[adminScaleIn_200ms_ease_forwards]",
].join(" ");

const MODAL_TITLE = "text-gray-000 mb-10";

const MODAL_BODY = "flex flex-col gap-8 mb-12";

/* LOUIS `.louis-dialog__actions` 와 같은 기하 — 오른쪽 정렬 + 내용 크기 버튼.
   `flex-1` 로 늘리면 「취소」와 영구 삭제가 같은 크기·같은 모양의 판이 되어, 어느 쪽이
   파괴적인지 기하가 말해 주지 않는다. 강조는 폭이 아니라 variant 가 진다. */
const MODAL_ACTIONS = "flex justify-end gap-4";

export default function InquiryManagement({
  onCountChange,
  initialQuery,
}: {
  onCountChange?: (count: number) => void;
  /** 사용자 상세의 「고객 문의」 버튼이 넘긴 이메일. 검색칸을 채운 채로 연다(주소에는 남기지 않는다). */
  initialQuery?: string;
}) {
  const copy = useAdminMessages();
  const categoryLabels: Record<string, string> = copy.inquiries.categories;
  const [query, setQuery] = useAdminViewState("inquiries.query", "", initialQuery);
  const [inquiries, setInquiries] = useState<Inquiry[]>([]);
  /* 마지막으로 받아 온 탭. 탭을 바꾼 조회가 실패하면 앞 탭의 목록이 새 탭의 것처럼 남지 않게 비운다. */
  const loadedViewRef = useRef<InquiryView | null>(null);
  const [loading, setLoading] = useState(true);
  const [message, setMessage] = useState<{
    type: "success" | "error";
    text: string;
  } | null>(null);
  const [expandedId, setExpandedId] = useAdminViewState<string | null>("inquiries.expanded", null);
  const [confirmResolveId, setConfirmResolveId] = useState<string | null>(null);
  const [processing, setProcessing] = useState(false);
  const [view, setView] = useAdminViewState<InquiryView>("inquiries.view", "open");
  /* 해결 확인 창의 키보드는 `useDialogFocus` 가 갖는다. 가두지 않던 때는 창이 열린 채로 Tab 이 뒤의 목록에 닿아,
     다른 문의를 펼쳐 「해결로 표시」를 누르면 같은 창이 말없이 그 문의를 가리켰다. */
  const resolveDialogRef = useRef<HTMLDivElement>(null);
  const resolveTitleId = useId();
  useDialogFocus(confirmResolveId !== null, resolveDialogRef, { onEscape: () => setConfirmResolveId(null) });

  const fetchInquiries = useCallback(async () => {
    setLoading(true);
    /* 성공 분기에만 자동 해제 타이머가 있어(아래) 오류 배너는 스스로 사라지지 않았다.
       새 요청이 시작되면 직전 결과는 더 이상 참이 아니므로 여기서 지운다. */
    setMessage(null);
    try {
      const res = await fetch(
        view === "resolved"
          ? "/api/admin/inquiries?resolved=1"
          : "/api/admin/inquiries",
      );
      const json = await res.json();
      if (json.ok) {
        setInquiries(json.data);
        loadedViewRef.current = view;
        /* 배지는 「조치가 남은 건수」다 — 해결 완료 목록을 보는 동안에는 건드리지 않는다. */
        if (view === "open") onCountChange?.(json.data.length);
      } else {
        setMessage({ type: "error", text: json.error || copy.common.loadError });
        if (loadedViewRef.current !== view) setInquiries([]);
      }
    } catch {
      setMessage({ type: "error", text: copy.common.networkError });
      if (loadedViewRef.current !== view) setInquiries([]);
    } finally {
      setLoading(false);
    }
  }, [copy, onCountChange, view]);

  useEffect(() => {
    fetchInquiries();
  }, [fetchInquiries]);

  /* 해결/되돌리기 모두 같은 상태 변경이다 — 목록에서 빠지는 방향만 반대다. */
  const handleUpdateStatus = async (
    id: string,
    action: "resolve" | "reopen",
  ) => {
    setProcessing(true);
    try {
      const res = await fetch(`/api/admin/inquiries/${id}`, {
        method: "PATCH",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ action }),
      });
      const json = await res.json();
      if (json.ok) {
        setMessage({
          type: "success",
          text:
            action === "resolve"
              ? copy.inquiries.resolvedToast
              : copy.inquiries.reopenedToast,
        });
        const next = inquiries.filter((inq) => inq.id !== id);
        setInquiries(next);
        if (view === "open") onCountChange?.(next.length);
        setExpandedId(null);
        setTimeout(() => setMessage(null), 2400);
      } else {
        setMessage({ type: "error", text: json.error || copy.inquiries.updateError });
      }
    } catch {
      setMessage({ type: "error", text: copy.common.networkError });
    } finally {
      setProcessing(false);
      setConfirmResolveId(null);
    }
  };

  /* 실패한 요청이 「문의가 없습니다」로 읽히던 자리 — 빈 목록은 조회가 성공했을 때만
     빈 상태로 그린다. 새 상태는 만들지 않고 기존 `message` 에서 파생한다. */
  const errorText = message?.type === "error" ? message.text : null;
  const showErrorState = !loading && errorText !== null && inquiries.length === 0;

  const filteredInquiries = inquiries.filter((inquiry) =>
    `${inquiry.title} ${inquiry.email} ${inquiry.description}`.toLocaleLowerCase().includes(query.trim().toLocaleLowerCase()),
  );

  return (
    /* 블록 사이 16px 은 예전에 부모(`AdminClient` 의 CONTENT_PANEL) gap-8 이 내주고 있었다.
       그 gap 이 상단 크롬 바 슬롯의 여백으로 옮겨 가면서, 자기 리듬은 자기가 갖는다 —
       다른 탭들(쿠폰·성과 지표·블로그 …)과 같은 형태다. */
    <div className="flex flex-col gap-8">
      <AdminSectionHeader
        level="page"
        title={copy.nav.inquiries}
        meta={loading || showErrorState ? undefined : formatAdminMessage(copy.common.resultCount, { count: filteredInquiries.length })}
        inlineActions
        actions={<AdminRefreshButton label={copy.common.refresh} onClick={fetchInquiries} busy={loading} />}
      />

      <AdminToolbar>
        <AdminSegmented size="lg" label={copy.common.status} value={view} onChange={setView} disabled={loading} options={[
          { key: "open", label: copy.common.openInquiries }, { key: "resolved", label: copy.common.resolvedInquiries },
        ]} />
        <AdminSearch value={query} onChange={setQuery} label={copy.inquiries.search} />
      </AdminToolbar>

      {message && !showErrorState && (
        <AdminAlert tone={message.type === "success" ? "success" : "danger"}>
          {message.text}
        </AdminAlert>
      )}

      {!loading && !showErrorState && inquiries.length > 0 && filteredInquiries.length === 0 && <AdminState kind="empty" title={copy.common.noResults}
        action={<Button variant="secondary" onClick={() => setQuery("")}>{copy.common.clearFilters}</Button>} />}
      {loading ? (
        <AdminState kind="loading" title={copy.inquiries.loading} />
      ) : showErrorState ? (
        <AdminLoadError
          title={copy.inquiries.loadFailed}
          /* 제목이 이미 「불러오지 못했습니다」라고 말한다 — 서버가 준 사유가 있을 때만 붙인다. */
          reason={errorText === copy.common.loadError ? undefined : errorText}
          onRetry={fetchInquiries}
        />
      ) : inquiries.length === 0 ? (
        <AdminState
          kind="empty"
          title={view === "resolved" ? copy.inquiries.noneResolved : copy.inquiries.noneOpen}
        />
      ) : (
        <div className={INQUIRY_LIST}>
          {filteredInquiries.map((inq) => {
            const isExpanded = expandedId === inq.id;
            return (
              <div
                key={inq.id}
                className={INQUIRY_CARD}
              >
                <button
                  type="button"
                  className={INQUIRY_CARD_HEADER}
                  aria-expanded={isExpanded}
                  aria-controls={`inquiry-detail-${inq.id}`}
                  onClick={() =>
                    setExpandedId(isExpanded ? null : inq.id)
                  }
                >
                  <span className={INQUIRY_CARD_TOP}>
                    <span className={INQUIRY_META}>
                      <AdminBadge tone={CATEGORY_TONES[inq.category] ?? "neutral"}>
                        {categoryLabels[inq.category] ?? inq.category}
                      </AdminBadge>
                      <span
                        className={`${INQUIRY_TITLE} type-body-14-medium`}
                      >
                        {inq.title}
                      </span>
                    </span>
                    <svg
                      className={`${CHEVRON} ${isExpanded ? CHEVRON_OPEN : ""}`}
                      width="16"
                      height="16"
                      viewBox="0 0 16 16"
                      fill="none"
                    >
                      <path
                        d="M4 6l4 4 4-4"
                        stroke="currentColor"
                        strokeWidth="1.5"
                        strokeLinecap="round"
                        strokeLinejoin="round"
                      />
                    </svg>
                  </span>
                  <span className={INQUIRY_CARD_BOTTOM}>
                    <span
                      className={`${INQUIRY_EMAIL} type-caption-12-regular`}
                    >
                      {inq.email}
                    </span>
                    <span
                      className={`${INQUIRY_DATE} type-caption-12-regular`}
                    >
                      {formatAdminTimeAgo(inq.created_at, copy, 7)}
                    </span>
                  </span>
                </button>

                {isExpanded && (
                  <div
                    className={INQUIRY_DETAIL}
                    id={`inquiry-detail-${inq.id}`}
                  >
                    <p
                      className={`${INQUIRY_DESCRIPTION} type-body-14-regular`}
                    >
                      {inq.description}
                    </p>
                    {inq.image_urls.length > 0 && (
                      <div className={INQUIRY_IMAGES}>
                        <span className={INQUIRY_IMAGE_LABEL}>
                          {formatAdminMessage(copy.inquiries.attachments, { count: inq.image_urls.length })}
                        </span>
                        <div className={INQUIRY_IMAGE_GRID}>
                          {inq.image_urls.map((url, i) => (
                            <a
                              key={i}
                              href={url}
                              target="_blank"
                              rel="noopener noreferrer"
                              className={INQUIRY_IMAGE_LINK}
                            >
                              <img
                                src={url}
                                alt={formatAdminMessage(copy.inquiries.attachmentAlt, { index: i + 1 })}
                                className={INQUIRY_IMAGE}
                              />
                            </a>
                          ))}
                        </div>
                      </div>
                    )}
                    <div className={INQUIRY_ACTIONS}>
                      <AdminOpenUserButton email={inq.email} />
                      {view === "resolved" ? (
                        /* 되돌리기는 잃는 것이 없으므로 확인 모달을 세우지 않는다. */
                        <Button
                          variant="secondary"
                          onClick={() => handleUpdateStatus(inq.id, "reopen")}
                          disabled={processing}
                        >
                          {copy.inquiries.reopen}
                        </Button>
                      ) : (
                        <Button
                          variant="inverse"
                          onClick={() => setConfirmResolveId(inq.id)}
                          disabled={processing}
                        >
                          {copy.inquiries.resolve}
                        </Button>
                      )}
                    </div>
                  </div>
                )}
              </div>
            );
          })}
        </div>
      )}

      {/* Confirm resolve modal */}
      {confirmResolveId && (
        <div
          className={MODAL_OVERLAY}
          onClick={() => setConfirmResolveId(null)}
        >
          <div
            ref={resolveDialogRef}
            className={MODAL_CARD}
            role="dialog"
            aria-modal="true"
            aria-labelledby={resolveTitleId}
            onClick={(e) => e.stopPropagation()}
          >
            <h2 id={resolveTitleId} className={`${MODAL_TITLE} type-body-16-semibold`}>
              {copy.inquiries.resolveTitle}
            </h2>
            <div className={MODAL_BODY}>
              <p className="type-body-14-regular">
                <AdminLines lines={copy.inquiries.resolveDescription} />
              </p>
            </div>
            <div className={MODAL_ACTIONS}>
              <Button
                variant="secondary"
                onClick={() => setConfirmResolveId(null)}
              >
                {copy.common.cancel}
              </Button>
              <Button
                variant="inverse"
                onClick={() => handleUpdateStatus(confirmResolveId, "resolve")}
                disabled={processing}
              >
                <InlineLoadingLabel
                  loading={processing}
                  idleLabel={copy.inquiries.resolve}
                  loadingLabel={copy.common.processing}
                />
              </Button>
            </div>
          </div>
        </div>
      )}
    </div>
  );
}
