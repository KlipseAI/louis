"use client";

import { useAdminMessages, formatAdminMessage, formatAdminLines } from "./useAdminMessages";
import { AdminEditorDialog } from "./AdminEditorDialog";
import { useDirtySinceOpen, useUnsavedGuard } from "./useUnsavedGuard";
import InlineLoadingLabel from "@/components/ui/InlineLoadingLabel";

import { Fragment, useCallback, useEffect, useMemo, useRef, useState } from "react";
import { Button } from "../../components/ui/Button";
import MediaCard from "@/components/landing/system/MediaCard";
import {
  MODEL_LOGO_ACCEPT,
  MODEL_MEDIA_ACCEPT,
  modelUploadMaxBytes,
  type ModelBadge,
  type ModelMediaType,
  type ModelUploadKind,
} from "@/app/lib/models/media";
import { type VideoPlayback } from "@/app/lib/media/videoPlayback";
import {
  BADGE_ACTIVE,
  DRAG_GHOST,
  DRAG_HANDLE,
  DRAG_HANDLE_ICON,
  FIELD_LABEL,
  FORM_BOX,
  FORM_ERROR,
  FORM_GROUP,
  FORM_HINT,
  FORM_INPUT,
  FORM_TEXTAREA,
  FORM_TEXTAREA_BOX,
  INSERTION_LINE,
  ITEM,
  ITEM_DESC,
  ITEM_INFO,
  ITEM_PLACEHOLDER,
  ITEM_TITLE,
  LIST,
  LIST_DRAGGING,
  SECTION,
  THUMB,
} from "./contentListStyles";
import { AdminSelect, AdminAlert, AdminActionFailureAlert, AdminState, AdminLoadError, AdminSectionHeader, AdminLines, AdminMoreMenu, AdminFilePicker, isRowClickIgnored, type AdminActionFailure, AdminStatus, AdminSegmented } from "./AdminSection";
import { useDragReorder } from "./useDragReorder";
import { type CustomDropdownOption } from "@/components/scenes/create/CustomDropdown";
import { useConfirmDialog } from "@/components/ui/useConfirmDialog";

/**
 * 「최신 AI 모델」 카드 관리 (KLI-230).
 *
 * 카드 9장이 `ModelCarousel.tsx` 에 하드코딩돼 있던 것을 DB 로 옮기고, 여기서 관리한다.
 * 목록·폼의 조형과 드래그 순서변경은 배너와 공용이다(`contentListStyles`·`useDragReorder`).
 */

interface Model {
  id: string;
  name: string;
  description: string | null;
  description_en: string | null;
  description_ja: string | null;
  media_url: string | null;
  media_type: ModelMediaType;
  video_playback: VideoPlayback;
  logo_url: string | null;
  /** null 이면 딱지를 그리지 않는다. */
  badge: ModelBadge | null;
  display_order: number;
  is_active: boolean;
}

/* 목록 행 제목 — 누르면 수정이 열린다(행 전체도 같다). 키보드로 열 수 있게 버튼이다.
   글꼴은 함께 걸린 `type-body-14-medium` 이 정한다. 예전의 `[font:inherit]` 는 유틸리티 층이라 그 클래스를
   이겨, 제목이 부모의 16px 보통 굵기로 그려졌다(문의, 블로그, 자막 목록의 14px 과 달랐다). */
const ROW_TITLE = "block max-w-full p-0 m-0 border-0 bg-transparent text-left cursor-pointer rounded-4";
/** 카드 로고는 16px 로 그려진다 — 목록에서도 같은 크기로 보여 준다. */
/* 로고는 홈에서 영상 위 어두운 정보 바에 선다(흰 단색 실루엣). 관리 목록의 밝은 면 위에서는
   흰 로고가 보이지 않아, 홈과 같은 어두운 칸 위에 올려 보여 준다. 다크에서는 칸이 카드와 같아 로고만 보인다.
   편집 창에서는 미리보기 카드가 홈과 같은 자리에 로고를 그린다. */
const LOGO_TILE = "inline-flex items-center justify-center shrink-0 w-12 h-12 rounded-6 bg-palette-gray-900";
const LOGO_CHIP = "w-8 h-8 object-contain";
/* 미디어를 올리기 전의 미리보기 자리 — 홈 카드(`MediaCard` 캐러셀 칸)와 같은 316 정사각이다.
   로고를 먼저 올렸으면 로고를 홈과 같은 어두운 칸 위에 함께 보인다. */
const PREVIEW_EMPTY = [
  "flex flex-col items-center justify-center gap-4 text-center px-8",
  "w-[316px] max-w-full aspect-square rounded-12 text-fg-secondary",
  "[border:var(--louis-border-width-default)_dashed_var(--louis-color-stroke-control)]",
].join(" ");

const BADGE_LABEL: Record<ModelBadge, string> = { new: "New", top: "Top" };



/* 빈 값이 첫 칸인 이유는 딱지 없음이 기본값이기 때문이다. */


const MB = (bytes: number) =>
  bytes >= 1024 * 1024 ? `${Math.round(bytes / (1024 * 1024))}MB` : `${Math.round(bytes / 1024)}KB`;

export default function ModelManagement() {
  const copy = useAdminMessages();
  const BADGE_OPTIONS = [
  { value: "", label: copy.content.none },
  { value: "new", label: "New" },
  { value: "top", label: "Top" },
] satisfies readonly CustomDropdownOption<ModelBadge | "">[];
  const PLAYBACK_OPTIONS = [
  { value: "loop", label: copy.content.loop },
  { value: "once", label: copy.content.once },
  { value: "still", label: copy.content.still },
] satisfies readonly CustomDropdownOption<VideoPlayback>[];
  const [listError, setListError] = useState<string | null>(null);
  /* 숨기기, 삭제, 순서 저장의 실패. 불러오기 실패(`listError`)와 칸을 나눈다 — 다시 시도가 향하는 곳이 다르다. */
  const [actionFailure, setActionFailure] = useState<AdminActionFailure | null>(null);
  const [deleting, setDeleting] = useState(false);
  const { confirm, confirmDialog } = useConfirmDialog();
  const [models, setModels] = useState<Model[]>([]);
  const [loading, setLoading] = useState(true);

  const [editing, setEditing] = useState<Model | null>(null);
  const [formOpen, setFormOpen] = useState(false);
  const [formName, setFormName] = useState("");
  const [formDesc, setFormDesc] = useState("");
  const [formDescEn, setFormDescEn] = useState("");
  const [formDescJa, setFormDescJa] = useState("");
  /* 빈 문자열 = 딱지 없음. 드롭다운 값이 문자열이라 null 을 못 실어서 폼 안에서만 이렇게 표현한다. */
  const [formBadge, setFormBadge] = useState<ModelBadge | "">("");
  const [formPlayback, setFormPlayback] = useState<VideoPlayback>("loop");
  const [formActive, setFormActive] = useState(true);

  /* 업로드는 저장이 아니라 **파일 선택 시점**에 끝난다 — 서명 URL 로 브라우저가 스토리지에
     직접 올리고, 저장 요청에는 그 키만 실어 보낸다. */
  const [formMediaKey, setFormMediaKey] = useState<string | null>(null);
  const [formMediaType, setFormMediaType] = useState<ModelMediaType>("image");
  const [formMediaPreview, setFormMediaPreview] = useState<string | null>(null);
  const [formLogoKey, setFormLogoKey] = useState<string | null>(null);
  const [formLogoPreview, setFormLogoPreview] = useState<string | null>(null);
  /* 이번에 고른 파일 이름 — 파일 선택 옆에 보인다. 저장된 파일은 이름이 무작위 키라 비워 둔다. */
  const [formMediaName, setFormMediaName] = useState<string | null>(null);
  const [formLogoName, setFormLogoName] = useState<string | null>(null);

  const [uploading, setUploading] = useState<ModelUploadKind | null>(null);
  const [formError, setFormError] = useState<string | null>(null);
  const [saving, setSaving] = useState(false);

  /* `URL.createObjectURL` 은 되돌리지 않으면 문서가 살아 있는 동안 원본을 붙잡는다. 이미지에서는
     티가 안 났지만 영상은 수십 MB 라 폼을 몇 번 여닫으면 그대로 쌓인다. */
  const previewUrlsRef = useRef<string[]>([]);
  const modelsRef = useRef(models);
  modelsRef.current = models;

  const fetchModels = useCallback(async () => {
    setLoading(true);
    setListError(null);
    try {
      const res = await fetch("/api/admin/models");
      const json = await res.json();
      if (!res.ok || !json.ok) throw new Error();
      setModels(json.data);
    } catch {
      setListError(copy.common.loadError);
    } finally {
      setLoading(false);
    }
  }, [copy.common.loadError]);

  useEffect(() => {
    fetchModels();
  }, [fetchModels]);

  const sorted = useMemo(
    () => [...models].sort((a, b) => a.display_order - b.display_order),
    [models],
  );
  /* 목록을 한 번도 받지 못했으면 그 자리는 오류가 갖는다. 다시 읽기가 실패한 것은 목록을 남기고 위
     알림으로 알린다. 숨기기, 삭제, 순서 저장의 실패는 이 칸이 아니라 `actionFailure` 가 갖는다. */
  const listFailed = !loading && listError !== null && models.length === 0;
  const modelById = useMemo(() => new Map(sorted.map((m) => [m.id, m])), [sorted]);
  const orderedIds = sorted.map((m) => m.id);

  /* 낙관적으로 먼저 그리고, 하나라도 실패하면 통째로 되돌린다. 중복 실행과 "순서가 그대로면
     저장하지 않는다" 는 훅이 맡는다. */
  const commitReorderIds = useCallback(
    async (nextOrder: string[]) => {
      const orderMap = new Map(nextOrder.map((id, idx) => [id, idx]));
      const previous = modelsRef.current;
      setActionFailure(null);

      setModels((prev) =>
        prev
          .map((m) => (orderMap.has(m.id) ? { ...m, display_order: orderMap.get(m.id)! } : m))
          .sort((a, b) => a.display_order - b.display_order),
      );

      try {
        const results = await Promise.all(
          nextOrder.map((id, idx) =>
            fetch(`/api/admin/models/${id}`, {
              method: "PATCH",
              body: (() => {
                const fd = new FormData();
                fd.append("display_order", String(idx));
                return fd;
              })(),
            }),
          ),
        );
        if (results.some((res) => !res.ok)) throw new Error("reorder failed");
      } catch {
        setModels(previous);
        await fetchModels();
        /* 목록은 저장된 순서로 되돌려 놓았다. 다시 시도할 것이 없어 버튼을 달지 않는다 — 다시 끌면 된다.
           예전에는 이 알림의 다시 시도가 목록만 한 번 더 읽고 알림을 지웠다. */
        setActionFailure({ text: copy.common.reorderError });
      }
    },
    [fetchModels, copy.common.reorderError],
  );

  const {
    listRef,
    previewIds,
    draggingId,
    insertionIndex,
    ghost,
    reordering,
    handlePointerDown,
    moveItem,
  } = useDragReorder({ orderedIds, commit: commitReorderIds });

  const displayIds = previewIds ?? orderedIds;
  const draggingModel = draggingId ? modelById.get(draggingId) ?? null : null;

  const releasePreviews = () => {
    for (const url of previewUrlsRef.current) URL.revokeObjectURL(url);
    previewUrlsRef.current = [];
  };

  const resetForm = (model: Model | null) => {
    releasePreviews();
    setEditing(model);
    setFormName(model?.name ?? "");
    setFormDesc(model?.description ?? "");
    setFormDescEn(model?.description_en ?? "");
    setFormDescJa(model?.description_ja ?? "");
    setFormBadge(model?.badge ?? "");
    setFormPlayback(model?.video_playback ?? "loop");
    setFormActive(model?.is_active ?? true);
    setFormMediaKey(null);
    setFormMediaType(model?.media_type ?? "image");
    setFormMediaPreview(model?.media_url ?? null);
    setFormLogoKey(null);
    setFormLogoPreview(model?.logo_url ?? null);
    setFormMediaName(null);
    setFormLogoName(null);
    setFormError(null);
    setFormOpen(true);
  };

  // 닫기 전 확인: 사람이 고칠 수 있는 값만 비교한다. 미디어와 로고는 새로 올린 키와, 기존 파일을 지웠는지로 본다.
  const modelDirty = useDirtySinceOpen(formOpen ? (editing?.id ?? "new") : null, {
    name: formName,
    desc: formDesc,
    descEn: formDescEn,
    descJa: formDescJa,
    badge: formBadge,
    playback: formPlayback,
    active: formActive,
    media: formMediaKey ?? (formMediaPreview ? "kept" : "none"),
    logo: formLogoKey ?? (formLogoPreview ? "kept" : "none"),
  });
  const requestClose = useUnsavedGuard(modelDirty, confirm);

  const closeForm = () => {
    releasePreviews();
    setFormOpen(false);
    setEditing(null);
  };

  /**
   * 파일을 고르는 즉시 올린다 — 서명 URL 을 받아 브라우저가 스토리지에 직접 PUT 한다.
   * 저장 요청은 파일이 아니라 키만 나른다.
   */
  const handleUpload = async (kind: ModelUploadKind, file: File | null) => {
    if (!file) return;

    const mediaType: ModelMediaType = file.type.startsWith("video/") ? "video" : "image";
    if (file.size > modelUploadMaxBytes(kind, mediaType)) {
      setFormError(formatAdminMessage(copy.content.fileTooLarge, { limit: MB(modelUploadMaxBytes(kind, mediaType)) }));
      return;
    }

    /* 올리기에 실패하면 고르기 전 파일로 되돌린다(배너 편집창과 같다). 예전에는 미리보기만 새 파일로
       남기고 저장을 잠가, 잠금을 풀 길이 없었다. 직전 미리보기 blob 은 창을 닫을 때 한꺼번에
       되돌리므로 여기서 다시 보여 줄 수 있다. */
    const previousMedia = { preview: formMediaPreview, type: formMediaType, key: formMediaKey, name: formMediaName };
    const previousLogo = { preview: formLogoPreview, key: formLogoKey, name: formLogoName };

    /* 미리보기는 업로드 결과를 기다리지 않는다 — 고른 파일을 바로 보여 준다. */
    const objectUrl = URL.createObjectURL(file);
    previewUrlsRef.current.push(objectUrl);
    if (kind === "logo") {
      setFormLogoPreview(objectUrl);
      setFormLogoKey(null);
      setFormLogoName(file.name);
    } else {
      setFormMediaPreview(objectUrl);
      setFormMediaType(mediaType);
      setFormMediaKey(null);
      setFormMediaName(file.name);
    }
    setFormError(null);
    setUploading(kind);

    try {
      const ticketRes = await fetch("/api/admin/models/upload-url", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ kind, contentType: file.type }),
      });
      const ticket = await ticketRes.json();
      if (!ticketRes.ok || !ticket.ok) {
        throw new Error(ticket.error ?? copy.common.uploadError);
      }

      // 서버가 준 티켓을 그대로 실행한다 — 스토리지 종류를 클라이언트가 알지 않는다.
      const uploadRes = await fetch(ticket.data.uploadUrl, {
        method: ticket.data.uploadMethod ?? "PUT",
        headers: ticket.data.uploadHeaders ?? { "Content-Type": file.type },
        body: file,
      });
      if (!uploadRes.ok) throw new Error(`${copy.common.uploadError} (${uploadRes.status})`);

      if (kind === "logo") setFormLogoKey(ticket.data.storageKey);
      else {
        setFormMediaKey(ticket.data.storageKey);
        setFormMediaType(ticket.data.mediaType);
      }
    } catch (e) {
      if (kind === "logo") {
        setFormLogoPreview(previousLogo.preview);
        setFormLogoKey(previousLogo.key);
        setFormLogoName(previousLogo.name);
      } else {
        setFormMediaPreview(previousMedia.preview);
        setFormMediaType(previousMedia.type);
        setFormMediaKey(previousMedia.key);
        setFormMediaName(previousMedia.name);
      }
      /* 서버가 준 사유(형식, 용량, 주소 만료)와 스토리지 상태 코드를 그대로 보인다. 한 줄로 뭉개면 무엇을
         고쳐야 할지 알 수 없다. */
      setFormError(e instanceof Error ? e.message : copy.common.uploadError);
    } finally {
      setUploading(null);
    }
  };

  const handleSave = async () => {
    if (!formName.trim()) {
      setFormError(copy.content.modelNameRequired);
      return;
    }

    setSaving(true);
    setFormError(null);
    /* 앞서 실패한 숨기기, 삭제, 순서 저장의 알림을 지운다. 그 알림(「저장하지 못했습니다」)이 편집 저장의
       실패와 같은 말이라, 남겨 두면 저장에 성공한 뒤에도 이 저장이 실패한 것처럼 읽히고, 그 다시 시도는
       다른 모델의 노출을 바꾼다. */
    setActionFailure(null);
    try {
      const fd = new FormData();
      fd.append("name", formName);
      fd.append("description", formDesc);
      fd.append("description_en", formDescEn);
      fd.append("description_ja", formDescJa);
      fd.append("badge", formBadge);
      fd.append("video_playback", formPlayback);
      fd.append("is_active", String(formActive));
      /* 파일이 아니라 키다 — 업로드는 파일을 고를 때 이미 끝났다. */
      if (formMediaKey) fd.append("media_key", formMediaKey);
      if (formLogoKey) fd.append("logo_key", formLogoKey);

      const res = await fetch(
        editing ? `/api/admin/models/${editing.id}` : "/api/admin/models",
        { method: editing ? "PATCH" : "POST", body: fd },
      );
      const json = await res.json();
      /* 실패를 삼키면 모달이 그대로 열려 있어 아무 일도 없었던 것처럼 보인다. */
      if (!res.ok || !json.ok) {
        setFormError(copy.common.saveError);
        return;
      }
      closeForm();
      await fetchModels();
    } catch {
      setFormError(copy.common.saveError);
    } finally {
      setSaving(false);
    }
  };

  /* 노출과 숨김만 바꾼다 — PATCH 는 보낸 칸만 고치므로 다른 값은 그대로다. */
  const toggleActive = async (model: Model) => {
    setActionFailure(null);
    try {
      const fd = new FormData();
      fd.append("is_active", String(!model.is_active));
      const res = await fetch(`/api/admin/models/${model.id}`, { method: "PATCH", body: fd });
      const json = await res.json();
      if (!res.ok || !json.ok) throw new Error();
      setModels((prev) => prev.map((m) => (m.id === model.id ? { ...m, is_active: !model.is_active } : m)));
    } catch {
      /* 다시 시도는 같은 모델을 누른 순간의 값에서 다시 뒤집는다 — 그사이 목록을 다시 읽어 값이
         바뀌었어도 원래 가려던 쪽으로 보낸다. 목록도 다시 읽어, 그사이 지워진 모델이면 알림이 사라지게 한다
         (없는 모델에 PATCH 를 되풀이하면 500 만 거듭된다). */
      setActionFailure({ text: copy.common.saveError, targetId: model.id, retry: () => void toggleActive(model) });
      void fetchModels();
    }
  };

  const handleDelete = async (id: string) => {
    const ok = await confirm({
      title: copy.content.deleteModel,
      description: copy.content.deleteDescription,
      confirmLabel: copy.common.delete,
      variant: "danger",
    });
    if (!ok || deleting) return;
    setDeleting(true);
    setActionFailure(null);
    try {
      const response = await fetch(`/api/admin/models/${id}`, { method: "DELETE" });
      const result = await response.json();
      if (!response.ok || !result.ok) throw new Error();
      await fetchModels();
    } catch {
      /* 다시 시도는 같은 모델의 삭제를 다시 묻는다. */
      setActionFailure({ text: copy.common.deleteError, targetId: id, retry: () => void handleDelete(id) });
    } finally {
      setDeleting(false);
    }
  };

  const renderRowContent = (model: Model, options?: { compact?: boolean }) => (
    <>
      <div
        role="button"
        tabIndex={reordering || draggingId ? -1 : 0}
        className={DRAG_HANDLE}
        aria-label={copy.common.reorder}
        title={copy.common.reorderHint}
        aria-disabled={reordering || !!draggingId}
        data-reorder-handle
        onPointerDown={(e) => handlePointerDown(e, model.id)}
        onKeyDown={(event) => {
          if (event.key !== "ArrowUp" && event.key !== "ArrowDown") return;
          event.preventDefault();
          moveItem(model.id, event.key === "ArrowUp" ? -1 : 1);
        }}
      >
        <span className={DRAG_HANDLE_ICON} aria-hidden />
      </div>
      {model.media_url &&
        (model.media_type === "video" ? (
          /* 썸네일은 재생하지 않는다 — `preload="metadata"` 로 첫 프레임만 받는다. */
          <video
            src={model.media_url}
            className={`${THUMB}${model.is_active ? "" : " opacity-50"}`}
            preload="metadata"
            muted
            playsInline
            aria-hidden
          />
        ) : (
          /* eslint-disable-next-line @next/next/no-img-element */
          <img src={model.media_url} alt="" className={`${THUMB}${model.is_active ? "" : " opacity-50"}`} />
        ))}
      <div className={ITEM_INFO}>
        {options?.compact ? (
          <span className={`type-body-14-medium ${ITEM_TITLE}`}>{model.name}</span>
        ) : (
          <button type="button" className={`type-body-14-medium ${ITEM_TITLE} ${ROW_TITLE} inline-flex items-center gap-3`} disabled={deleting || reordering} onClick={() => resetForm(model)}>
            {/* 로고는 모델을 알아보는 표시라 상태 옆이 아니라 이름 앞에 선다. */}
            {model.logo_url && (
              <span className={LOGO_TILE}>
                {/* eslint-disable-next-line @next/next/no-img-element */}
                <img src={model.logo_url} alt="" className={LOGO_CHIP} />
              </span>
            )}
            {/* 버튼이 flex 라 글자 조각에는 말줄임이 걸리지 않는다. 이름을 따로 감싸 자른다. */}
            <span className="min-w-0 truncate">{model.name}</span>
          </button>
        )}
        {!options?.compact && (
          <span className={`type-caption-12-regular ${ITEM_DESC}`}>{model.description || ""}</span>
        )}
      </div>
      {!options?.compact && (
        <>
          {/* 강조 표시와 상태는 고정 폭 칸에 선다 — 오른쪽부터 쌓이면 행마다 자리가 달라 열로 훑을 수 없었다. */}
          <span className="w-[56px] shrink-0 flex justify-end">
            {model.badge && (
              <span className={`type-caption-12-regular ${BADGE_ACTIVE}`}>
                {BADGE_LABEL[model.badge]}
              </span>
            )}
          </span>
          <span className="w-[56px] shrink-0 flex justify-end">
            <AdminStatus exception={!model.is_active} label={model.is_active ? copy.common.published : copy.common.hidden} />
          </span>
          {/* 행을 누르면 수정이 열린다. 숨기기와 삭제는 더보기 메뉴가 갖는다. */}
          <AdminMoreMenu
            label={formatAdminMessage(copy.common.moreFor, { name: model.name })}
            items={[
              { key: "edit", label: copy.common.edit, onSelect: () => resetForm(model), disabled: deleting || reordering },
              { key: "visibility", label: model.is_active ? copy.content.hide : copy.content.show, onSelect: () => void toggleActive(model), disabled: deleting || reordering },
              { key: "delete", label: copy.common.delete, tone: "danger", onSelect: () => void handleDelete(model.id), disabled: deleting || reordering },
            ]}
          />
        </>
      )}
    </>
  );

  return (
    <div className={SECTION}>
      <AdminSectionHeader level="section" title={copy.content.models}
        description={sorted.length > 1 ? <AdminLines lines={[copy.content.modelPlacement, copy.common.reorderHint]} /> : copy.content.modelPlacement}
        meta={loading || listFailed ? undefined : formatAdminMessage(copy.common.count, { count: sorted.length })}
        actions={<Button variant="inverse" onClick={() => resetForm(null)} disabled={deleting || reordering}>{copy.content.addModel}</Button>}
      />
      <AdminActionFailureAlert failure={actionFailure} listedIds={orderedIds} disabled={loading || deleting || reordering} />
      {listError && !listFailed && <AdminAlert action={<Button variant="secondary" onClick={fetchModels} disabled={loading}>{copy.common.retry}</Button>}>{listError}</AdminAlert>}

      {loading ? (
        <AdminState kind="loading" title={copy.content.modelsLoading} />
      ) : listFailed ? (
        <AdminLoadError title={copy.content.modelsLoadFailed} onRetry={() => void fetchModels()} />
      ) : sorted.length === 0 ? (
        !listError && <AdminState kind="empty" title={copy.content.noModels} description={copy.content.emptyDescription} />
      ) : (
        <ul ref={listRef} className={`${LIST}${draggingId ? ` ${LIST_DRAGGING}` : ""}`}>
          {displayIds.map((id, idx) => {
            const model = modelById.get(id);
            if (!model) return null;

            return (
              <Fragment key={id}>
                {draggingId && insertionIndex === idx && (
                  <li className={INSERTION_LINE} aria-hidden />
                )}
                {draggingId === id ? (
                  <li data-reorder-row={id} className={ITEM_PLACEHOLDER} aria-hidden />
                ) : (
                  <li
                    data-reorder-row={id}
                    className={`${ITEM} cursor-pointer`}
                    onClick={(event) => {
                      /* 삭제나 순서 저장이 도는 동안에는 메뉴의 「수정」처럼 열지 않는다. */
                      if (deleting || reordering || isRowClickIgnored(event)) return;
                      resetForm(model);
                    }}
                  >
                    {renderRowContent(model)}
                  </li>
                )}
              </Fragment>
            );
          })}
          {draggingId && insertionIndex === displayIds.length && (
            <li className={INSERTION_LINE} aria-hidden />
          )}
        </ul>
      )}

      {ghost && draggingModel && (
        <div
          className={DRAG_GHOST}
          style={{
            width: ghost.width,
            transform: `translate3d(${ghost.x - ghost.offsetX}px, ${ghost.y - ghost.offsetY}px, 0)`,
          }}
          aria-hidden
        >
          {renderRowContent(draggingModel, { compact: true })}
        </div>
      )}

      {formOpen && (
        <AdminEditorDialog title={editing ? copy.content.editModel : copy.content.addModel}
          description={copy.content.publishHint} onClose={() => void requestClose(closeForm)} busy={saving || uploading !== null}
          actions={<>
              <Button variant="secondary" onClick={() => void requestClose(closeForm)} disabled={saving || uploading !== null}>
                {copy.common.cancel}
              </Button>
              <Button
                variant="inverse"
                onClick={handleSave}
                disabled={saving || uploading !== null}
              >
                <InlineLoadingLabel loading={saving} loadingLabel={copy.common.saving} idleLabel={copy.common.save} />
              </Button></>}>
            {/* 미리보기 — 홈의 「최신 AI 모델」 캐러셀과 같은 카드(`MediaCard`, 316 정사각)로 그린다.
                예전에는 미디어와 로고를 입력칸 밑에 따로 띄워, 홈에서 글자와 함께 어떻게 보이는지는
                저장하고 홈을 열어야 알았다. */}
            <div className="md:col-span-2 flex flex-col gap-4">
              <span className={FIELD_LABEL}>{copy.common.preview}</span>
              {formMediaPreview ? (
                <MediaCard
                  image={formMediaPreview}
                  mediaType={formMediaType}
                  videoPlayback={formPlayback}
                  alt=""
                  name={formName || copy.content.modelName}
                  sub={formDesc || undefined}
                  badge={formBadge ? BADGE_LABEL[formBadge] : undefined}
                  icon={formLogoPreview ? (
                    /* eslint-disable-next-line @next/next/no-img-element */
                    <img src={formLogoPreview} alt="" className="flex-none w-8 h-8 object-contain" draggable={false} />
                  ) : undefined}
                />
              ) : (
                /* 미디어가 없는 카드는 홈에 나가지 않는다(`ModelCarousel` 이 건너뛴다). 자리만 같은 크기로 둔다. */
                <div className={`${PREVIEW_EMPTY} type-caption-12-regular`}>
                  {formLogoPreview && (
                    <span className={LOGO_TILE}>
                      {/* eslint-disable-next-line @next/next/no-img-element */}
                      <img src={formLogoPreview} alt="" className={LOGO_CHIP} />
                    </span>
                  )}
                  {copy.content.previewNeedsMedia}
                </div>
              )}
            </div>

            {/* 입력 순서 — 이름과 강조 표시(카드 위쪽), 세 언어 설명, 파일 둘, 노출. */}
            <label className={FORM_GROUP}>
              <span className={FIELD_LABEL}>{copy.content.modelName}</span>
              <span className={FORM_BOX}>
                <input
                  className={FORM_INPUT}
                  value={formName}
                  onChange={(e) => setFormName(e.target.value)}
                  placeholder="Kling 3.0"
                />
              </span>
              <span className={`type-caption-12-regular ${FORM_HINT}`}>
                {copy.content.modelNameHint}
              </span>
            </label>

            <div className={FORM_GROUP}>
              <span className={FIELD_LABEL}>{copy.content.badge}</span>
              <AdminSelect
                ariaLabel={copy.content.badge}
                value={formBadge}
                options={BADGE_OPTIONS}
                onChange={(v) => setFormBadge(v)}
              />
            </div>

            <label className={FORM_GROUP}>
              <span className={FIELD_LABEL}>{copy.common.descriptionKo}</span>
              <span className={FORM_TEXTAREA_BOX}>
                <textarea
                  className={FORM_TEXTAREA}
                  value={formDesc}
                  onChange={(e) => setFormDesc(e.target.value)}
                  placeholder={copy.common.descriptionKo}
                  rows={2}
                />
              </span>
            </label>

            <label className={FORM_GROUP}>
              <span className={FIELD_LABEL}>{copy.common.descriptionEn}</span>
              <span className={FORM_TEXTAREA_BOX}>
                <textarea
                  className={FORM_TEXTAREA}
                  value={formDescEn}
                  onChange={(e) => setFormDescEn(e.target.value)}
                  placeholder="e.g. Cinematic video with audio"
                  rows={2}
                />
              </span>
            </label>

            <label className={`${FORM_GROUP} md:col-span-2`}>
              <span className={FIELD_LABEL}>{copy.content.descriptionJa}</span>
              <span className={FORM_TEXTAREA_BOX}>
                <textarea
                  className={FORM_TEXTAREA}
                  value={formDescJa}
                  onChange={(e) => setFormDescJa(e.target.value)}
                  rows={2}
                />
              </span>
              <span className={`type-caption-12-regular ${FORM_HINT}`}>
                {copy.content.japaneseFallback}
              </span>
            </label>

            {/* 파일 칸은 텍스트 필드가 아니라 `__box` 를 두지 않는다 — 라벨과의 묶음만 정본을 쓰고,
                라벨이 파일 대화상자를 열지 않도록 `div` 로 둔다. */}
            <div className={FORM_GROUP}>
              <span className={FIELD_LABEL}>{copy.common.media}</span>
              <AdminFilePicker
                label={copy.common.media}
                accept={MODEL_MEDIA_ACCEPT}
                disabled={uploading !== null}
                fileName={formMediaName}
                hasFile={formMediaPreview !== null}
                onPick={(file) => void handleUpload("media", file)}
              />
              <span className={`type-caption-12-regular ${FORM_HINT}`}>
                <AdminLines lines={formatAdminLines(copy.content.fileLimit, { formats: "PNG, JPG, WebP, MP4, WebM", image: MB(modelUploadMaxBytes("media", "image")), video: MB(modelUploadMaxBytes("media", "video")) })} />
              </span>
              {uploading === "media" && (
                <span className={`type-caption-12-regular ${FORM_HINT}`}><InlineLoadingLabel loading loadingLabel={copy.common.uploading} idleLabel={copy.common.uploading} /></span>
              )}
            </div>

            <div className={FORM_GROUP}>
              <span className={FIELD_LABEL}>{copy.content.logo}</span>
              <AdminFilePicker
                label={copy.content.logo}
                accept={MODEL_LOGO_ACCEPT}
                disabled={uploading !== null}
                fileName={formLogoName}
                hasFile={formLogoPreview !== null}
                onPick={(file) => void handleUpload("logo", file)}
              />
              <span className={`type-caption-12-regular ${FORM_HINT}`}>
                <AdminLines lines={formatAdminLines(copy.content.logoHint, { limit: MB(modelUploadMaxBytes("logo", "image")) })} />
              </span>
              {uploading === "logo" && (
                <span className={`type-caption-12-regular ${FORM_HINT}`}><InlineLoadingLabel loading loadingLabel={copy.common.uploading} idleLabel={copy.common.uploading} /></span>
              )}
            </div>

            {formMediaType === "video" && (
              <div className={FORM_GROUP}>
                <span className={FIELD_LABEL}>{copy.content.playback}</span>
                <AdminSelect
                  ariaLabel={copy.content.playback}
                  value={formPlayback}
                  options={PLAYBACK_OPTIONS}
                  onChange={(v) => setFormPlayback(v)}
                />
                <span className={`type-caption-12-regular ${FORM_HINT}`}>
                  {copy.content.reducedMotionHint}
                </span>
              </div>
            )}

            {formError && (
              <p className={`md:col-span-2 type-caption-12-regular ${FORM_ERROR}`} role="alert">
                {formError}
              </p>
            )}

            {/* 공개 여부는 템플릿, 블로그와 같은 두 칸 선택이다. 예전에는 여기만 「홈에 노출」 체크 칸이었다. */}
            <div className="md:col-span-2 flex flex-col gap-4">
              <span className={FIELD_LABEL}>{copy.common.publishState}</span>
              <AdminSegmented
                label={copy.common.publishState}
                value={formActive ? "published" : "hidden"}
                options={[
                  { key: "hidden", label: copy.common.hidden },
                  { key: "published", label: copy.common.published },
                ]}
                onChange={(key) => setFormActive(key === "published")}
              />
            </div>

        </AdminEditorDialog>
      )}
      {confirmDialog}
    </div>
  );
}
