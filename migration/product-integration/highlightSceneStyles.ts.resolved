    "[--mainchrome-bleed-right:0px]",
    "[@media(max-width:900px)]:[overflow-y:auto]",
    "[@media(max-width:900px)]:[overscroll-behavior:contain]",
  ].join(" "),
  studioHeaderSlot: "appMainChromeHeaderSlot [display:flex] [flex-direction:column] empty:hidden",
  /* [작업 열 | 인스펙터] 두 칸. 작업 열은 무대 · (리뷰의 AI 수정 막대) · 트랙을 세로로 쌓는다. 좁으면 한 줄로 쌓아
     무대 → 트랙 → 인스펙터 순이 된다(단계마다 같은 순서).
     간격은 컴포지션 도킹 셸과 같다 — 바깥은 `--app-gnb-main-inline-padding`(데스크톱 16 · 폰 6, `modalShellDocked`
     의 margin), 패널 사이는 8(`modalBody` 의 열 간격 2 + 손잡이 칸 4 + 2). */
  studio: [
    "[flex:1_1_auto]",
    "[min-height:0]",
    "[box-sizing:border-box]",
    "[display:grid]",
    "[grid-template-columns:minmax(0,1fr)_320px]",
    "[grid-template-rows:minmax(0,1fr)]",
    "[gap:8px]",
    "[padding:var(--app-gnb-main-inline-padding)]",
    "[@media(max-width:900px)]:[grid-template-columns:minmax(0,1fr)]",
    "[@media(max-width:900px)]:[grid-template-rows:auto]",
    /* 쌓인 배치는 화면 높이에 묶지 않는다 — 묶으면 행이 남는 높이를 나눠 가져 무대(overflow:hidden 이라 최소가
       0)부터 줄어든다. 구르는 것은 바깥 본문(`studioMain`)이다. */
    "[@media(max-width:900px)]:[flex:none]",
    /* 낮은 화면(가로 폰)에서 떠 있는 AI 클립 수정 버튼(아래 24px, 높이 40px)만큼 끝에 여유를 둔다 — 마지막 줄이 버튼
       밑에 갇히지 않게. 폰 판에서는 버튼이 무대 안에 선다 */
    "[@media(max-width:900px)_and_(max-height:559.98px)]:[&[data-refine-launcher]]:[padding-bottom:88px]",
  ].join(" "),
  /* 작업 열 — 무대가 남는 높이를 받고, 막대 · 트랙은 제 높이만큼 선다 */
  studioColumn: [
    "[grid-column:1]",
    "[grid-row:1]",
    "[display:flex]",
    "[flex-direction:column]",
    "[gap:8px]",
    "[min-width:0]",
    "[min-height:0]",
    "[@media(max-width:900px)]:[min-height:auto]",
  ].join(" "),
  /* 무대 — 플레이어처럼 두 테마 모두 검은 바탕(LOUIS 고정 검정, `SHORT_RESULT_PLAYER` 와 같은 색) */
  studioStage: [
    "[flex:1_1_auto]",
    "[position:relative]",
    "[min-height:0]",
    "[display:flex]",
    "[align-items:center]",
    "[justify-content:center]",
    /* 반경은 컴포지션 패널과 같은 12(card) */
    "[border-radius:var(--louis-radius-card)]",
    "[background:var(--palette-gray-1000)]",
    "[overflow:hidden]",
    /* 좁으면 원본 비율로 선다. 바닥 높이를 함께 주면 16:9 가 폭을 되밀어 칸 밖으로 넘친다(390 에서 427) */
    "[@media(max-width:900px)]:[flex:none]",
    "[@media(max-width:900px)]:[aspect-ratio:16_/_9]",
    "[@media(max-width:900px)]:[width:100%]",
    /* 파일을 끌어 무대 위에 올린 동안 — 테두리를 강조색으로. 플레이어 위에 그려야 해서 ::after 로 긋는다
       (위치를 가진 형제 가운데 문서 순서가 마지막이라 z-index 없이 위에 선다) */
    "[&[data-dragging]]:after:[content:'']",
    "[&[data-dragging]]:after:[position:absolute]",
    "[&[data-dragging]]:after:[inset:0]",
    "[&[data-dragging]]:after:[border:var(--louis-border-width-ring)_solid_var(--louis-color-accent-primary)]",
    "[&[data-dragging]]:after:[border-radius:inherit]",
    "[&[data-dragging]]:after:[pointer-events:none]",
    "[@media(max-width:900px)_and_(min-height:560px)]:[max-height:38svh]",
    "[@media(max-width:900px)_and_(max-height:559.98px)]:[max-height:78svh]",
  ].join(" "),
  /* 무대의 영상은 잘리지 않고 통째로 선다 — 구간을 고르는 자리라 가장자리가 잘리면 판단이 틀린다. 원본과 무대의
     비율이 달라도(가로 2:1 원본을 1.85 무대에, 세로 숏폼을 가로 무대에) 검은 무대가 남는 자리를 채운다 */
  studioPlayer: "[width:100%] [height:100%] [--vp-object-fit:contain]",
  /* 빈 무대 — 칸 전체가 파일 선택 버튼. 검은 바탕 위라 글자 · 글리프는 페이퍼 잉크로 고정한다 */
  studioStageEmpty: [
    "group",
    "[display:flex]",
    "[flex-direction:column]",
    "[align-items:center]",
    "[justify-content:center]",
    "[gap:8px]",
    "[width:100%]",
