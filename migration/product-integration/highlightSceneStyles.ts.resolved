    "[--louis-layout-control-height-md:40px]",
    "[--louis-layout-settings-segment-height:36px]",
  ].join(" "),
  /* 숏폼 크게 보기 — 좁은 화면(≤900)에서 숏폼 완성 칸의 무대 오른쪽 위. 가로 무대 안의 세로 숏폼은 폭이 120 남짓이라
     볼 수 없어 브라우저 전체 화면으로 본다. 막대의 글자 버튼으로 두면 영어와 일본어에서 막대가 세 줄로 접혔다.
     검은 무대 위라 글리프는 페이퍼 잉크, 면은 옅은 검정(플레이어 조작부와 같은 말). 플레이어(`VideoPlayer`)의 누름 층과
     조작부가 z 4 로 무대를 덮으므로 그보다 한 칸 위에 둔다 — 아래에 두면 보이기만 하고 누름은 재생 전환으로 갔다 */
  studioStageFullscreen: [
    "[display:none]",
    "[@media(max-width:900px)]:[display:inline-flex]",
    "[position:absolute]",
    "[z-index:5]",
    "[top:8px]",
    "[right:8px]",
    "[align-items:center]",
    "[justify-content:center]",
    "[width:36px]",
    "[height:36px]",
    "[padding:0]",
    "[border:0]",
    "[border-radius:var(--louis-radius-pill)]",
    "[background:rgb(var(--palette-gray-1000-rgb)/56%)]",
    "[color:var(--palette-gray-000)]",
    "[cursor:pointer]",
    "focus-visible:[outline:var(--louis-border-width-ring)_solid_var(--louis-color-stroke-focus)]",
    "focus-visible:[outline-offset:2px]",
  ].join(" "),
  studioInspectorTitle: "[margin:0] [color:var(--louis-color-fg-primary)]",
  /* 판 목록의 절 제목 줄 — 제목 오른쪽에 클립 수나 고른 개수 */
  studioInspectorHead: [
    "[display:flex]",
    "[align-items:baseline]",
    "[justify-content:space-between]",
    "[gap:8px]",
    "[min-width:0]",
  ].join(" "),
  studioSection: "[display:flex] [flex-direction:column] [gap:8px]",
  studioSelectRoot: "[display:block] [width:100%]",
  studioSelectTrigger: "[width:100%]",
  /* 아직 고르지 않은 Select 의 안내 — LOUIS 계약에 placeholder 가 없어(select.md) 잉크만 한 단 내린다 */
  studioSelectValue: "[&[data-placeholder]]:[color:var(--louis-color-fg-tertiary)]",
  /* 하이라이트 트랙 — 원본 길이의 눈금과 구간(`StudioSegmentTrack`). 「새 하이라이트」에서는 빈 트랙이고, 분석하면 AI 가
     찾은 구간이 원본 시각 그대로의 자리에 채워진다 */
  studioTimeline: [
    "[flex:none]",
    "[display:flex]",
    "[flex-direction:column]",
    "[padding:12px_16px_14px]",
    "[box-sizing:border-box]",
    "[border-radius:var(--louis-radius-card)]",
    "[background:var(--louis-color-bg-raised)]",
    "[box-shadow:var(--louis-hairline-inset)]",
    /* 좁은 화면: 확정한 모양(전체 지도 + 구간 줄)을 그대로 두고 이름 줄만 뺀다. 폰 판에서는 이 트랙이 후보를 고르는
       길이다. 안쪽 여백을 줄이고, 구간이 없을 때의 빈 트랙도 남기되 낮게 선다 */
    "[@media(max-width:900px)]:[padding:8px_12px_10px]",
  ].join(" "),
  /* 판의 무대 아래 막대 — 무대에 오른 칸의 상태와 그 칸의 다음 행동. 무대와 붙어 있어 인스펙터는 목록과 선정 이유만
     갖는다 */
  studioStageBar: [
    "[flex:none]",
    "[display:flex]",
    "[flex-wrap:wrap]",
    "[align-items:center]",
    "[gap:8px]",
    "[padding:8px]",
    "[box-sizing:border-box]",
    "[border-radius:var(--louis-radius-card)]",
    "[background:var(--louis-color-bg-raised)]",
    "[box-shadow:var(--louis-hairline-inset)]",
  ].join(" "),
  /* [트랙 이름 | 시간 열] 두 칸. 눈금은 시간 열 위, 재생헤드는 눈금 아래부터 구간 바닥까지 시간 열을 가로지른다 */
  studioTrackGrid: [
    "[display:grid]",
    "[grid-template-columns:96px_minmax(0,1fr)]",
    "[column-gap:12px]",
    "[row-gap:6px]",
    "[align-items:center]",
    /* 좁은 화면(≤900)에서는 이름 줄을 빼고 한 칸으로 쌓는다(눈금, 지도, 구간 줄) — 이름을 옆에 두면 빈 트랙 안내가 세
       줄로 접혔다 */
    "[@media(max-width:900px)]:[grid-template-columns:minmax(0,1fr)]",
    "[@media(max-width:900px)]:[row-gap:6px]",
  ].join(" "),
  /* 눈금 — 바닥의 잔눈금은 큰 눈금 한 칸을 다섯으로 나눈 간격이라 큰 눈금과 어긋나지 않는다(길이를 모르면 12px) */
  studioRuler: [
    "[grid-column:2]",
    "[grid-row:1]",
    "[position:relative]",
    "[height:28px]",
    "[color:var(--louis-color-fg-tertiary)]",
    "[font-variant-numeric:tabular-nums]",
    "[background-image:repeating-linear-gradient(to_right,var(--louis-color-stroke-subtle)_0_1px,transparent_1px_var(--studio-ruler-minor,12px))]",
    "[background-size:100%_4px]",
    "[background-repeat:no-repeat]",
    "[background-position:left_bottom]",
    "[@media(max-width:900px)]:[grid-column:1]",
    "[@media(max-width:900px)]:[grid-row:1]",
    /* 좁은 화면은 칸을 줄인다 — 다만 큰 눈금(시각 글자 18 아래 2 띄워 8)이 지도(간격 6 아래) 윗변에 닿지 않게 24 */
    "[@media(max-width:900px)]:[height:24px]",
  ].join(" "),
  /* 시각 글자 — 닻을 시각 비율만큼 옮긴다(0%는 왼끝, 100%는 오른끝). 양끝에서도 칸 밖으로 나가지 않고, 같은 비율
     자리에 긋는 큰 눈금은 시각의 정확한 자리에 떨어진다 */
  studioRulerLabel: [
    "[position:absolute]",
    "[top:0]",
    "[left:calc(var(--studio-tick,0)*1%)]",
    "[transform:translateX(calc(var(--studio-tick,0)*-1%))]",
    "[white-space:nowrap]",
    "[&::after]:[content:'']",
    "[&::after]:[position:absolute]",
    "[&::after]:[top:calc(100%_+_2px)]",
    "[&::after]:[left:calc(var(--studio-tick,0)*1%)]",
    "[&::after]:[width:1px]",
    "[&::after]:[height:8px]",
    "[&::after]:[transform:translateX(calc(var(--studio-tick,0)*-1%))]",
    "[&::after]:[background-color:var(--louis-color-stroke-default)]",
  ].join(" "),
  studioTrackLabel: [
    "[grid-column:1]",
    "[grid-row:2]",
    "[display:inline-flex]",
    "[align-items:center]",
    "[gap:6px]",
    "[min-width:0]",
    "[color:var(--louis-color-fg-secondary)]",
    "[@media(max-width:900px)]:[display:none]",
  ].join(" "),
  /* 사이드바 하이라이트 메뉴와 같은 글리프를 같은 방식(마스크 + currentColor)으로 칠한다 */
  studioTrackGlyph: [
    "[display:block]",
    "[flex:none]",
    "[width:16px]",
    "[height:16px]",
    "[background-color:currentColor]",
    "[mask:url(/highlight_symbol.svg)_center_/_contain_no-repeat]",
    "[-webkit-mask:url(/highlight_symbol.svg)_center_/_contain_no-repeat]",
  ].join(" "),
  /* 빈 트랙 — 아직 구간이 없다는 자리. 점선은 「아직」의 말이고, 추출에서 뺀 구간이 같은 점선으로 물러난다 */
  studioTrackLane: [
    "[grid-column:2]",
    "[grid-row:2]",
    "[min-width:0]",
    "[display:flex]",
    "[align-items:center]",
    "[justify-content:center]",
    "[min-height:56px]",
    "[padding:0_12px]",
    "[box-sizing:border-box]",
    "[border-radius:var(--louis-radius-control)]",
    "[border:var(--louis-border-width-default)_dashed_var(--louis-color-stroke-default)]",
    "[text-align:center]",
    "[@media(max-width:900px)]:[grid-column:1]",
    "[@media(max-width:900px)]:[grid-row:2]",
    "[@media(max-width:900px)]:[min-height:40px]",
  ].join(" "),
  /* 구간 줄의 칸 — 컴포지션 타임라인 클립의 말(반투명 면 + 1px 선, 반경 control-sm, `vemClass` 의 오디오 · 오버레이
     클립). 면과 선은 변수 둘이 갖고 상태는 변수만 바꾼다. 최소 88px 에 남는 폭은 실제 길이 비율(`--studio-weight`).
     background 는 longhand 만 쓴다(shorthand 가 섞이면 정렬 순서에 따라 longhand 가 지워진다) */
  studioTrackBlock: [
    "group/block",
    "[position:relative]",
    "[flex:var(--studio-weight,1)_1_88px]",
    "[height:32px]",
    "[min-width:88px]",
    "[display:flex]",
    "[align-items:center]",
    "[padding:0_8px]",
    "[box-sizing:border-box]",
    "[margin:0]",
    "[border:var(--louis-border-width-default)_solid_var(--studio-block-stroke)]",
    "[border-radius:var(--louis-radius-control-sm)]",
    "[background-color:var(--studio-block-fill)]",
    "[color:var(--louis-color-fg-primary)]",
    "[font-family:inherit]",
    "[text-align:left]",
    "[overflow:hidden]",
    "[cursor:pointer]",
    "[--studio-block-stroke:var(--primary-300)]",
    "[--studio-block-fill:rgb(var(--primary-300-rgb)/48%)]",
    "[html[data-theme=dark]_&]:[--studio-block-stroke:var(--primary-800)]",
    "hover:[--studio-block-fill:rgb(var(--primary-400-rgb)/48%)]",
    "[transition-property:background-color,border-color,outline-color]",
    "[transition-duration:var(--louis-motion-control-hover-duration)]",
    "[transition-timing-function:var(--louis-motion-control-hover-timing-function)]",
    /* 추출에서 뺀 구간 — 빈 트랙과 같은 점선으로 물러난다. 테마 · hover 규칙보다 앞서야 해서 중요도를 건다 */
    "[&[data-included=false]]:[--studio-block-stroke:var(--louis-color-stroke-default)]!",
    "[&[data-included=false]]:[--studio-block-fill:transparent]!",
    "hover:[&[data-included=false]]:[--studio-block-fill:var(--louis-color-accent-ghost-hover)]!",
    "[&[data-included=false]]:[border-style:dashed]",
    "[&[data-included=false]]:[color:var(--louis-color-fg-tertiary)]",
    /* 판의 칸 모양(`studioBoard.ts` boardTrackLook) — 점선은 아직 만들지 않은 것, 면이 진할수록 더 만들어진 것.
       후보(뺌)는 위의 회색 점선, 클립은 기본 면이다. 다음 추출에 넣은 후보는 강조색 점선, 숏폼까지 끝난 칸은
       강조색 면(LOUIS primary 버튼과 같은 면 · 글자 짝) */
    "[&[data-state=selected]]:[--studio-block-stroke:var(--louis-color-accent-primary)]!",
    "[&[data-state=selected]]:[--studio-block-fill:transparent]!",
    "hover:[&[data-state=selected]]:[--studio-block-fill:var(--louis-color-accent-ghost-hover)]!",
    "[&[data-state=selected]]:[border-style:dashed]",
    "[&[data-state=short]]:[--studio-block-stroke:var(--louis-color-accent-primary)]!",
    "[&[data-state=short]]:[--studio-block-fill:var(--louis-color-accent-primary)]!",
    "[&[data-state=short]]:[color:var(--louis-color-fg-inverse)]",
    /* 무대에 올라 있는 구간 — 재생헤드와 같은 전경색 테두리. 포커스 링(파랑)과 갈린다 */
    "[&[aria-current=true]]:[outline:2px_solid_var(--louis-color-fg-primary)]",
    "[&[aria-current=true]]:[outline-offset:1px]",
    "focus-visible:[outline:var(--louis-border-width-ring)_solid_var(--louis-color-stroke-focus)]",
    "focus-visible:[outline-offset:2px]",
    /* 폰 판의 칸 — 손가락 크기(높이 44)와 이름이 읽히는 폭. 줄은 옆으로 넘긴다 */
    "[@media(max-width:900px)]:[height:44px]",
    "[@media(max-width:900px)]:[min-width:136px]",
    "[@media(max-width:900px)]:[flex:0_0_136px]",
  ].join(" "),
  /* 구간 이름 — 번호 + 제목. 칸 안 재생 위치(절대 배치) 아래에 자리를 잡는다. 좁으면 제목부터 잘리고 번호가 남아
     목록의 같은 번호와 이어진다. 전체 이름은 title 이 갖는다 */
  studioTrackBlockLabel: [
    "[position:relative]",
    "[display:flex]",
    "[align-items:center]",
    "[gap:6px]",
    "[min-width:0]",
    "[overflow:hidden]",
    "[white-space:nowrap]",
    "[pointer-events:none]",
  ].join(" "),
  studioTrackBlockNumber: "[flex:none] [font-variant-numeric:tabular-nums]",
  studioTrackBlockTitle: "[min-width:0] [overflow:hidden] [text-overflow:ellipsis]",
  /* ── 판 인스펙터 ── 구간 목록(체크박스 + LOUIS 선택 행)과 선정 이유. AI 클립 수정은 무대 위 창이, 칸의 행동은
     무대 아래 막대가 갖는다 */
  studioListToolbar: [
    "[display:flex]",
    "[align-items:center]",
    "[justify-content:space-between]",
    "[gap:8px]",
    "[min-height:32px]",
    "[padding-left:8px]",
  ].join(" "),
  studioCheckLabel: "[align-items:center]",
  /* 목록 절 — 제 내용만큼 서고, 인스펙터가 모자라면 목록만 제 안에서 구른다. 받침(선정 이유)은 목록 바로
     아래에 붙는다 — 바닥에 붙이면 구간이 적을 때 목록과 받침 사이가 크게 빈다.
     쌓인 배치(≤900)에서는 구르지 않고 내용만큼 선다 */
  studioListSection: [
    "[flex:0_1_auto]",
    "[min-height:180px]",
    "[display:flex]",
    "[flex-direction:column]",
    "[gap:8px]",
    "[@media(max-width:900px)]:[min-height:auto]",
  ].join(" "),
  /* 받침 — 무대에 오른 구간의 선정 이유. 구르는 목록과 헤어라인 하나로 갈린다 */
  studioDock: [
    "[flex:none]",
    "[display:flex]",
    "[flex-direction:column]",
    "[gap:20px]",
    "[padding-top:16px]",
    "[border-top:var(--louis-border-width-hairline)_solid_var(--louis-color-stroke-subtle)]",
  ].join(" "),
  /* 한 줄 = 체크박스 + 선택 행. 행이 버튼이라 체크박스를 안에 넣지 않고(selectable-list-row.md — 컨트롤 중첩)
     형제로 둔 채 행의 왼쪽 여백 위에 겹친다 — 선택 면 · 표식이 체크박스까지 한 줄로 감싼다. 체크박스는 보이는 순서대로
     문서에서도 앞이라(탭 순서) 위치를 가진 행보다 위에 그리려면 겹 순서가 필요하다. 그 겹을 이 줄 안에 가둔다 */
  studioSegmentItem: "[position:relative] [min-width:0] [isolation:isolate]",
  /* 목록 행 — LOUIS 선택 행의 3px 선행 표식을 끈다(소유자 결정: 왼쪽 파란 막대가 흔한 AI 화면처럼 보인다).
     선택은 면(bg-inset)과 글자 잉크가 갖는다 — 인스펙터가 올라온 면(bg-raised)이라 두 테마 모두 면이 갈린다.
     보조기술에는 `aria-current` 가 그대로 전한다 */
  studioListRow: "[&::before]:[content:none]",
  studioSegmentRow: "[padding-left:36px]",
  /* 체크박스의 누르는 자리 — 상자는 20 이지만 행 왼쪽 여백(36) 전체와 줄 높이 전체를 받는다(WCAG 2.5.8 의 24 이상).
     상자는 예전과 같은 자리(왼쪽 8)에 선다 */
  studioSegmentCheckHit: [
    "[position:absolute]",
    "[inset-block:0]",
    "[left:0]",
    "[width:36px]",
    "[z-index:1]",
    "[display:flex]",
    "[align-items:center]",
    "[justify-content:center]",
    "[cursor:pointer]",
    "[&:has(:disabled)]:[cursor:default]",
  ].join(" "),
  studioSegmentNumber: "[font-variant-numeric:tabular-nums]",
  /* 목록 보조 줄 — 자리와 적합도(또는 길이)를 가운뎃점 대신 간격 8 과 한 단 옅은 글자로 가른다 */
  studioRowMeta: "[display:flex] [gap:8px] [min-width:0]",
  studioRowMetaExtra: "[color:var(--louis-color-fg-tertiary)]",
  studioReason: [
    "[margin:0]",
    "[color:var(--louis-color-fg-secondary)]",
    "[word-break:keep-all]",
  ].join(" "),
  /* ── 판 ── 리뷰와 결과를 합친 한 화면(`HighlightStudioBoardPreview`). 클립 절과 후보 절이 한 스크롤 안에 선다.
     행의 포커스 링(2px + 간격 2px)이 잘리지 않게 안쪽 4px 을 비우고 그만큼 바깥으로 넓힌다. 아래 끝은 잘린 행이 글자
     가운데서 끊기지 않게 흐려 사라진다(마스크 — 알파 면을 새로 만들지 않는다). 끝까지 굴리면 그 자리는 빈 여백이라
     마지막 행은 흐려지지 않는다. 쌓인 배치(900 이하)에서는 구르지 않는다 */
  studioBoardScroll: [
    "[margin:-4px]",
    "[padding:4px_4px_20px]",
    "[display:flex]",
    "[flex-direction:column]",
    "[gap:24px]",
    "[flex:1_1_auto]",
    "[min-height:0]",
    "[overflow-y:auto]",
    "[overscroll-behavior:contain]",
    "[mask-image:linear-gradient(to_bottom,#000_calc(100%_-_20px),transparent)]",
    "[@media(max-width:900px)]:[overflow-y:visible]",
    "[@media(max-width:900px)]:[mask-image:none]",
    "[@media(max-width:900px)]:[padding-bottom:4px]",
  ].join(" "),
  studioBoardGroup: "[display:flex] [flex-direction:column] [gap:8px] [min-width:0]",
  studioBoardList: [
    "[list-style:none]",
    "[margin:0]",
    "[padding:0]",
    "[display:flex]",
    "[flex-direction:column]",
    "[gap:2px]",
  ].join(" "),
  /* 무대 아래 막대의 한 줄. 왼쪽은 칸 상태, 오른쪽은 그 칸의 행동. 폰에서는 행동이 다음 줄로 넘어간다 */
  studioStageBarRow: [
    "[display:flex]",
    "[flex:1_1_auto]",
    "[flex-wrap:wrap]",
    "[align-items:center]",
    "[justify-content:space-between]",
    "[gap:8px_12px]",
    "[min-width:0]",
    "[min-height:40px]",
    "[padding-left:8px]",
  ].join(" "),
  studioStageBarState: [
    "[display:inline-flex]",
    "[align-items:baseline]",
    "[gap:8px]",
    "[min-width:0]",
    "[color:var(--louis-color-fg-primary)]",
  ].join(" "),
  studioStageBarActions: "[display:flex] [flex-wrap:wrap] [gap:8px] [margin-left:auto]",
  /* 올리는 중 · 분석 중의 막대 — [상태][한 문장 안내]가 왼쪽에 붙고 진행 막대나 「브라우저 알림 받기」가 오른쪽 끝에
     선다. 폰에서는 안내가 줄을 넘기고 진행 막대는 제 줄을 다 쓴다. 칸의 막대와 같은 한 줄이라 분석이 끝나 판이
     들어와도 무대 높이가 그대로다 */
  /* 막대가 space-between 이라 오른쪽 끝 항목이 없을 때(알림을 이미 허용했거나 못 쓰는 브라우저) 안내가 끝으로
     밀리지 않게 남는 폭을 오른쪽에 둔다 */
  studioStageBarNote: [
    "[margin:0_auto_0_0]",
    "[min-width:0]",
    "[color:var(--louis-color-fg-secondary)]",
  ].join(" "),
  /* 퍼센트 — 진행 막대 바로 앞에 선다. 자릿수가 바뀌어도 막대가 흔들리지 않게 고정폭 숫자와 너비를 준다 */
  studioStageBarPercent: [
    "[flex:none]",
    "[min-width:4ch]",
    "[text-align:right]",
    "[font-variant-numeric:tabular-nums]",
  ].join(" "),
  /* [퍼센트 진행 막대] 한 묶음 — 막대 끝(오른쪽)에 선다. 폰에서는 제 줄을 받고 글자 줄과 같은 왼쪽에서 시작한다
     (막대 폭은 LOUIS 상한 320 까지) */
  studioStageBarProgress: [
    "[display:flex]",
    "[align-items:center]",
    "[gap:8px]",
    "[flex:0_1_280px]",
    "[margin-left:auto]",
    "[@media(max-width:719px)]:[flex-basis:100%]",
    "[@media(max-width:719px)]:[margin-left:0]",
  ].join(" "),
  studioStageBarProgressTrack: "[flex:1_1_auto] [min-width:0]",
  /* 멈춤 막대의 실패 글리프 — 면이 없는 LOUIS 인라인 알림처럼 글자 색을 따르고, 뜻은 글리프 모양과 문장이 전한다.
     `fg-danger` 는 불투명 위험 면(`bg-danger`)의 짝이라 카드 위에서는 라이트에서 검정에 가깝고 다크에서 흰색이 된다 */
  studioStageBarGlyph: "[flex:none] [align-self:center]",
  /* `AnalysisWaitHint` 의 틀을 풀어 문장과 버튼이 막대 한 줄의 항목이 되게 한다. 버튼은 오른쪽 끝 */
  studioStageBarHint: "[display:contents] [&>button]:[margin-left:auto]",
  /* 판 목록 행의 썸네일 — 구간 첫 프레임. 운영 리뷰 목록과 같은 96 × 16:9, 영상 자리라 무대처럼 검은 바탕.
     곡률 · 잘림은 LOUIS 선택 행의 미디어 슬롯(`louis-selectable-list-row__media`)이 갖는다 */
  studioRowThumb: "[width:96px] [aspect-ratio:16_/_9] [background:var(--palette-gray-1000)]",
  studioRowThumbVideo: "[display:block] [width:100%] [height:100%] [object-fit:cover]",
  /* 무대 아래 막대의 더보기 — 드문 행동(숏폼 삭제)을 담는 LOUIS 메뉴. 막대가 화면 아래쪽이라 위로 연다 */
  studioMoreRoot: "[position:relative] [display:inline-flex]",
  studioMoreMenu: [
    "[position:absolute]",
    "[right:0]",
    "[bottom:calc(100%_+_6px)]",
    "[z-index:var(--louis-layer-popover)]",
    "[--louis-overlay-collision-padding:8px]",
    "[--louis-popover-preferred-inline-size:160px]",
  ].join(" "),
  /* 판 목록을 탭으로 나눈 시안 — [클립 N][후보 N]. 목록 머리 자리에 선다 */
  studioListTabs: "[display:flex] [min-width:0]",

  /* ── 트랙(`StudioSegmentTrack`) ── 눈금 아래 전체 지도, 그 아래 구간 줄. 자리는 지도가, 이름과 상태는 구간
     줄이 늘 맡는다(영상 길이에 따라 모양을 바꾸지 않는다) */
  studioTrackLabelFilled: [
    "[grid-column:1]",
    "[grid-row:3]",
    "[display:inline-flex]",
    "[align-items:center]",
    "[gap:6px]",
    "[min-width:0]",
    "[color:var(--louis-color-fg-secondary)]",
    "[@media(max-width:900px)]:[display:none]",
  ].join(" "),
  /* 전체 지도 — 눈금 바로 아래 얇은 줄. 구간마다 원본 자리와 길이를 가는 막대로(최소 3px). 겹치면 줄을 나눈다 */
  studioTrackMap: [
    "[grid-column:2]",
    "[grid-row:2]",
    "[position:relative]",
    "[min-width:0]",
    "[box-sizing:border-box]",
    "[height:calc(var(--studio-map-lanes,1)*4px_+_(var(--studio-map-lanes,1)_-_1)*2px_+_6px)]",
    "[border-radius:var(--louis-radius-control-sm)]",
    "[background-color:var(--louis-color-bg-inset)]",
    "[@media(max-width:900px)]:[grid-column:1]",
    "[@media(max-width:900px)]:[grid-row:2]",
  ].join(" "),
  /* 지도 막대 — 색은 트랙 칸 모양과 같은 계열이고 후보가 가장 옅다(후보 회색, 클립 옅은 강조색, 다음 추출 · 숏폼
     강조색). 무대에 오른 구간과 구간 줄에서 가리키는 구간은 색을 바꾸지 않고 막대를 키워 테두리를 두른다 — 색으로
     표시하면 이미 강조색인 숏폼 · 다음 추출 막대에서 구별되지 않는다. 무대에 오른 구간은 전경색, 가리키는 구간은
     강조색 테두리다(구간 줄 칸의 테두리 · 초점 링과 같은 짝) */
  studioTrackMapBar: [
    "[position:absolute]",
    "[top:calc(3px_+_var(--studio-map-lane,0)*6px)]",
    "[height:4px]",
    "[min-width:3px]",
    "[border-radius:var(--louis-radius-pill)]",
    "[background-color:var(--primary-300)]",
    "[html[data-theme=dark]_&]:[background-color:var(--primary-800)]",
    "[&[data-included=false]]:[background-color:var(--louis-color-stroke-default)]!",
    "[&[data-state=selected]]:[background-color:var(--louis-color-accent-primary)]!",
    "[&[data-state=short]]:[background-color:var(--louis-color-accent-primary)]!",
    "[&[data-current]]:[top:calc(1px_+_var(--studio-map-lane,0)*6px)]",
    "[&[data-current]]:[height:8px]",
    "[&[data-current]]:[min-width:6px]",
    "[&[data-current]]:[box-shadow:0_0_0_1.5px_var(--louis-color-fg-primary)]",
    "[&[data-hover]]:[top:calc(1px_+_var(--studio-map-lane,0)*6px)]",
    "[&[data-hover]]:[height:8px]",
    "[&[data-hover]]:[min-width:6px]",
    "[&[data-hover]]:[box-shadow:0_0_0_1.5px_var(--louis-color-accent-primary)]",
  ].join(" "),
  /* 재생 위치 — 지도는 원본 시각 그대로, 구간 줄은 무대에 오른 칸 안에서 */
  studioTrackMapPlayhead: [
    "[position:absolute]",
    "[top:-2px]",
    "[bottom:-2px]",
    "[width:2px]",
    "[transform:translateX(-50%)]",
    "[border-radius:var(--louis-radius-pill)]",
    "[background-color:var(--louis-color-fg-primary)]",
    "[pointer-events:none]",
  ].join(" "),
  studioStripPlayhead: [
    "[position:absolute]",
    "[top:4px]",
    "[bottom:4px]",
    "[width:2px]",
    "[transform:translateX(-50%)]",
    "[border-radius:var(--louis-radius-pill)]",
    "[background-color:var(--louis-color-fg-primary)]",
    "[pointer-events:none]",
  ].join(" "),
  studioTrackStrip: [
    "[grid-column:2]",
    "[grid-row:3]",
    "[position:relative]",
    "[display:flex]",
    "[gap:4px]",
    "[min-width:0]",
    /* 칸이 많아 넘치면 가로로 구른다. 무대에 오른 칸의 테두리 · 초점 링이 잘리지 않게 안쪽을 비우고 그만큼 넓힌다 */
    "[margin:-4px]",
    "[padding:4px]",
    "[overflow-x:auto]",
    "[overscroll-behavior-x:contain]",
    "[scrollbar-width:none]",
    "[&::-webkit-scrollbar]:[display:none]",
    /* 키보드로 옮긴 칸이 흐린 가장자리(40) 밑에 서지 않게, 초점이 굴리는 자리를 그만큼 안으로 들인다 */
    "[scroll-padding-inline:40px]",
    /* 넘친 쪽 가장자리는 흐려 더 있다는 것을 보인다(마스크 — 면을 새로 만들지 않는다) */
    "[&[data-fade-end]]:[mask-image:linear-gradient(to_right,#000_calc(100%_-_40px),transparent)]",
    "[&[data-fade-start]]:[mask-image:linear-gradient(to_left,#000_calc(100%_-_40px),transparent)]",
    "[&[data-fade-start][data-fade-end]]:[mask-image:linear-gradient(to_right,transparent,#000_40px,#000_calc(100%_-_40px),transparent)]",
    "[@media(max-width:900px)]:[grid-column:1]",
    "[@media(max-width:900px)]:[grid-row:3]",
  ].join(" "),
  /* 「분석 시작」이 꺼진 이유 — 주제 메뉴 바로 아래 한 줄. 잘못한 것이 아니라 남은 한 걸음이라 경고색을 쓰지 않는다 */
  studioHint: "[margin:0] [color:var(--louis-color-fg-secondary)]",
  /* 판 목록 제목은 두 줄까지 접는다 — 썸네일과 체크박스가 폭을 먹어 한 줄 말줄임이면 후보 제목이 절반에서 끊긴다.
     운영 리뷰 목록도 두 줄로 접힌다. 한국어는 어절에서 넘긴다 */
  studioRowTitle: [
    "[white-space:normal]",
    "[display:-webkit-box]",
    "[-webkit-box-orient:vertical]",
    "[-webkit-line-clamp:2]",
    "[word-break:keep-all]",
  ].join(" "),
  /* 안내가 두 문장이면 문장마다 줄을 나눈다 */
  studioStageBarLine: "[display:block]",
  /* 무대에 오른 칸의 행동이 실패한 한 줄(숏폼 만들기 · 삭제) — 막대 안에서 제 줄을 받는다. 실패할 때만 서므로 칸을
     오가도 무대 높이가 그대로라는 막대의 약속은 평소에 지켜진다 */
  studioStageBarError: [
    "[flex-basis:100%]",
    "[margin:0]",
    "[padding:0_8px_4px]",
    "[color:var(--louis-color-fg-danger)]",
  ].join(" "),
  /* 판 인스펙터 맨 위 알림(LOUIS alert) — 분석하지 못한 구간, 추출 실패 */
  studioNotices: "[display:flex] [flex-direction:column] [gap:8px]",

  studioMuted: "[margin:0] [color:var(--louis-color-fg-tertiary)]",
  /* 폰 판에서는 아래 행동 줄(`studioFooter`)이 같은 행동을 든다 — 엄지가 닿는 자리, 시작 화면의 「분석 시작」과 같은 자리다 */
  studioChromeActions: [
    "[display:inline-flex]",
    "[align-items:center]",
    "[gap:8px]",
    "[flex-shrink:0]",
    "[@media(max-width:900px)_and_(min-height:560px)]:[display:none]",
  ].join(" "),
  /* 폰의 상단 바에는 행동 하나만 선다 — 둘이면 제목을 밀고 화면 밖으로 넘친다(390 에서 「클립 추출」이 잘렸다).
     판에서 추출할 후보가 있으면 보조인 「전체 다운로드」를 이 폭에서 접고, 후보가 없을 때 다시 선다 */
  studioChromeSecondaryWide: "[@media(max-width:719px)]:[display:none]",
  /* 기록이 없는 허브의 빈 상태 — 캔버스 · 컴포지션 허브처럼 머리 아래 한가운데 */
  hubEmpty: "[margin:64px_auto_0] [max-width:480px]",
  /* source lines 401, 402, 403, 511, 512, 513, 514, 516, 518, 520, 522, 527, 531 */
  uploadGlyphMask: [
    "tw-hs-192",
    "[display:inline-block]",
    "[width:56px]",
    "[height:56px]",
    "[background-color:var(--palette-gray-500)]",
    "[mask-image:var(--upload-glyph-mask)]",
    "[mask-repeat:no-repeat]",
    "[mask-position:center]",
    "[mask-size:contain]",
    "[html[data-theme=light]_&]:[background-color:var(--palette-gray-800)]",
    "[html[data-theme=dark]_&]:[background-color:var(--palette-gray-100)]",
  ].join(" "),
};

export default styles;
