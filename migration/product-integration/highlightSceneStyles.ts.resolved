    /* 칸이 잠긴 동안(다시 올릴 준비)은 hover 밝기도 없다 */
    "[.group[aria-disabled=true]_&]:[filter:none]!",
  ].join(" "),
  /* 분석 설정 — 컴포지션 속성 패널 자리. 올라온 면 + 헤어라인, 칸이 넘치면 자기 안에서 구른다 */
  studioInspector: [
    "[grid-column:2]",
    "[grid-row:1]",
    "[min-height:0]",
    "[overflow-y:auto]",
    "[display:flex]",
    "[flex-direction:column]",
    "[gap:20px]",
    "[padding:16px]",
    "[box-sizing:border-box]",
    "[border-radius:var(--louis-radius-card)]",
    "[background:var(--louis-color-bg-raised)]",
    "[box-shadow:var(--louis-hairline-inset)]",
    "[@media(max-width:900px)]:[grid-column:1]",
    "[@media(max-width:900px)]:[grid-row:auto]",
    "[@media(max-width:900px)]:[overflow-y:visible]",
    /* 쌓인 배치에서는 칸이 제 내용만큼 자라야 한다 — `min-height:0` 이면 행이 줄어 아래 칸이 위를 덮는다 */
    "[@media(max-width:900px)]:[min-height:auto]",
    /* 좁은 화면(≤900)의 인스펙터 컨트롤은 손가락 크기로 — 시작 화면 설정(Select, 「파일 바꾸기」)과 낮은 화면(가로
       폰)의 판 목록 토글(정렬, 클립과 후보 탭). sm 24 는 칸이 20 이 된다. 폰 판의 판 목록은 시트가 같은 값을 갖는다 */
    "[@media(max-width:900px)]:[--louis-layout-control-height-sm:36px]",
    "[@media(max-width:900px)]:[--louis-layout-control-height-md:40px]",
    "[@media(max-width:900px)]:[--louis-layout-settings-segment-height:36px]",
  ].join(" "),
  /* ── 폰 판 ── 좁고 충분히 높은 화면(≤900, 높이 ≥560). 데스크톱의 세 칸을 쌓지 않고 폰에서 하는 일(후보를 하나씩 보고
     넣을지 정한 뒤 추출)에 맞춰 다시 짠다 — 무대, 막대, 트랙(후보를 고르는 길), 지금 칸의 설명, 화면 아래 행동 줄.
     전체 목록은 아래에서 올라오는 시트다. 판이 한 화면에 들어서 무엇도 붙이지 않는다. 낮은 화면(가로 폰)은 예전처럼
     쌓는다. 판은 CSS 로 가른다 — 스크립트로 고르면 첫 그리기에 다른 판이 보인다 */
  /* 폰 판에서 빠지는 것 — 판의 인스펙터(목록은 시트로), 시작 화면 설정 끝의 「분석 시작」(아래 행동 줄이 같은 버튼을
     든다) */
  studioPhoneHidden: "[@media(max-width:900px)_and_(min-height:560px)]:[display:none]",
  /* 지금 칸의 설명 — 데스크톱 인스펙터 받침(선정 이유)과 목록 행의 제목, 자리를 무대 쪽으로 모은다. 인스펙터와 같은
     면(올라온 면 + 헤어라인) */
  studioPhoneDetails: [
    "[display:none]",
    "[@media(max-width:900px)_and_(min-height:560px)]:[display:flex]",
    "[flex-direction:column]",
    "[gap:16px]",
    "[padding:16px]",
    "[box-sizing:border-box]",
    "[min-width:0]",
    "[border-radius:var(--louis-radius-card)]",
    "[background:var(--louis-color-bg-raised)]",
