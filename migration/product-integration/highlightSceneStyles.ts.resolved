    "[&[aria-disabled=true]]:[cursor:progress]",
    "[&_.tw-hs-192]:[background-color:rgb(var(--palette-gray-000-rgb)/88%)]!",
  ].join(" "),
  studioStageTitle: "[margin-top:6px] [color:var(--palette-gray-000)]",
  studioStageNote: [
