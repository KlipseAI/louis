    "[white-space:pre-line]",
    "[word-break:keep-all]",
  ].join(" "),
  /* 칸 안의 「파일 선택」 — 누름은 칸이 받는다. primary 의 hover 는 면이 아니라 밝기다(LOUIS Button) */
  studioStageButton: [
    "[pointer-events:none]",
    "[margin-top:10px]",
