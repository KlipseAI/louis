    "[color:var(--louis-color-fg-secondary)]",
    "[font-variant-numeric:tabular-nums]",
  ].join(" "),
  /* 판의 알림(분석하지 못한 구간, 추출 실패) — 폰 판에서는 목록이 시트로 가므로 설명 위에 따로 선다 */
  studioPhoneNotices: [
    "[display:none]",
    "[@media(max-width:900px)_and_(min-height:560px)]:[display:flex]",
    "[flex-direction:column]",
    "[gap:8px]",
  ].join(" "),
  /* 화면 아래 행동 줄 — 본문(`studioMain`) 밖, 패널의 마지막 칸이라 구르지 않고 내용을 덮지 않는다. 시작 화면의
     「분석 시작」, 판의 「목록 보기」와 「클립 추출」(또는 「전체 다운로드」). 넓은 화면과 낮은 화면에서는 서지 않는다 —
     그 판의 행동은 상단 바와 인스펙터가 갖는다. 버튼은 손가락 크기(40) */
  studioFooter: [
    "[display:none]",
    "[@media(max-width:900px)_and_(min-height:560px)]:[display:flex]",
    "[flex:none]",
    "[align-items:center]",
    "[gap:8px]",
    "[padding-top:12px]",
    "[padding-bottom:calc(12px_+_env(safe-area-inset-bottom,_0px))]",
    /* 세로 태블릿과 좁은 창(820 안팎)에서 버튼이 화면 폭만큼 늘지 않게 가운데 560 안에 둔다 */
    "[padding-inline:max(16px,_calc((100%_-_560px)_/_2))]",
    "[box-sizing:border-box]",
    "[background:var(--louis-color-bg-raised)]",
    "[box-shadow:inset_0_1px_0_var(--louis-color-stroke-default)]",
    "[--louis-layout-control-height-md:40px]",
  ].join(" "),
  /* 행동 줄에서 남는 폭을 받는 버튼 — 주 행동, 또는 혼자 선 버튼 */
  studioFooterGrow: "[flex:1_1_auto] [min-width:0]",
  /* 구간 목록 시트(LOUIS 대화창 sheet 변형) — 화면 위쪽은 남겨 시트인 것이 보이게 하고, 아래는 홈 표시줄만큼 비운다.
     목록의 토글은 인스펙터처럼 손가락 크기 */
  studioListSheetSurface: [
    "[max-block-size:min(85svh,_calc(100svh_-_48px))]",
    /* 첫 초점을 받는 판이다(누를 것이 아니다) — 링을 그리지 않는다 */
