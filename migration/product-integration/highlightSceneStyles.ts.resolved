  /* 표면은 LOUIS `.louis-toast` 가 소유한다(패딩 12/20 · 반경 16 · 글자색 fg-on-inverse —
     전부 제품 실측값과 같다). 아래는 제품이 계속 소유하는 유틸리티다:
       · 위치·스택·등장 애니메이션 — 레시피의 `.louis-toast-viewport` 는 쓰지 않는다.
       · 면 색 — 레시피는 순수 흑/백 70%, 제품은 gray-800 / gray-200 70% 다.
       · 그림자 — 레시피는 검정 고정, 제품은 다크에서 밝은 후광으로 뒤집힌다.
       · `backdrop-filter` 10px — 레시피는 16px+saturate 다. 이 화면의 현재 값을 유지한다.
       · `max-inline-size` 해제 — 420px 상한은 제품에 없고 본문이 `nowrap` 이라 넘친다. */
  toast: [
    "tw-hs-182",
    "louis-toast",
    "[position:fixed]",
    "[bottom:32px]",
    "[left:50%]",
    "[transform:translateX(-50%)]",
    "[z-index:1300]",
    "[max-inline-size:none]",
    "backdrop-blur-surface",
    "[box-shadow:0_8px_20px_rgb(var(--gray-1000-rgb)_/_16%)]",
    "[animation:highlightToastIn_280ms_ease]",
    "[html[data-theme=light]_&]:[background:rgb(var(--palette-gray-800-rgb)_/_72%)]",
    "[html[data-theme=dark]_&]:[background:rgb(var(--palette-gray-200-rgb)_/_72%)]",
  ].join(" "),
  /* source lines 3866 */
  toastClosing: [
    "tw-hs-183",
    "[animation:highlightToastOut_280ms_ease_forwards]",
  ].join(" "),
  /* source lines 3870, 3874, 3878 */
  /* 글자색은 `.louis-toast` 의 `--louis-color-fg-on-inverse` 를 상속받는다 — 제품의
     palette-gray-000 / palette-gray-900 과 같은 값이라 테마 규칙 두 줄을 지웠다. */
  toastText: [
    "tw-hs-184",
    "[white-space:nowrap]",
  ].join(" "),
  /* ── 「새 하이라이트」 스튜디오(`/highlight/new`) ────────────────────────────────────────────────────
     사용자 결정: 캔버스 · 컴포지션처럼 하이라이트만의 풀화면 작업 화면. 셸(페이지 · 패널 · 본문)은 컴포지션
     편집기(`app/videoeditor/[projectId]/EditorProjectWorkspace.tsx` 의 `PAGE` · `PANEL` · `MAIN`)와 같은 값이고,
     안쪽은 무대 · 분석 설정 · 하이라이트 트랙 세 칸이다. 칸 안의 부품(인스펙터 머리 · 행, Select, Button)은
     LOUIS 레시피가 소유한다 — 여기 있는 것은 배치와 무대 · 트랙의 면뿐이다. */
  /* 상단 바(`variant="create"`)가 화면 맨 위를 `fixed` 로 덮으므로 그 높이 48 만큼 비킨다(컴포지션 `PAGE`) */
  studioPage: [
    "[position:relative]",
    "[display:flex]",
    "[flex-direction:column]",
    "[overflow:hidden]",
    "[box-sizing:border-box]",
    "[min-height:100dvh]",
    "[height:100dvh]",
    "[max-height:100dvh]",
    "[padding-top:48px]",
    "[padding-bottom:0]",
  ].join(" "),
  studioPanel: [
    "appMainCardChromeSurface",
    "[display:flex]",
    "[flex-direction:column]",
    "[flex:1_1_auto]",
    "[min-height:0]",
    "[min-width:0]",
    "[margin:0]",
    "[border-radius:0]",
    "[overflow:hidden]!",
  ].join(" "),
  studioMain: [
    "[position:relative]",
    "[display:flex]",
    "[flex-direction:column]",
    "[flex:1_1_auto]",
    "[min-height:0]",
    "[min-width:0]",
    "[box-sizing:border-box]",
    "[padding:0]",
    "[overflow:hidden]",
