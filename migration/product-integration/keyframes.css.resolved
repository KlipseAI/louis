/* 랜딩 후기의 줄 등장 — `components/landing/sections/Testimonials.tsx`. 줄이 아래에서 한 줄씩
   떠오른다. 함께 있던 가사 스윕(`testimonialLyricSweep`)은 소유자 지시로 걷었다(2026-09-21). */
@keyframes testimonialLineRise {
  from {
    opacity: 0;
    translate: 0 0.5em;
  }
  to {
    opacity: 1;
    translate: 0 0;
  }
}

/* Hero.tsx — 랜딩 히어로 타이틀 등장. **toss.im 실측에서 온 값이다.**
 * 토스의 「자산을 관리하는 일은 / 한껏 단순하게」 타이틀(`h2._5jkbx01`)은 CSS 가 아니라
 * JS 인라인 스타일로 움직이고, 시작·끝 값이 정확히 이렇다:
 *     opacity: 0 · transform: translateY(16px)  →  opacity: 1 · transform: translateY(0px)
 * (같은 컴포넌트가 페이지 전체에 87곳 있고 전부 같은 서명이다. blur 은 양끝 모두 0 이라
 *  실제로 움직이지 않는다 — 서명에 있다고 넣지 마라.)
 *
 * 곡선은 **스프링**이다. 형제 넷이 100ms 씩 스태거되는 자리에서 프레임 단위로 재 보니
 * 120px 변형이 100ms 에 43% 를 갔고, 초반이 선형에 가깝다가 부드럽게 잦아든다 — 베지어
 * 하나로는 정확히 못 맞춘다. `cubic-bezier(0,0,0.2,1)` 600ms 가 그 형태의 근사다. */
@keyframes landingHeroTitleRise {
  from {
    opacity: 0;
    transform: translateY(16px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

/* Gnb.tsx(랜딩) — 전폭 메가 시트의 항목 등장. **toss.im 실측값이다.**
 * 상단 내비 「서비스」 위에 실제 마우스를 올려 style 속성 변화를 프레임 단위로 받아 보니,
 * 항목의 시작·끝 값이 정확히 이렇다:
 *     opacity:0 · filter:blur(10px) · transform:translateY(-10px)
 *   → opacity:1 · filter:blur(0px)  · transform:translateY(0)
 * **위에서 아래로 내려오고, 흐릿하게 들어온다.** 히어로 타이틀(`landingHeroTitleRise`)이
 * 아래에서 16px 올라오는 것과 방향도 거리도 블러 유무도 다르다 — 둘을 섞지 마라.
 *
 * 시작 시각이 31 → 96·96 → 133·133·133 → 179×4 로 **대각선 웨이브**다(열+행이 같은 항목끼리
 * 함께 뜬다). 계단 간격은 45~65ms 이고 45ms 를 쓴다.
 *
 * 토스는 transform 만 스프링으로 굴리고 opacity·blur 은 끝에서 한 번에 뒤집는다
 * (`transition-duration: 0s` 이라 CSS 전환이 아니다). 그대로 하면 내려오는 동안 아무것도
 * 안 보이므로, 여기서는 셋을 함께 400ms 로 굴린다 — 보이는 결과는 같고 과정이 더 읽힌다.
 *
 * 시작 거리·흐림은 `--menu-drop-y`·`--menu-drop-blur` 로 호출부(`Gnb.tsx`)가 넘긴다.
 * 여기 리터럴로 적으면 `10px` 이 `--louis-blur-surface`(같은 값, **다른 뜻** — 카드 면의
 * 흐림이다)와 충돌한 것으로 잡힌다. 값이 같다고 이름을 빌리지 않는다(DS-D-0029). */
@keyframes landingMenuItemDrop {
  from {
    opacity: 0;
    filter: blur(var(--menu-drop-blur));
    transform: translateY(var(--menu-drop-y));
  }
  to {
    opacity: 1;
    filter: blur(0);
    transform: translateY(0);
  }
}

/* Gnb.tsx — 모바일 메뉴의 단계 이동. Apple 모바일 글로벌 내비의 `globalnav-flyout-slide-*`
 * 네 키프레임과 같은 값이다: 거리 8px, 나가는 쪽 0ms · 들어오는 쪽 160ms 지연, 둘 다 240ms.
 * 들어가기(forward)는 1단계가 왼쪽으로 나가고 2단계가 오른쪽에서 들어온다. 뒤로(back)는 거꾸로다.
 * `VideoEditProjectPicker` 의 `drillSlideFwd`·`drillSlideBack`(36px, 들어오는 쪽만)과는 다른 움직임이다. */
@keyframes gnbDrillForwardOut {
  from {
    opacity: 1;
    transform: translateX(0);
  }
  to {
    opacity: 0;
    transform: translateX(-8px);
  }
}

@keyframes gnbDrillForwardIn {
  from {
    opacity: 0;
    transform: translateX(8px);
  }
  to {
    opacity: 1;
    transform: translateX(0);
  }
}

@keyframes gnbDrillBackOut {
  from {
    opacity: 1;
    transform: translateX(0);
  }
  to {
    opacity: 0;
    transform: translateX(8px);
  }
}

@keyframes gnbDrillBackIn {
  from {
    opacity: 0;
    transform: translateX(-8px);
  }
  to {
    opacity: 1;
    transform: translateX(0);
  }
}

/* 설문(`components/analytics/ResearchOnboarding.tsx`)의 나타남 — 랜딩 개편의 리빌과 같은 모양이다. 흐릿한
 * 채 24px 아래에서 떠올라 또렷해진다(랜딩 히어로 문구 값, 토스 섹션 문구 값). 길이 · 가감속 · 지연은 쓰는
 * 쪽이 준다(`REVEAL`).
 *
 * `translate` 가 아니라 `transform` 을 움직인다 — 완료 화면 카드가 `translate` · `rotate` 로 자리를 잡는다.
 * 끝 칸(`to`)을 두지 않는다 — 요소 자신의 값으로 끝나고, 쓰는 쪽이 `backwards` 로만 채워 끝난 뒤에는
 * 애니메이션이 아무 값도 붙들지 않는다. `both` 로 채우면 끝 칸의 `transform` · `opacity` 가 남아 버튼의
 * 누름 · 비활성 표현을 덮는다. 흐림은 `--reveal-blur` 로 받는다 — 리터럴 16px 은 LOUIS `blur-glass`(유리
 * 면의 흐림, 다른 뜻)와 같은 값이라 게이트가 잡는다. */
@keyframes surveyReveal {
  from {
    opacity: 0;
    filter: blur(var(--reveal-blur));
    transform: translateY(24px);
  }
}

/* ModelShowcase.tsx — 지금 모델 행 아래 선이 다음 모델까지 남은 시간을 채운다. 선이 다 차는 순간(animationend)이
 * 다음 모델로 넘어가는 신호다. */
@keyframes modelShowcaseProgress {
  from {
    transform: scaleX(0);
  }
  to {
    transform: scaleX(1);
  }
}

/* ModelShowcase.tsx — 무대 위 모델명 · 설명이 바뀔 때. 흐릿하게 12px 아래에서 떠올라 또렷해진다. 끝 칸을 두지 않아
 * 끝난 뒤에는 요소 자신의 값으로 남는다. */
@keyframes modelShowcaseCopy {
  from {
    opacity: 0;
    filter: blur(6px);
    transform: translateY(12px);
  }
}

/* Hero.tsx — 히어로 문구가 첫 페인트와 함께 흐릿한 채 24px 아래에서 떠오른다. 끝 칸을 두지 않아 끝난 뒤에는 요소 자신의
 * 값(보임)으로 남는다 — 퇴장 전환이 그 값에서 출발한다. 흐림은 요소가 든 `--hero-text-blur` 를 읽는다.
 *
 * **시작 불투명도가 0 이 아니라 0.01 이다.** Chrome 은 자기 불투명도가 0 인 채로 처음 그려진 글자를 LCP 로 세지 않다가
 * 애니메이션이 끝나 스타일이 바뀔 때에야 센다 — 헤드라인이 첫 페인트에 떠오르기 시작해도 LCP 는 800ms 뒤 끝난 순간(실측
 * 1,172ms)으로 잡혔다. 0.01 은 16px 흐림 아래에서 눈에 보이지 않고, Chrome 은 첫 페인트를 센다(헤드리스 실측 2026-09-30). */
@keyframes heroTextEnter {
  from {
    opacity: 0.01;
    translate: 0 24px;
    filter: blur(var(--hero-text-blur));
  }
}

/* 앰버서더 지원서 — 질문이 넘어갈 때 다음 질문이 아래(앞으로) 또는 위(뒤로)에서 흐림을 풀며 들어온다.
   방향은 요소의 `--amb-dir`(1 앞으로, −1 뒤로), 없으면 앞으로. `components/landing/sections/ambassador/ApplyFlow.tsx`. */
@keyframes amb-question-in {
  from {
    opacity: 0;
    translate: 0 calc(var(--amb-dir, 1) * 28px);
    filter: blur(var(--louis-blur-header));
  }
  to {
    opacity: 1;
    translate: 0 0;
    filter: blur(0);
  }
}
