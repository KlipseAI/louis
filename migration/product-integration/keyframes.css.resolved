    opacity: 1;
    transform: translateY(0);
  }
}

@keyframes highlightToastIn {
  from {
    opacity: 0;
    transform: translateX(-50%) translateY(10px);
  }
  to {
    opacity: 1;
    transform: translateX(-50%) translateY(0);
  }
}

@keyframes highlightToastOut {
