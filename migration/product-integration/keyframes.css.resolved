/* HighlightTransition.module.css */
@keyframes zoomOverlayFade {
  from { background: rgb(0 0 0 / 0%); }
  to { background: rgb(0 0 0 / 28%); }
  }

/* HighlightTransition.module.css */
@keyframes zoomInExpand {
  to {
  top: 0;
  left: 0;
  width: 100vw;
  height: 100vh;
  border-radius: 0;
  filter: blur(40px);
  }
  }

/* HighlightTransition.module.css */
@keyframes bgZoomOut {
  from {
  opacity: 1;
  transform: scale(1);
  }
  to {
  opacity: 0;
  transform: scale(0.8);
  }
  }

/* HighlightTransition.module.css */
/* `10px` 에 `--louis-blur-surface` 라는 이름이 있지만 붙이지 않는다 — 그 이름은 표면 뒤를
   흐리는 `backdrop-filter` 의 것이고 여기는 배경 이미지 자신의 `filter` 다. 짝이 되는 시작값
   `40px` 에는 이름이 없어, 한 끝만 옮기면 곡선이 두 곳으로 갈린다. */
@keyframes bgImgZoomOut {
  from { filter: blur(40px) saturate(1.2); }
  to { filter: blur(10px) saturate(1); }
  }

