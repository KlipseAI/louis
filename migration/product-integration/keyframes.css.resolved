/* ── batch11: app/page.module.css · Gnb.module.css 에서 끌어올린 것 ────────────── */

/* app/page.module.css 의 `overviewChipConverge` */
@keyframes overviewChipConverge {
  0% {
    transform: translate3d(0, 0, 0) scale(1);
    filter: brightness(1) saturate(1);
  }
  100% {
    transform: translate3d(var(--cx), var(--cy), 0) scale(1);
    filter: brightness(3) saturate(0);
  }
}


/* app/page.module.css 의 `overviewSymbolEmerge` */
@keyframes overviewSymbolEmerge {
  0% {
    opacity: 0;
  }
  100% {
    opacity: 1;
  }
}


/* app/page.module.css 의 `overviewSymbolShift` — ef17c358(랜딩 셸 전환)에서 유실.
   BEAT 3: 심볼만 좌측 이동 + 25% 축소. 칩은 이 시점(3180ms) 이전에 페이드아웃돼 있어
   함께 이동시키지 않는다. --lockup-shift 는 HomePageClient 가 공급(56px / ≤788px 42px).

   ⚠ 원본에는 translateY 가 없어 `data-merge=done` / `motion-reduce` 의 상승량과
   어긋났다(애니메이션이 죽어 있어 드러나지 않았다). 세 곳 모두 --lockup-symbol-rise 로
   묶어 심볼이 워드마크 박스 중앙이 아니라 K 의 세로 중앙에 서게 한다. */
@keyframes overviewSymbolShift {
  to {
    transform: translateX(calc(-1 * var(--lockup-shift)))
      translateY(calc(-1 * var(--lockup-symbol-rise))) scale(0.75);
  }
}

/* app/page.module.css 의 `overviewChipFade` — ef17c358 에서 함께 유실. */
@keyframes overviewChipFade {
  to {
    opacity: 0;
  }
}

/* app/page.module.css 의 `overviewSymbolGlint` */
@keyframes overviewSymbolGlint {
  0% {
    opacity: 0;
    background-position: 150% 0;
  }
  18% {
    opacity: 1;
  }
  82% {
    opacity: 1;
  }
  100% {
    opacity: 0;
    background-position: -50% 0;
  }
}


/* app/page.module.css 의 `overviewWordmarkIn` */
@keyframes overviewWordmarkIn {
  0% {
    opacity: 0;
    transform: translateX(var(--lockup-shift)) scale(1.2);
  }
  100% {
    opacity: 1;
    transform: translateX(0) scale(1);
  }
}


/* app/page.module.css 의 `overviewBgReveal` */
@keyframes overviewBgReveal {
  to {
    background-color: var(--palette-gray-000);
  }
}


/* components/navigation/Gnb.module.css 의 `projectSaveCloudUploadNudge` */
@keyframes projectSaveCloudUploadNudge {
  0%,
  100% {
    opacity: 1;
    transform: translateY(0);
  }

  50% {
    opacity: 0.88;
    transform: translateY(-1.5px);
  }
}




@keyframes mobileMenuFadeIn {
  from {
    opacity: 0;
  }

  to {
    opacity: 1;
  }
}

@keyframes mobileMenuPanelIn {
