/* ─────────────────────────────────────────────────────────────────────────────
 * 전역 @keyframes — Tailwind 전환용
 *
 * CSS Modules 는 `@keyframes` 이름을 **파일별로 격리**한다. 그래서 같은 이름이 여러 파일에
 * 서로 다른 본문으로 존재해도 충돌하지 않는다(저장소 전체로 보면 `toastIn` 이 7곳에
 * 각기 다른 본문으로 있다). 유틸리티로 옮기면 그 격리가 사라지므로, 여기로 끌어올릴 때는
 * **이름 충돌을 반드시 확인**해야 한다.
 *
 * 아래 117개는 옮길 때 전수 대조해 충돌이 없음을 확인한 것들이다.
 * 앞으로 추가할 때도 같은 이름이 이미 있으면 본문을 비교하고, 다르면 네임스페이스를 붙여라
 * (예: `videoEditModalToastIn`).
 *
 * 컴포넌트에서는 임의값으로 참조한다 — 지속시간·이징이 규칙마다 다르므로 `@theme` 의
 * `--animate-*` 로 한 조합만 고정하지 않는다:
 *   className="animate-[popoverOpen_130ms_ease-out_forwards]"
 * ───────────────────────────────────────────────────────────────────────────── */

/* CommandPalette.module.css */
@keyframes cmdSubmenuPopIn {
  0% {
  opacity: 0;
  transform: translateY(-4px);
  }
  100% {
  opacity: 1;
  transform: translateY(0);
  }
  }

/* CommandPalette.module.css */
@keyframes cmdLabelMarquee {
  0%,
  12% {
  transform: translateX(0);
  }
  88%,
  100% {
  transform: translateX(calc(var(--cmd-label-w, 0px) - 100% - 4px));
  }
  }

/* YoutubeUploadModal.module.css */
@keyframes yt-upload-spin {
  to {
  transform: rotate(360deg);
  }
  }


/* VideoPlayer.module.css */
