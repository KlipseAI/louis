{
  "name": "klipse-design-system",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Klipse의 독립 디자인 시스템 모노레포",
  "scripts": {
    "build": "pnpm run build:tokens && pnpm run build:icons && pnpm run build:css && pnpm run build:react && pnpm run build:docs",
    "build-tokens": "node ./scripts/build-tokens.mjs",
    "check-tokens": "node ./scripts/build-tokens.mjs --check",
    "diff-tokens": "node ./scripts/diff-tokens.mjs",
    "check-token-diff": "node ./scripts/diff-tokens.mjs --fail-on-breaking",
    "verify-token-gates": "node ./scripts/verify-token-gates.mjs",
    "build-icons": "node ./scripts/build-icons.mjs",
    "check-icons": "node ./scripts/build-icons.mjs --check",
    "verify-icon-gates": "node ./scripts/verify-icon-gates.mjs",
    "build-css": "node ./scripts/build-css.mjs",
    "build-react": "pnpm --filter @klipse-design/react run build",
    "check-css": "node ./scripts/build-css.mjs --check",
    "build-design-docs": "node ./scripts/build-design-docs.mjs",
    "check-design-docs": "node ./scripts/build-design-docs.mjs --check",
    "build-llms-docs": "node ./scripts/build-llms-docs.mjs",
    "check-llms-docs": "node ./scripts/build-llms-docs.mjs --check",
    "verify-gates": "node ./scripts/verify-gates.mjs",
    "verify-css-gates": "node ./scripts/verify-css-gates.mjs",
    "build-figma-snapshot": "node ./scripts/build-figma-snapshot.mjs",
    "check-figma-snapshot": "node ./scripts/build-figma-snapshot.mjs --check",
    "verify-figma-parity": "node ./scripts/verify-figma-parity.mjs",
    "figma-live-check": "node ./scripts/figma-live-check.mjs",
    "build-figma-variables": "node ./scripts/build-figma-variables.mjs",
    "verify-figma-variables": "node ./scripts/build-figma-variables.mjs --check",
    "build-figma-styles": "node ./scripts/build-figma-styles.mjs",
    "verify-figma-styles": "node ./scripts/build-figma-styles.mjs --check",
    "figma:sync": "node --env-file-if-exists=.env ./scripts/figma-sync.mjs sync",
    "figma:fetch": "node --env-file-if-exists=.env ./scripts/figma-sync.mjs fetch",
    "figma:audit": "node --env-file-if-exists=.env ./scripts/figma-sync.mjs audit",
    "verify-test-harness": "node ./scripts/verify-test-harness.mjs",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json",
    "build:tokens": "pnpm run build-tokens",
    "build:icons": "pnpm run build-icons",
    "build:css": "pnpm run build-css && pnpm run build-tailwind-theme",
    "build:react": "pnpm run build-react",
    "build:catalog": "pnpm run build-design-docs",
    "build:llms": "pnpm run build-llms-docs",
    "build:docs": "pnpm run build:catalog && pnpm run build:llms && pnpm run build-figma-summaries",
    "check:tokens": "pnpm run check-tokens",
    "check:icons": "pnpm run check-icons",
    "check:css": "pnpm run check-css && pnpm run check-tailwind-theme",
    "check:catalog": "pnpm run check-design-docs && pnpm run check-figma-summaries",
    "check:llms": "pnpm run check-llms-docs",
    "check": "pnpm run check:tokens && pnpm run check:icons && pnpm run check:css && pnpm run check:catalog && pnpm run check:llms && pnpm run verify-record-citations && pnpm run typecheck",
    "verify": "pnpm run verify:ci && pnpm run verify:product",
    "verify:ci": "pnpm run verify-gate-split && pnpm run verify-doc-paths && pnpm run verify-gates:ci && pnpm run verify-token-gates && pnpm run verify-css-gates && pnpm run verify-icon-gates && pnpm run check-token-diff && pnpm run check-figma-snapshot && pnpm run verify-figma-parity && pnpm run verify-figma-variables && pnpm run verify-figma-styles && pnpm run check-figma-app-screens && pnpm run verify-consumer && pnpm run verify-test-harness && pnpm run verify-product-parity && pnpm run verify-product-anchor",
    "verify:product": "pnpm run verify-gates && pnpm run verify-citations && pnpm run verify-refutation-quotes && pnpm run verify-product-alpha && pnpm run verify-alpha-consolidation && pnpm run verify-product-drift && pnpm run verify-app-nav-labels && pnpm run verify-product-evidence && pnpm run verify-product-render && pnpm run verify-product-components && pnpm run verify-product-variants && pnpm run verify-product-scenes && pnpm run verify-product-auth-fixture && pnpm run verify-product-sidebar-states && pnpm run verify-specimen-context && pnpm run check-figma-inventory && pnpm run check-figma-product-components && pnpm run check-figma-product-app-shell && pnpm run check-figma-product-sidebar-states && pnpm run check-figma-product-payment-scenes && pnpm run check-figma-product-checkout-status && pnpm run check-figma-product-upgrade-scene && pnpm run check-figma-product-pricing-page && pnpm run check-figma-product-highlight-hub && pnpm run verify-tailwind-interop",
    "verify-gate-split": "node ./scripts/verify-gate-split.mjs",
    "verify-product-anchor": "node ./scripts/verify-product-anchor.mjs",
    "verify-product-parity": "node ./scripts/verify-product-parity.mjs",
    "build-tailwind-theme": "node ./scripts/build-tailwind-theme.mjs",
    "check-tailwind-theme": "node ./scripts/build-tailwind-theme.mjs --check",
    "verify-consumer": "node ./scripts/verify-consumer.mjs",
    "build-figma-summaries": "node ./scripts/build-figma-summaries.mjs",
    "check-figma-summaries": "node ./scripts/build-figma-summaries.mjs --check",
    "build-product-evidence": "node ./scripts/build-product-evidence.mjs",
    "verify-product-evidence": "node ./scripts/verify-product-evidence.mjs",
    "verify-citations": "node ./scripts/verify-citations.mjs",
    "verify-doc-paths": "node ./scripts/verify-doc-paths.mjs",
    "verify-refutation-quotes": "node ./scripts/verify-refutation-quotes.mjs",
    "measure-product-alpha": "node ./scripts/measure-product-alpha.mjs",
    "verify-product-alpha": "node ./scripts/measure-product-alpha.mjs --check",
    "build-alpha-consolidation": "node ./scripts/build-alpha-consolidation.mjs",
    "verify-alpha-consolidation": "node ./scripts/build-alpha-consolidation.mjs --check",
    "measure-product-drift": "node ./scripts/measure-product-drift.mjs",
    "verify-product-drift": "node ./scripts/measure-product-drift.mjs --check",
    "verify-app-nav-labels": "node ./scripts/measure-app-nav-labels.mjs --check",
    "measure-product-render": "node ./scripts/measure-product-render.mjs",
    "verify-product-render": "node ./scripts/measure-product-render.mjs --check",
    "verify-tailwind-interop": "node ./scripts/verify-tailwind-interop.mjs",
    "measure-product-components": "node ./scripts/measure-product-components.mjs",
    "verify-product-components": "node ./scripts/measure-product-components.mjs --check",
    "measure-product-scenes": "node ./scripts/measure-product-scenes.mjs",
    "verify-product-scenes": "node ./scripts/measure-product-scenes.mjs --check",
    "measure-product-auth-fixture": "node ./scripts/measure-product-auth-fixture.mjs",
    "verify-product-auth-fixture": "node ./scripts/measure-product-auth-fixture.mjs --check",
    "measure-product-sidebar-states": "node ./scripts/measure-product-sidebar-states.mjs",
    "verify-product-sidebar-states": "node ./scripts/measure-product-sidebar-states.mjs --check",
    "verify-product-variants": "node ./scripts/measure-product-variants.mjs --check",
    "verify-specimen-context": "node ./scripts/verify-specimen-context.mjs",
    "build-figma-inventory": "node ./scripts/build-figma-inventory.mjs",
    "check-figma-inventory": "node ./scripts/build-figma-inventory.mjs --check",
    "build-figma-app-screens": "node ./scripts/build-figma-app-screens.mjs",
    "check-figma-app-screens": "node ./scripts/build-figma-app-screens.mjs --check",
    "build-figma-product-components": "node ./scripts/build-figma-product-components.mjs",
    "check-figma-product-components": "node ./scripts/build-figma-product-components.mjs --check",
    "build-figma-product-app-shell": "node ./scripts/build-figma-product-app-shell.mjs",
    "check-figma-product-app-shell": "node ./scripts/build-figma-product-app-shell.mjs --check",
    "build-figma-product-sidebar-states": "node ./scripts/build-figma-product-sidebar-states.mjs",
    "check-figma-product-sidebar-states": "node ./scripts/build-figma-product-sidebar-states.mjs --check",
    "build-figma-product-payment-scenes": "node ./scripts/build-figma-product-payment-scenes.mjs",
    "check-figma-product-payment-scenes": "node ./scripts/build-figma-product-payment-scenes.mjs --check",
    "build-figma-product-checkout-status": "node ./scripts/build-figma-product-checkout-status.mjs",
    "check-figma-product-checkout-status": "node ./scripts/build-figma-product-checkout-status.mjs --check",
    "build-figma-product-upgrade-scene": "node ./scripts/build-figma-product-upgrade-scene.mjs",
    "check-figma-product-upgrade-scene": "node ./scripts/build-figma-product-upgrade-scene.mjs --check",
    "build-figma-product-pricing-page": "node ./scripts/build-figma-product-pricing-page.mjs",
    "check-figma-product-pricing-page": "node ./scripts/build-figma-product-pricing-page.mjs --check",
    "build-figma-product-highlight-hub": "node ./scripts/build-figma-product-highlight-hub.mjs",
    "check-figma-product-highlight-hub": "node ./scripts/build-figma-product-highlight-hub.mjs --check",
    "verify-gates:ci": "node ./scripts/verify-gates.mjs --no-product",
    "clean-room": "node ./scripts/verify-clean-room.mjs",
    "verify-record-citations": "node ./scripts/verify-record-citations.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.30.2",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "devDependencies": {
    "@klipse-design/css": "workspace:*",
    "@klipse-design/react": "workspace:*",
    "@klipse-design/tokens": "workspace:*",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitest/browser-playwright": "^4.1.10",
    "axe-core": "^4.13.0",
    "esbuild": "0.28.2",
    "playwright": "^1.62.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "typescript": "~5.9.3",
    "vitest": "^4.1.10",
    "vitest-browser-react": "^2.2.0"
  }
}
