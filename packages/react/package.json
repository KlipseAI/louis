{
  "name": "@klipse-design/react",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Klipse Design React 컴포넌트",
  "files": [
    "dist",
    "THIRD-PARTY-NOTICES.md"
  ],
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./icons": {
      "types": "./dist/icons/generated/index.d.ts",
      "import": "./dist/icons/generated/index.js"
    },
    "./package.json": "./package.json",
    "./icons/manifest.json": "./dist/icons/manifest.json"
  },
  "peerDependencies": {
    "@klipse-design/css": "workspace:^",
    "@types/react": "^19.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "peerDependenciesMeta": {
    "@types/react": {
      "optional": true
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node ../../scripts/copy-icon-manifest.mjs"
  },
  "dependencies": {
    "@radix-ui/react-dismissable-layer": "^1.1.19",
    "@radix-ui/react-focus-scope": "^1.1.16",
    "@radix-ui/react-popper": "^1.3.7",
    "@radix-ui/react-portal": "^1.1.17"
  }
}
